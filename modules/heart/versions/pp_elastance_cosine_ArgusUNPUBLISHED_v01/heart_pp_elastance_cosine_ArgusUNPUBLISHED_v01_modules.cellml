<?xml version='1.0' encoding='UTF-8'?>
<model name="heart_pp_elastance_cosine_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="heart_elastance_cosine">
        <!-- phase oscillator c = cos(theta), s = sin(theta) at frequency f; one ventricle u = E (q - q_0), E = E_min + (s_heart E_max - E_min)(1 - c)/2; inlet and outlet valves v = G dP sigma(k_valve dP), sigma(x) = (1 + tanh(x/2))/2 = 1/(1 + exp(-x)), the logistic function written without overflow. s_heart (heart strength, 1 at rest) comes through heart_strength_port. -->
        <variable name="t" public_interface="in" units="second"/>
        <variable name="f" public_interface="in" units="per_s"/>
        <variable name="E_min" public_interface="in" units="J_per_m6"/>
        <variable name="E_max" public_interface="in" units="J_per_m6"/>
        <variable name="s_heart" public_interface="in" units="dimensionless"/>
        <variable name="q_0" public_interface="in" units="m3"/>
        <variable name="q_init" public_interface="in" units="m3"/>
        <variable name="G_in" public_interface="in" units="m6_per_Js"/>
        <variable name="G_out" public_interface="in" units="m6_per_Js"/>
        <variable name="k_valve" public_interface="in" units="m3_per_J"/>
        <variable name="c_init" public_interface="in" units="dimensionless"/>
        <variable name="s_init" public_interface="in" units="dimensionless"/>
        <variable name="u_in" public_interface="in" units="J_per_m3"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable initial_value="c_init" name="c" public_interface="out" units="dimensionless"/>
        <variable initial_value="s_init" name="s" public_interface="out" units="dimensionless"/>
        <variable initial_value="q_init" name="q" public_interface="out" units="m3"/>
        <variable name="E" public_interface="out" units="J_per_m6"/>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="v_in" public_interface="out" units="m3_per_s"/>
        <variable name="v_out" public_interface="out" units="m3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>c</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                            <pi/>
                        </apply>
                        <ci>f</ci>
                    </apply>
                    <ci>s</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>s</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <pi/>
                        </apply>
                        <ci>f</ci>
                    </apply>
                    <ci>c</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E</ci>
                <apply>
                    <plus/>
                    <ci>E_min</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <apply>
                                    <times/>
                                    <ci>s_heart</ci>
                                    <ci>E_max</ci>
                                </apply>
                                <ci>E_min</ci>
                            </apply>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>c</ci>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <times/>
                    <ci>E</ci>
                    <apply>
                        <minus/>
                        <ci>q</ci>
                        <ci>q_0</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_in</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>G_in</ci>
                            <apply>
                                <minus/>
                                <ci>u_in</ci>
                                <ci>u</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <tanh/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>k_valve</ci>
                                        <apply>
                                            <minus/>
                                            <ci>u_in</ci>
                                            <ci>u</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_out</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>G_out</ci>
                            <apply>
                                <minus/>
                                <ci>u</ci>
                                <ci>u_out</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <tanh/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>k_valve</ci>
                                        <apply>
                                            <minus/>
                                            <ci>u</ci>
                                            <ci>u_out</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_in</ci>
                    <ci>v_out</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
