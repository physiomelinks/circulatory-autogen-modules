<?xml version='1.0' encoding='UTF-8'?>
<model name="chamber_vv" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="chamber_type">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="T" units="second" public_interface="in"/>
        <variable name="T_eff" units="second" public_interface="in"/>
        <variable name="mt" units="dimensionless" public_interface="in"/>
        <variable name="T_c" units="second" public_interface="in"/>
        <variable name="T_r" units="second" public_interface="in"/>
        <variable name="t_start" units="second" public_interface="in"/>
        <variable name="T_c_eff" units="second"/>
        <variable name="T_r_eff" units="second"/>
        <variable name="t_start_norm" units="dimensionless"/>
        <variable name="chi" units="dimensionless" public_interface="out" initial_value="0.0"/>
        <variable name="chi_floor" units="dimensionless" public_interface="out"/>
        <variable name="chi_floor_final" units="dimensionless"/>
        <variable name="e" units="dimensionless" public_interface="out"/>
        <variable name="eps_1" units="dimensionless" initial_value="0.07"/>
        <variable name="eps_2" units="dimensionless" initial_value="0.02"/>
        <variable name="E_A" units="J_per_m6" public_interface="in"/>
        <variable name="E_B" units="J_per_m6" public_interface="in"/>
        <variable name="Delta_E" units="J_per_m6" public_interface="in"/>
        <variable name="E_A_eff" units="J_per_m6" public_interface="out"/>
        <variable name="q_us" units="m3" public_interface="in"/>
        <variable name="q_init" units="m3" public_interface="in"/>
        <variable name="u_ext" units="J_per_m3" public_interface="in"/>
        <variable name="u" units="J_per_m3" public_interface="out"/>
        <variable name="q" units="m3" public_interface="out" initial_value="q_init"/>
        <variable name="v_in" units="m3_per_s" public_interface="in"/>
        <variable name="v_out" units="m3_per_s" public_interface="in"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>chi_floor</ci>
                <apply>
                    <minus/>
                    <ci>chi</ci>
                    <apply>
                        <floor/>
                        <ci>chi</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>chi</ci>
                </apply>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">0.25</cn>
                            <ci>T_c_eff</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>mt</ci>
                                <ci>t_start_norm</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>mt</ci>
                                <apply>
                                    <plus/>
                                    <ci>t_start_norm</ci>
                                    <ci>eps_1</ci>
                                </apply>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>chi_floor</ci>
                                <cn cellml:units="dimensionless">0.25</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">0.25</cn>
                            <ci>T_c_eff</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <gt/>
                                <apply>
                                    <plus/>
                                    <ci>t_start_norm</ci>
                                    <ci>eps_1</ci>
                                </apply>
                                <cn cellml:units="dimensionless">1.0</cn>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>mt</ci>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>t_start_norm</ci>
                                        <ci>eps_1</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">1.0</cn>
                                </apply>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>chi_floor</ci>
                                <cn cellml:units="dimensionless">0.25</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">0.25</cn>
                            <ci>T_c_eff</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <gt/>
                                <ci>chi_floor</ci>
                                <ci>eps_2</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>chi_floor</ci>
                                <cn cellml:units="dimensionless">0.25</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">0.25</cn>
                            <ci>T_r_eff</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>chi_floor</ci>
                                <cn cellml:units="dimensionless">0.25</cn>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>chi_floor</ci>
                                <cn cellml:units="dimensionless">0.5</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">0.5</cn>
                            <apply>
                                <minus/>
                                <apply>
                                    <minus/>
                                    <ci>T_eff</ci>
                                    <ci>T_c_eff</ci>
                                </apply>
                                <ci>T_r_eff</ci>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>chi_floor</ci>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="per_s">0.0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>chi_floor_final</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>chi_floor</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <apply>
                            <leq/>
                            <ci>chi_floor</ci>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="dimensionless">0.0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>e</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">0.5</cn>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <cos/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2</cn>
                                <pi/>
                                <ci>chi_floor_final</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>T_c_eff</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>T_c</ci>
                        <ci>T_eff</ci>
                    </apply>
                    <ci>T</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>T_r_eff</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>T_r</ci>
                        <ci>T_eff</ci>
                    </apply>
                    <ci>T</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>t_start_norm</ci>
                <apply>
                    <divide/>
                    <ci>t_start</ci>
                    <ci>T</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_A_eff</ci>
                <apply>
                    <plus/>
                    <ci>E_A</ci>
                    <ci>Delta_E</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>e</ci>
                                <ci>E_A_eff</ci>
                            </apply>
                            <ci>E_B</ci>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>q</ci>
                            <ci>q_us</ci>
                        </apply>
                    </apply>
                    <ci>u_ext</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_in</ci>
                    <ci>v_out</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
