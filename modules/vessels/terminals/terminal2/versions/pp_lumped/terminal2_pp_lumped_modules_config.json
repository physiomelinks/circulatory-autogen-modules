        "module_subtype": "vv_linear",
        "parameterisation": "default",
        "inp_instances": [
          "R_p"
        ],
        "out_instances": [
          "R_d",
          "V"
        ]
      },
      {
        "name": "R_d",
        "module_type": "resistance",
        "module_subtype": "pv_linear",
