        "parameterisation": "default",
        "inp_instances": [],
        "out_instances": [
          "R_p"
        ]
      },
      {
        "name": "R_p",
        "module_type": "resistance",
        "module_subtype": "vp_linear",
        "parameterisation": "default",
        "inp_instances": [
          "I_p"
        ],
        "out_instances": [
          "C"
        ]
      },
      {
        "name": "C",
