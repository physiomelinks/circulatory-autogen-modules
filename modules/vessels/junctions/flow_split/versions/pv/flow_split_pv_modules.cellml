<?xml version='1.0' encoding='UTF-8'?>
<model name="flow_split_pv" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="flow_split_type">
        <variable name="u_in" units="J_per_m3" public_interface="in"/>
        <variable name="v_out" units="m3_per_s" public_interface="in"/>
        <variable name="v" units="m3_per_s" public_interface="out"/>
        <variable name="u" units="J_per_m3" public_interface="out"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <ci>v_out</ci>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <ci>u_in</ci>
            </apply>
        </math>
    </component>
</model>
