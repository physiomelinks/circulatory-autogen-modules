{
  "module_type": "resistor",
  "version": "pp_conductance",
  "sim_time": 1.0,
  "pre_time": 0.0,
  "dt": 0.01,
  "solver": "CVODE_myokit",
  "outputs": [
    "G_wCont",
    "v"
  ],
  "invariants": [
    {
      "description": "v = G (1 + Delta_G)(u_in - u_out)/(1 + Delta_R)",
      "expr": "np.max(np.abs(v - G*(1 + Delta_G)*(u_in - u_out)/(1 + Delta_R))) <= 1e-12*abs(G*(u_in - u_out)/(1 + Delta_R)) + 1e-18"
    }
  ],
  "bc_sweep": {
    "factors": [
      0.25,
      0.5,
      1.0,
      2.0,
      4.0
    ],
    "ranges": {
      "Delta_R": {
        "min": -0.5,
        "max": 3.0,
        "points": 5
      },
      "Delta_G": {
        "min": -0.8,
        "max": 1.0,
        "points": 4
      },
      "u_in": {
        "min": 0.0,
        "max": 26664.0,
        "points": 5
      },
      "u_out": {
        "min": 0.0,
        "max": 2666.0,
        "points": 5
      }
    },
    "bounds": {
      "Delta_R": [
        -0.99,
        null
      ]
    },
    "rationale": "resistance from half to 4x (drug effects up to about 3); inlet 0-200 mmHg, outlet 0-20 mmHg (reverse flow included)."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [
      0.04,
      0.02,
      0.01,
      0.005
    ],
    "t_end": 1.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
        "atol": 1e-08
      }
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "pending",
        "reason": "no data: a synthetic module of the known-structure test model (ICUHealthy models/simple)"
      },
      "calibrate": {
        "note": "not_applicable: no data to calibrate against"
      }
    }
  }
}
