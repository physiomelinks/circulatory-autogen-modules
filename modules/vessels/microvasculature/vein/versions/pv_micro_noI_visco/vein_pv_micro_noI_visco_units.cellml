<?xml version='1.0' encoding='UTF-8'?>
<model name="Units" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <units name="J_per_m3">
        <unit units="joule"/>
        <unit exponent="-3" units="metre"/>
    </units>
    <units name="uL">
        <unit exponent="3" prefix="milli" units="metre"/>
    </units>
    <units name="uL_per_s">
        <unit units="uL"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="Pa_s_per_uL">
        <unit units="J_per_m3"/>
        <unit units="second"/>
        <unit exponent="-1" units="uL"/>
    </units>
    <units name="uL_per_Pa">
        <unit units="uL"/>
        <unit exponent="-1" units="J_per_m3"/>
    </units>
    <units name="Pa_s2_per_uL">
        <unit units="J_per_m3"/>
        <unit exponent="2" units="second"/>
        <unit exponent="-1" units="uL"/>
    </units>
</model>
