<?xml version='1.0' encoding='UTF-8'?>
<model name="arteriole_vp_micro_noI_visco" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="vp_simple_noI_visco_type__arteriole_vp_micro_noI_visco">
        <variable name="t" public_interface="in" units="second"/>
        <!-- Constitutive parameters-->
        <variable name="C" public_interface="in" units="uL_per_Pa"/>
        <variable name="R" public_interface="in" units="Pa_s_per_uL"/>
        <variable name="R_v" public_interface="out" units="Pa_s_per_uL"/>
        <!-- State Variables-->
        <variable name="q_0" public_interface="in" units="uL"/>
        <variable name="u_0" public_interface="in" units="J_per_m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="v_in" public_interface="in" units="uL_per_s"/>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable initial_value="0.0" name="q_C" public_interface="out" units="uL"/>
        <variable name="u_C" public_interface="out" units="J_per_m3"/>
        <variable name="v" public_interface="out" units="uL_per_s"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="q" public_interface="out" units="uL"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q</ci>
                <apply>
                    <plus/>
                    <ci>q_C</ci>
                    <ci>q_0</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_v</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="second">0.01</cn>
                    <ci>C</ci>
                </apply>
            </apply>
            <!-- Conservation Laws-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_C</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_in</ci>
                    <ci>v</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_C</ci>
                <apply>
                    <divide/>
                    <ci>q_C</ci>
                    <ci>C</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <plus/>
                    <ci>u_0</ci>
                    <ci>u_C</ci>
                    <ci>u_ext</ci>
                    <apply>
                        <times/>
                        <ci>R_v</ci>
                        <apply>
                            <minus/>
                            <ci>v_in</ci>
                            <ci>v</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!-- No inertance: the flows are the I -> 0 limit of the original, solved explicitly-->
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <apply>
                                <plus/>
                                <apply>
                                    <plus/>
                                    <ci>u_0</ci>
                                    <ci>u_C</ci>
                                </apply>
                                <ci>u_ext</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R_v</ci>
                                <ci>v_in</ci>
                            </apply>
                        </apply>
                        <ci>u_out</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>R</ci>
                        <ci>R_v</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
