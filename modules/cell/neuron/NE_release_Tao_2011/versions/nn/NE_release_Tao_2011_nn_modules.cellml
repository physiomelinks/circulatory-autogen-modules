<?xml version='1.0' encoding='UTF-8'?>
<model name="NE_release_Tao_2011_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="NE_release_Tao_2011">
        <variable name="t" public_interface="in" units="second"/>
        <!-- Vesicle states: fractions of the n releasable vesicles with 0..5 Ca2+ bound (they sum to 1).-->
        <variable initial_value="1.0" name="V_Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="V_1Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="V_2Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="V_3Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="V_4Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="V_5Ca" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.0" name="NE" public_interface="out" units="millimolar"/>
        <variable name="K_off" public_interface="in" units="per_s"/>
        <variable name="K_on" public_interface="in" units="per_millimolar_s"/>
        <variable name="K_Ca" public_interface="in" units="per_s"/>
        <variable name="b" public_interface="in" units="dimensionless"/>
        <variable name="E" public_interface="out" units="per_s"/>
        <variable initial_value="0.0" name="Cai" public_interface="out" units="millimolar"/>
        <variable name="gamma" public_interface="in" units="per_s"/>
        <variable name="i_Ca" public_interface="in" units="nanoA"/>
        <variable name="C_m" public_interface="in" units="picoF"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="V_Z" public_interface="in" units="litre"/>
        <variable name="a" public_interface="in" units="dimensionless"/>
        <variable name="n" public_interface="in" units="dimensionless"/>
        <variable name="V_cleft" public_interface="in" units="litre"/>
        <variable name="P_up" public_interface="in" units="per_s"/>
        <!-- Active-zone Ca2+ (Tao 2011 Eq. 2, Ca_Z): input by the Ca current into the active-zone volume V_Z,
 cleared to the bulk cytoplasm at the rate K_Ca. i_Ca is an absolute current (nA), so Tao's factor Cm
 (his i_Ca is per unit capacitance) drops out; 1e-9 A/nA and 1e3 mmol/mol convert to mM/s.-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Cai</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <ci>i_Ca</ci>
                            </apply>
                            <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                            <cn cellml:units="millimol_per_mol">1000</cn>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>F</ci>
                            <ci>V_Z</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Cai</ci>
                        <ci>K_Ca</ci>
                    </apply>
                </apply>
            </apply>
            <!-- Kinetics equations: Tao 2011 Document S1 Eqs. 108-113 (Schneggenburger and Neher 2000 five-site
 scheme). The unbinding rate from k bound ions is k K_off b^(k-1).-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>K_off</ci>
                        <ci>V_1Ca</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">5</cn>
                        <ci>K_on</ci>
                        <ci>Cai</ci>
                        <ci>V_Ca</ci>
                    </apply>
                </apply>
            </apply>
            <!-- Eq. 109: the loss term is (K_off b^0 + 4 K_on Ca) V_1Ca, b^0 = 1 (was K_off b, which did not
 conserve the vesicle number: Eq. 108 gains K_off V_1Ca).-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_1Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">5</cn>
                            <ci>K_on</ci>
                            <ci>Cai</ci>
                            <ci>V_Ca</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>K_off</ci>
                            <ci>V_2Ca</ci>
                            <ci>b</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_off</ci>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">4</cn>
                                <ci>K_on</ci>
                                <ci>Cai</ci>
                            </apply>
                        </apply>
                        <ci>V_1Ca</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_2Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">4</cn>
                            <ci>K_on</ci>
                            <ci>Cai</ci>
                            <ci>V_1Ca</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">3</cn>
                            <ci>K_off</ci>
                            <ci>V_3Ca</ci>
                            <apply>
                                <power/>
                                <ci>b</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2</cn>
                                <ci>K_off</ci>
                                <ci>b</ci>
                            </apply>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">3</cn>
                                <ci>K_on</ci>
                                <ci>Cai</ci>
                            </apply>
                        </apply>
                        <ci>V_2Ca</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_3Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">3</cn>
                            <ci>K_on</ci>
                            <ci>Cai</ci>
                            <ci>V_2Ca</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">4</cn>
                            <ci>K_off</ci>
                            <ci>V_4Ca</ci>
                            <apply>
                                <power/>
                                <ci>b</ci>
                                <cn cellml:units="dimensionless">3</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">3</cn>
                                <ci>K_off</ci>
                                <apply>
                                    <power/>
                                    <ci>b</ci>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2</cn>
                                <ci>K_on</ci>
                                <ci>Cai</ci>
                            </apply>
                        </apply>
                        <ci>V_3Ca</ci>
                    </apply>
                </apply>
            </apply>
            <!-- Eq. 112 prints 5 K_off V_2Ca b^4 for the gain term; V_5Ca is used, which matches the loss term of
 Eq. 113 and conserves the vesicle number (owner's 2023 comment: "I think the above V_2Ca should be
 V_5Ca... error in supp material of Tao 2011?").-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_4Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>K_on</ci>
                            <ci>Cai</ci>
                            <ci>V_3Ca</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">5</cn>
                            <ci>K_off</ci>
                            <ci>V_5Ca</ci>
                            <apply>
                                <power/>
                                <ci>b</ci>
                                <cn cellml:units="dimensionless">4</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">4</cn>
                                <ci>K_off</ci>
                                <apply>
                                    <power/>
                                    <ci>b</ci>
                                    <cn cellml:units="dimensionless">3</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>K_on</ci>
                                <ci>Cai</ci>
                            </apply>
                        </apply>
                        <ci>V_4Ca</ci>
                    </apply>
                </apply>
            </apply>
            <!-- Eq. 113: as printed, fusion (E = gamma V_5Ca) does not deplete V_5Ca.-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_5Ca</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>K_on</ci>
                        <ci>Cai</ci>
                        <ci>V_4Ca</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">5</cn>
                        <ci>K_off</ci>
                        <apply>
                            <power/>
                            <ci>b</ci>
                            <cn cellml:units="dimensionless">4</cn>
                        </apply>
                        <ci>V_5Ca</ci>
                    </apply>
                </apply>
            </apply>
            <!-- Fusion rate of the releasable vesicles (Eq. 114).-->
            <apply>
                <eq/>
                <ci>E</ci>
                <apply>
                    <times/>
                    <ci>gamma</ci>
                    <ci>V_5Ca</ci>
                </apply>
            </apply>
            <!-- NE in the cleft (Tao 2011 Eq. 3): E n a molecules/s into V_cleft, divided by Avogadro's number
 (and 1e3 mmol/mol) for mM, cleared by NET at the rate P_up.-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>NE</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>E</ci>
                            <ci>n</ci>
                            <ci>a</ci>
                            <cn cellml:units="millimol_per_mol">1000</cn>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="per_mol" type="e-notation">6.02214076<sep/>23</cn>
                            <ci>V_cleft</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>NE</ci>
                        <ci>P_up</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
