<?xml version='1.0' encoding='UTF-8'?>
<model name="SN_Ca_handling_varicosity_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="SN_Ca_handling_varicosity">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="B_Ca_ER_pre" public_interface="out" units="millimolar" initial_value="B_Ca_init"/>
        <variable name="B_Ca_bulk" public_interface="out" units="millimolar" initial_value="B_Ca_init"/>
        <variable name="B_Ca_init" public_interface="in" units="millimolar"/>
        <variable name="B_Ca_total" public_interface="in" units="millimolar"/>
        <variable name="B_Cai" public_interface="out" units="millimolar" initial_value="B_Ca_init"/>
        <variable name="CaB_Ca_ER_pre" public_interface="out" units="millimolar"/>
        <variable name="CaB_Ca_bulk" public_interface="out" units="millimolar"/>
        <variable name="CaB_Cai" public_interface="out" units="millimolar"/>
        <variable name="Ca_ER" public_interface="out" units="millimolar" initial_value="Ca_ER_init"/>
        <variable name="Ca_ER_init" public_interface="in" units="millimolar"/>
        <variable name="Ca_ER_pre" public_interface="out" units="millimolar" initial_value="Ca_ER_init"/>
        <variable name="Ca_bulk" public_interface="out" units="millimolar" initial_value="Cai_init"/>
        <variable name="Cai" public_interface="out" units="millimolar" initial_value="Cai_init"/>
        <variable name="Cai_init" public_interface="in" units="millimolar"/>
        <variable name="Cao" public_interface="in" units="millimolar"/>
        <variable name="D_Ca" public_interface="in" units="m3_per_s"/>
        <variable name="D_Ca_ER" public_interface="in" units="m3_per_s"/>
        <variable name="E_Ca" public_interface="out" units="milliV"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="H_SERCA" public_interface="in" units="dimensionless"/>
        <variable name="K_mf" public_interface="in" units="millimolar"/>
        <variable name="K_mr" public_interface="in" units="millimolar"/>
        <variable name="R" public_interface="in" units="J_per_mol_K"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="Vol" public_interface="in" units="m3"/>
        <variable name="c_ER" public_interface="in" units="dimensionless"/>
        <variable name="c_ER_pre" public_interface="in" units="dimensionless"/>
        <variable name="c_SL" public_interface="in" units="dimensionless"/>
        <variable name="c_bulk" public_interface="out" units="dimensionless"/>
        <variable name="j_Ca_in" public_interface="in" units="mol_per_s"/>
        <variable name="j_ER_release" public_interface="in" units="mol_per_s"/>
        <variable name="j_SERCA" public_interface="out" units="mol_per_s"/>
        <variable name="j_diffCa" public_interface="out" units="mol_per_s"/>
        <variable name="j_diffCa_ER" public_interface="out" units="mol_per_s"/>
        <variable name="j_leak_Ca" public_interface="out" units="mol_per_s"/>
        <variable name="k_SERCA" public_interface="out" units="mol_per_s"/>
        <variable name="k_bind_Ca" public_interface="in" units="per_millimolar_s"/>
        <variable name="k_bind_Ca_ER" public_interface="in" units="per_millimolar_s"/>
        <variable name="k_leak_Ca" public_interface="out" units="m3_per_s"/>
        <variable name="rho_SERCA" public_interface="in" units="per_um2"/>
        <variable name="r_SERCA" public_interface="in" units="per_s"/>
        <variable name="rho_leak_Ca" public_interface="in" units="per_um2"/>
        <variable name="k_leak_Ca_single" public_interface="in" units="um3_per_s"/>
        <variable name="k_A_ER" public_interface="in" units="dimensionless"/>
        <variable name="k_V_ER" public_interface="in" units="dimensionless"/>
        <variable name="k_A_ER_pre" public_interface="in" units="dimensionless"/>
        <variable name="k_V_ER_pre" public_interface="in" units="dimensionless"/>
        <variable name="A_ER" public_interface="out" units="um2"/>
        <variable name="A_ER_pre" public_interface="out" units="um2"/>
        <variable name="k_unbind_Ca" public_interface="in" units="per_s"/>
        <variable name="k_unbind_Ca_ER" public_interface="in" units="per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>c_bulk</ci>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>c_SL</ci>
                        </apply>
                        <ci>c_ER</ci>
                    </apply>
                    <ci>c_ER_pre</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Ca</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Cao</ci>
                            <ci>Cai</ci>
                        </apply>
                    </apply>
                    <cn cellml:units="milliV_per_V">1000</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_leak_Ca</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>k_leak_Ca</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Ca_bulk</ci>
                        <ci>Ca_ER_pre</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_SERCA</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>k_SERCA</ci>
                        </apply>
                        <apply>
                            <minus/>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>Ca_bulk</ci>
                                    <ci>K_mf</ci>
                                </apply>
                                <ci>H_SERCA</ci>
                            </apply>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>Ca_ER_pre</ci>
                                    <ci>K_mr</ci>
                                </apply>
                                <ci>H_SERCA</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>Ca_bulk</ci>
                                <ci>K_mf</ci>
                            </apply>
                            <ci>H_SERCA</ci>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>Ca_ER_pre</ci>
                                <ci>K_mr</ci>
                            </apply>
                            <ci>H_SERCA</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>B_Cai</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>k_unbind_Ca</ci>
                        <ci>CaB_Cai</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca</ci>
                        <ci>Cai</ci>
                        <ci>B_Cai</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>CaB_Cai</ci>
                <apply>
                    <minus/>
                    <ci>B_Ca_total</ci>
                    <ci>B_Cai</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>B_Ca_bulk</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>k_unbind_Ca</ci>
                        <ci>CaB_Ca_bulk</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca</ci>
                        <ci>Ca_bulk</ci>
                        <ci>B_Ca_bulk</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>CaB_Ca_bulk</ci>
                <apply>
                    <minus/>
                    <ci>B_Ca_total</ci>
                    <ci>B_Ca_bulk</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>B_Ca_ER_pre</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>k_unbind_Ca_ER</ci>
                        <ci>CaB_Ca_ER_pre</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca_ER</ci>
                        <ci>Ca_ER_pre</ci>
                        <ci>B_Ca_ER_pre</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>CaB_Ca_ER_pre</ci>
                <apply>
                    <minus/>
                    <ci>B_Ca_total</ci>
                    <ci>B_Ca_ER_pre</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_diffCa</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>D_Ca</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Cai</ci>
                        <ci>Ca_bulk</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_diffCa_ER</ci>
                <apply>
                    <times/>
                    <ci>D_Ca_ER</ci>
                    <apply>
                        <minus/>
                        <ci>Ca_ER_pre</ci>
                        <ci>Ca_ER</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Cai</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <times/>
                                    <ci>Vol</ci>
                                    <ci>c_SL</ci>
                                </apply>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>j_Ca_in</ci>
                                <ci>j_leak_Ca</ci>
                                <ci>j_diffCa</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_unbind_Ca</ci>
                            <ci>CaB_Cai</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca</ci>
                        <ci>Cai</ci>
                        <ci>B_Cai</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_bulk</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <times/>
                                    <ci>Vol</ci>
                                    <ci>c_bulk</ci>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <ci>j_SERCA</ci>
                                <ci>j_diffCa</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_unbind_Ca</ci>
                            <ci>CaB_Ca_bulk</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca</ci>
                        <ci>Ca_bulk</ci>
                        <ci>B_Ca_bulk</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_ER_pre</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <times/>
                                    <ci>Vol</ci>
                                    <ci>c_ER_pre</ci>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <ci>j_SERCA</ci>
                                    </apply>
                                    <ci>j_leak_Ca</ci>
                                </apply>
                                <ci>j_diffCa_ER</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_unbind_Ca_ER</ci>
                            <ci>CaB_Ca_ER_pre</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_bind_Ca_ER</ci>
                        <ci>Ca_ER_pre</ci>
                        <ci>B_Ca_ER_pre</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_ER</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <times/>
                            <ci>Vol</ci>
                            <ci>c_ER</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>j_ER_release</ci>
                        </apply>
                        <ci>j_diffCa_ER</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>A_ER</ci><apply><times/><ci>k_A_ER</ci><apply><power/><apply><root/><degree><cn cellml:units="dimensionless">3.0</cn></degree><apply><divide/><apply><times/><ci>c_ER</ci><ci>Vol</ci><cn cellml:units="um3_per_m3" type="e-notation">1<sep/>18</cn></apply><ci>k_V_ER</ci></apply></apply><cn cellml:units="dimensionless">2.0</cn></apply></apply></apply>
            <apply><eq/><ci>A_ER_pre</ci><apply><times/><ci>k_A_ER_pre</ci><apply><power/><apply><root/><degree><cn cellml:units="dimensionless">3.0</cn></degree><apply><divide/><apply><times/><ci>c_ER_pre</ci><ci>Vol</ci><cn cellml:units="um3_per_m3" type="e-notation">1<sep/>18</cn></apply><ci>k_V_ER_pre</ci></apply></apply><cn cellml:units="dimensionless">2.0</cn></apply></apply></apply>
            <apply><eq/><ci>k_SERCA</ci><apply><divide/><apply><times/><ci>A_ER_pre</ci><ci>rho_SERCA</ci><ci>r_SERCA</ci></apply><cn cellml:units="per_mol" type="e-notation">6.02214076<sep/>23</cn></apply></apply>
            <apply><eq/><ci>k_leak_Ca</ci><apply><times/><ci>A_ER_pre</ci><ci>rho_leak_Ca</ci><ci>k_leak_Ca_single</ci><cn cellml:units="m3_per_um3" type="e-notation">1<sep/>-18</cn></apply></apply>
        </math>
    </component>
</model>
