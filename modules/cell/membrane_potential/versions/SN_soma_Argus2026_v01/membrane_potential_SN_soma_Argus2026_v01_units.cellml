<?xml version='1.0' encoding='UTF-8'?>
<model name="Units" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <units name="milliV">
        <unit prefix="milli" units="volt"/>
    </units>
    <units name="milliV_per_kiloV">
        <unit prefix="milli" units="volt"/>
        <unit exponent="-1" prefix="kilo" units="volt"/>
    </units>
    <units name="picoF">
        <unit prefix="pico" units="farad"/>
    </units>
    <units name="megaOhm">
        <unit prefix="mega" units="ohm"/>
    </units>
    <units name="nanoA">
        <unit prefix="nano" units="ampere"/>
    </units>
    <units name="um">
        <unit prefix="micro" units="metre"/>
    </units>
    <units name="um2">
        <unit exponent="2" prefix="micro" units="metre"/>
    </units>
    <units name="um3">
        <unit exponent="3" prefix="micro" units="metre"/>
    </units>
    <units name="m3">
        <unit exponent="3" units="metre"/>
    </units>
    <units name="m3_per_um3">
        <unit exponent="3" units="metre"/>
        <unit exponent="-3" prefix="micro" units="metre"/>
    </units>
    <units name="uF_per_cm2">
        <unit prefix="micro" units="farad"/>
        <unit exponent="-2" prefix="centi" units="metre"/>
    </units>
    <units name="picoF_cm2_per_uF_um2">
        <unit prefix="pico" units="farad"/>
        <unit exponent="2" prefix="centi" units="metre"/>
        <unit exponent="-1" prefix="micro" units="farad"/>
        <unit exponent="-2" prefix="micro" units="metre"/>
    </units>
</model>
