<?xml version='1.0' encoding='UTF-8'?>
<model name="membrane_potential_SN_soma_Argus2026_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="SN_membrane_soma">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="C_sensed" public_interface="in" units="picoF"/>
        <variable name="Cm" public_interface="out" units="picoF"/>
        <variable name="c_m" public_interface="in" units="uF_per_cm2"/>
        <variable name="d" public_interface="in" units="um"/>
        <variable name="k_A" public_interface="in" units="dimensionless"/>
        <variable name="k_V" public_interface="in" units="dimensionless"/>
        <variable name="A_mem" public_interface="out" units="um2"/>
        <variable name="Vol" public_interface="out" units="m3"/>
        <variable name="I_in" public_interface="in" units="nanoA"/>
        <variable name="I_in_delayed" public_interface="out" units="nanoA"/>
        <variable name="I_out" public_interface="in" units="nanoA"/>
        <variable name="R_diffSensed" public_interface="in" units="megaOhm"/>
        <variable name="V" public_interface="out" units="milliV" initial_value="V_rest_approx"/>
        <variable name="V_rest_approx" public_interface="in" units="milliV"/>
        <variable name="V_sensed" public_interface="out" units="milliV" initial_value="V_rest_approx"/>
        <variable name="i_ion" public_interface="in" units="nanoA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="milliV_per_kiloV" type="e-notation">1<sep/>6</cn><apply><minus/><ci>I_in_delayed</ci><apply><plus/><ci>i_ion</ci><ci>I_out</ci></apply></apply>
                    </apply>
                    <ci>Cm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_sensed</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="milliV_per_kiloV" type="e-notation">1<sep/>6</cn>
                        <apply>
                            <minus/>
                            <ci>I_in</ci>
                            <ci>I_in_delayed</ci>
                        </apply>
                    </apply>
                    <ci>C_sensed</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_in_delayed</ci>
                <apply>
                    <divide/>
                    <apply>
                            <minus/>
                            <ci>V_sensed</ci>
                            <ci>V</ci>
                        </apply>
                    <ci>R_diffSensed</ci>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>A_mem</ci><apply><times/><ci>k_A</ci><apply><power/><ci>d</ci><cn cellml:units="dimensionless">2.0</cn></apply></apply></apply>
            <apply><eq/><ci>Vol</ci><apply><times/><ci>k_V</ci><apply><power/><ci>d</ci><cn cellml:units="dimensionless">3.0</cn></apply><cn cellml:units="m3_per_um3" type="e-notation">1<sep/>-18</cn></apply></apply>
            <apply><eq/><ci>Cm</ci><apply><times/><ci>c_m</ci><ci>A_mem</ci><cn cellml:units="picoF_cm2_per_uF_um2">0.01</cn></apply></apply>
        </math>
    </component>
</model>
