<?xml version='1.0' encoding='UTF-8'?>
<model name="biosynthesis_adaptive_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="biosynthesis_fermenter">
        <variable name="t" public_interface="in" units="second"/>
        <!-- cytosol ATP (ATP_hydrolysis_port) -->
        <variable name="ATP" public_interface="in" units="millimolar"/>
        <variable name="ADP" public_interface="in" units="millimolar"/>
        <variable name="Pi" public_interface="in" units="millimolar"/>
        <!-- in-plane membrane area (membrane_area port) -->
        <variable name="A_mem" public_interface="in" units="um2"/>
        <!-- whole cell surface / in-plane membrane area -->
        <variable name="surface_factor" public_interface="in" units="dimensionless"/>
        <!-- mRNA molecules per cell -->
        <variable name="n_mRNA" public_interface="in" units="dimensionless"/>
        <!-- nt -->
        <variable name="L_mRNA" public_interface="in" units="dimensionless"/>
        <!-- mRNA half-life -->
        <variable name="t_half_mRNA" public_interface="in" units="second"/>
        <!-- ribosomes per cell -->
        <variable name="n_ribo" public_interface="in" units="dimensionless"/>
        <!-- nt per ribosome -->
        <variable name="L_rRNA" public_interface="in" units="dimensionless"/>
        <!-- rRNA turnover -->
        <variable name="k_ribo" public_interface="in" units="per_s"/>
        <!-- ~P to remake a nucleotide from its NMP -->
        <variable name="c_nt_recycle" public_interface="in" units="dimensionless"/>
        <!-- ~P to make a nucleotide from glucose -->
        <variable name="c_nt_denovo" public_interface="in" units="dimensionless"/>
        <variable name="area_per_lipid" public_interface="in" units="um2"/>
        <!-- ~P per phospholipid made -->
        <variable name="c_lipid" public_interface="in" units="dimensionless"/>
        <!-- lipid turnover -->
        <variable name="k_lipid" public_interface="in" units="per_s"/>
        <!-- nucleotides in one genome (both strands) -->
        <variable name="genome_nt" public_interface="in" units="dimensionless"/>
        <variable name="N_A" public_interface="in" units="per_mol"/>
        <variable name="K_m_ATP_bio" public_interface="in" units="millimolar"/>
        <variable name="ATP_ref" public_interface="in" units="millimolar"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="T_ref_dmg" public_interface="in" units="kelvin"/>
        <variable name="dT_Q10" public_interface="in" units="kelvin"/>
        <variable name="Q10_dmg" public_interface="in" units="dimensionless"/>
        <!-- damage accrual: fraction of a lethal load per second -->
        <variable name="r_dmg" public_interface="in" units="per_s"/>
        <!-- repair capacity at full repair level -->
        <variable name="r_rep_max" public_interface="in" units="per_s"/>
        <!-- damage at half repair rate -->
        <variable name="K_D" public_interface="in" units="dimensionless"/>
        <!-- ATP to repair one whole lethal load of damage -->
        <variable name="C_repair" public_interface="in" units="mole"/>
        <!-- how much the cell invests in repair, 0-1 (set by the game) -->
        <variable name="repair_level" public_interface="in" units="dimensionless"/>
        <!-- ATP the cell puts into a daughter, in multiples of J_ref (set by the game) -->
        <variable name="growth_level" public_interface="in" units="dimensionless"/>
        <!-- resting ATP turnover of the cell: growth is asked in multiples of it -->
        <variable name="J_ref" public_interface="in" units="mol_per_s"/>
        <!-- ATP at which growth stops (as protein synthesis) -->
        <variable name="ATP_floor" public_interface="in" units="millimolar"/>
        <!-- (ATP - ATP_floor)/(ATP_ref - ATP_floor) -->
        <variable name="x_ATP" public_interface="out" units="dimensionless"/>
        <!-- x_ATP clamped to 0-1: growth backs off as ATP falls (stringent response) -->
        <variable name="throttle" public_interface="out" units="dimensionless"/>
        <!-- the pools' build costs, summed on the daughter_share port -->
        <variable name="M_build_in" public_interface="in" units="mole"/>
        <!-- ATP to build the cell's proteins -->
        <variable name="M_build_protein" public_interface="out" units="mole"/>
        <!-- ATP the glycogen store would give (glycogen_store port) -->
        <variable name="M_glyc_ATP" public_interface="in" units="mole"/>
        <!-- ATP asked for the daughter: growth_level J_ref throttle -->
        <variable name="J_growth" public_interface="out" units="mol_per_s"/>
        <!-- ATP to build a daughter: proteins, RNA, lipids and DNA -->
        <variable name="M_daughter" public_interface="out" units="mole"/>
        <!-- share of a daughter built -->
        <variable name="growth_progress" public_interface="out" units="dimensionless"/>
        <!-- share of a daughter the glycogen store could finish -->
        <variable name="glycogen_progress" public_interface="out" units="dimensionless"/>
        <variable name="D_init" public_interface="in" units="dimensionless"/>
        <variable name="P_init" public_interface="in" units="mole"/>
        <!-- damage (1 = lethal) -->
        <variable initial_value="D_init" name="D" public_interface="out" units="dimensionless"/>
        <!-- ATP invested in the daughter so far -->
        <variable initial_value="P_init" name="P_growth" public_interface="out" units="mole"/>
        <!-- phospholipids in the membrane (both leaflets of the whole surface) -->
        <variable name="n_lipid" public_interface="out" units="dimensionless"/>
        <!-- synthesis slows as ATP runs out: 1 at ATP_ref -->
        <variable name="f_ATP_bio" public_interface="out" units="dimensionless"/>
        <variable name="f_T_dmg" public_interface="out" units="dimensionless"/>
        <!-- mRNA turnover -->
        <variable name="J_RNA" public_interface="out" units="mol_per_s"/>
        <!-- ribosome (rRNA) upkeep -->
        <variable name="J_ribo" public_interface="out" units="mol_per_s"/>
        <!-- membrane lipid turnover, scales with membrane area -->
        <variable name="J_lipid" public_interface="out" units="mol_per_s"/>
        <!-- damage repaired per second -->
        <variable name="R_repair" public_interface="out" units="per_s"/>
        <!-- ATP spent on repair -->
        <variable name="J_repair" public_interface="out" units="mol_per_s"/>
        <!-- ATP actually put into the daughter -->
        <variable name="J_growth_used" public_interface="out" units="mol_per_s"/>
        <!-- all ATP used here -->
        <variable name="J_ATP_bio" public_interface="out" units="mol_per_s"/>
        <!-- ATP to build a daughter's RNA, lipids and DNA (proteins: protein_expression) -->
        <variable name="M_build_bio" public_interface="out" units="mole"/>
        <variable name="j_ATP_bio" public_interface="out" units="mol_per_s"/>
        <variable name="j_ADP_bio" public_interface="out" units="mol_per_s"/>
        <variable name="j_Pi_bio" public_interface="out" units="mol_per_s"/>
        <!-- regulation by ATP, 0-1, 1 at and above rest (growth_regulation port) -->
        <variable name="f_ATP_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by G6P, 0-1, 1 at and above rest (growth_regulation port) -->
        <variable name="f_G6P_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by glucose inside, 0-1, 1 at and above rest (growth_regulation port) -->
        <variable name="f_glc_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by H+ (falling pH), 0-1, 1 at and above rest (growth_regulation port) -->
        <variable name="f_H_reg" public_interface="in" units="dimensionless"/>
        <!-- 1: falling ATP lowers growth (set by the game); 0: it does not -->
        <variable name="reg_on_ATP" public_interface="in" units="dimensionless"/>
        <!-- 1: falling G6P lowers growth (set by the game); 0: it does not -->
        <variable name="reg_on_G6P" public_interface="in" units="dimensionless"/>
        <!-- 1: falling glucose inside lowers growth (set by the game); 0: it does not -->
        <variable name="reg_on_glc" public_interface="in" units="dimensionless"/>
        <!-- 1: falling H+ (falling pH) lowers growth (set by the game); 0: it does not -->
        <variable name="reg_on_H" public_interface="in" units="dimensionless"/>
        <!-- regulation factor on growth: prod (1 - reg_on + reg_on f) -->
        <variable name="R_reg" public_interface="out" units="dimensionless"/>
        <!-- 1: falling ATP lowers RNA and lipid upkeep (mRNA and rRNA turnover, lipid turnover) (set by the game); 0: it does not -->
        <variable name="reg_on_ATP_upkeep" public_interface="in" units="dimensionless"/>
        <!-- 1: falling G6P lowers RNA and lipid upkeep (mRNA and rRNA turnover, lipid turnover) (set by the game); 0: it does not -->
        <variable name="reg_on_G6P_upkeep" public_interface="in" units="dimensionless"/>
        <!-- 1: falling glucose inside lowers RNA and lipid upkeep (mRNA and rRNA turnover, lipid turnover) (set by the game); 0: it does not -->
        <variable name="reg_on_glc_upkeep" public_interface="in" units="dimensionless"/>
        <!-- 1: falling H+ (falling pH) lowers RNA and lipid upkeep (mRNA and rRNA turnover, lipid turnover) (set by the game); 0: it does not -->
        <variable name="reg_on_H_upkeep" public_interface="in" units="dimensionless"/>
        <!-- regulation factor on RNA and lipid upkeep (mRNA and rRNA turnover, lipid turnover): prod (1 - reg_on + reg_on f) -->
        <variable name="R_reg_upkeep" public_interface="out" units="dimensionless"/>
        <!-- 1: falling ATP lowers repair (set by the game); 0: it does not -->
        <variable name="reg_on_ATP_repair" public_interface="in" units="dimensionless"/>
        <!-- 1: falling G6P lowers repair (set by the game); 0: it does not -->
        <variable name="reg_on_G6P_repair" public_interface="in" units="dimensionless"/>
        <!-- 1: falling glucose inside lowers repair (set by the game); 0: it does not -->
        <variable name="reg_on_glc_repair" public_interface="in" units="dimensionless"/>
        <!-- 1: falling H+ (falling pH) lowers repair (set by the game); 0: it does not -->
        <variable name="reg_on_H_repair" public_interface="in" units="dimensionless"/>
        <!-- regulation factor on repair: prod (1 - reg_on + reg_on f) -->
        <variable name="R_reg_repair" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_reg_upkeep</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_ATP_upkeep</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_ATP_upkeep</ci>
                            <ci>f_ATP_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_G6P_upkeep</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_G6P_upkeep</ci>
                            <ci>f_G6P_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_glc_upkeep</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_glc_upkeep</ci>
                            <ci>f_glc_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_H_upkeep</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_H_upkeep</ci>
                            <ci>f_H_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_reg_repair</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_ATP_repair</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_ATP_repair</ci>
                            <ci>f_ATP_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_G6P_repair</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_G6P_repair</ci>
                            <ci>f_G6P_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_glc_repair</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_glc_repair</ci>
                            <ci>f_glc_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_H_repair</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_H_repair</ci>
                            <ci>f_H_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>n_lipid</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <ci>A_mem</ci>
                        <ci>surface_factor</ci>
                    </apply>
                    <ci>area_per_lipid</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_ATP_bio</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>ATP</ci>
                            <apply>
                                <plus/>
                                <ci>K_m_ATP_bio</ci>
                                <ci>ATP</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>K_m_ATP_bio</ci>
                            <ci>ATP_ref</ci>
                        </apply>
                    </apply>
                    <ci>ATP_ref</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_T_dmg</ci>
                <apply>
                    <power/>
                    <ci>Q10_dmg</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>T</ci>
                            <ci>T_ref_dmg</ci>
                        </apply>
                        <ci>dT_Q10</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_RNA</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>n_mRNA</ci>
                                <ci>L_mRNA</ci>
                                <ci>c_nt_recycle</ci>
                                <apply>
                                    <ln/>
                                    <cn cellml:units="dimensionless">2.0</cn>
                                </apply>
                            </apply>
                            <ci>t_half_mRNA</ci>
                        </apply>
                        <ci>N_A</ci>
                    </apply>
                    <ci>f_ATP_bio</ci>
                    <ci>R_reg_upkeep</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_ribo</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>n_ribo</ci>
                            <ci>L_rRNA</ci>
                            <ci>c_nt_recycle</ci>
                            <ci>k_ribo</ci>
                        </apply>
                        <ci>N_A</ci>
                    </apply>
                    <ci>f_ATP_bio</ci>
                    <ci>R_reg_upkeep</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_lipid</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>n_lipid</ci>
                            <ci>c_lipid</ci>
                            <ci>k_lipid</ci>
                        </apply>
                        <ci>N_A</ci>
                    </apply>
                    <ci>f_ATP_bio</ci>
                    <ci>R_reg_upkeep</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_repair</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>repair_level</ci>
                            <ci>r_rep_max</ci>
                            <ci>D</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>K_D</ci>
                            <ci>D</ci>
                        </apply>
                    </apply>
                    <ci>f_ATP_bio</ci>
                    <ci>R_reg_repair</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_repair</ci>
                <apply>
                    <times/>
                    <ci>R_repair</ci>
                    <ci>C_repair</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>x_ATP</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>ATP</ci>
                        <ci>ATP_floor</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>ATP_ref</ci>
                        <ci>ATP_floor</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>throttle</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>x_ATP</ci>
                                    <apply>
                                        <abs/>
                                        <ci>x_ATP</ci>
                                    </apply>
                                </apply>
                                <cn cellml:units="dimensionless">2.0</cn>
                            </apply>
                            <cn cellml:units="dimensionless">1.0</cn>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>x_ATP</ci>
                                        <apply>
                                            <abs/>
                                            <ci>x_ATP</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">2.0</cn>
                                </apply>
                                <cn cellml:units="dimensionless">1.0</cn>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2.0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>M_build_protein</ci>
                <ci>M_build_in</ci>
            </apply>
            <apply>
                <eq/>
                <ci>R_reg</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_ATP</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_ATP</ci>
                            <ci>f_ATP_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_G6P</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_G6P</ci>
                            <ci>f_G6P_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_glc</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_glc</ci>
                            <ci>f_glc_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_H</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_H</ci>
                            <ci>f_H_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_growth</ci>
                <apply>
                    <times/>
                    <ci>growth_level</ci>
                    <ci>J_ref</ci>
                    <ci>throttle</ci>
                    <ci>R_reg</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_growth_used</ci>
                <apply>
                    <times/>
                    <ci>J_growth</ci>
                    <ci>f_ATP_bio</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>M_daughter</ci>
                <apply>
                    <plus/>
                    <ci>M_build_bio</ci>
                    <ci>M_build_protein</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>growth_progress</ci>
                <apply>
                    <divide/>
                    <ci>P_growth</ci>
                    <ci>M_daughter</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>glycogen_progress</ci>
                <apply>
                    <divide/>
                    <ci>M_glyc_ATP</ci>
                    <ci>M_daughter</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_ATP_bio</ci>
                <apply>
                    <plus/>
                    <ci>J_RNA</ci>
                    <ci>J_ribo</ci>
                    <ci>J_lipid</ci>
                    <ci>J_repair</ci>
                    <ci>J_growth_used</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>M_build_bio</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <ci>n_mRNA</ci>
                                    <ci>L_mRNA</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>n_ribo</ci>
                                    <ci>L_rRNA</ci>
                                </apply>
                                <ci>genome_nt</ci>
                            </apply>
                            <ci>c_nt_denovo</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>n_lipid</ci>
                            <ci>c_lipid</ci>
                        </apply>
                    </apply>
                    <ci>N_A</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_ATP_bio</ci>
                <apply>
                    <minus/>
                    <ci>J_ATP_bio</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_ADP_bio</ci>
                <ci>J_ATP_bio</ci>
            </apply>
            <apply>
                <eq/>
                <ci>j_Pi_bio</ci>
                <ci>J_ATP_bio</ci>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>D</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>r_dmg</ci>
                        <ci>f_T_dmg</ci>
                    </apply>
                    <ci>R_repair</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>P_growth</ci>
                </apply>
                <ci>J_growth_used</ci>
            </apply>
        </math>
    </component>
</model>
