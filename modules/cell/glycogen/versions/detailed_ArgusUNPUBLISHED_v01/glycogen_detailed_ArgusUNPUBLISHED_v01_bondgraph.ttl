@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix tpl: <https://bg-rdf.org/templates/> .

@prefix : <#> .

# Detailed glycogen store: written by tools/bondgraph.py from the module's description (circulatory-autogen-modules)
# T = 293.15 K; volume 6.28319e-18 m3; stores q = C V, K = exp(mu0/RT) / (c_std V)

:glycogen
    a bgf:BondgraphModel ;
    bgf:usesTemplate tpl:chemical.ttl ;
    bgf:hasBondElement :q_G6P, :q_ATP, :q_ADP, :q_Pi, :q_H, :q_H2O, :q_G1P, :q_ADPglc, :q_PPi, :q_Gly, :Re_PGM, :Re_GLGC, :Re_GLGA, :Re_PPA, :Re_GLGP .

:q_G6P  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.283185307179586e-18 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "3.722084199971267e+16 mol-1"^^cdt:ucum ] .

:q_ATP  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.031857894892403e-17 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "4.818207982109391e+18 mol-1"^^cdt:ucum ] .

:q_ADP  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.518583772020569e-18 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "2.095332538865514e+15 mol-1"^^cdt:ucum ] .

:q_Pi  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.283185307179586e-17 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "4.467975097404830e+15 mol-1"^^cdt:ucum ] .

:q_H  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "1.578264791976477e-22 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "9.903920881343370e+19 mol-1"^^cdt:ucum ] .

:q_H2O  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.487167845484670e-13 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "3.930950858873811e+14 mol-1"^^cdt:ucum ] .

:q_G1P
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.166904968414481e-19 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "7.438819252748426e+17 mol-1"^^cdt:ucum ] .

:q_ADPglc
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.141592653589793e-19 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1.485568323625984e+18 mol-1"^^cdt:ucum ] .

:q_PPi
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.141592653589793e-18 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1.501356917529899e+17 mol-1"^^cdt:ucum ] .

:q_Gly  # activity C k_sat / (k_sat + C), k_sat 10 mM: linear here, at the export point
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.141592653589793e-16 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1.237948347876284e+17 mol-1"^^cdt:ucum ] .

:Re_PGM
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_PGM" ; bgf:hasValue "2.409350424886477e-17 mol/s"^^cdt:ucum ] .

:Re_GLGC  # saturation sigma 46.58: folded into kappa at the export's concentrations
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_GLGC" ; bgf:hasValue "6.628471624947949e-21 mol/s"^^cdt:ucum ] .

:Re_GLGA  # saturation sigma 25.56: folded into kappa at the export's concentrations
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_GLGA" ; bgf:hasValue "1.219029786617613e-20 mol/s"^^cdt:ucum ] .

:Re_PPA
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_PPA" ; bgf:hasValue "8.715052712222028e-23 mol/s"^^cdt:ucum ] .

:Re_GLGP  # saturation sigma 5.062 and inhibition by ATP (K_i 1 mM): folded into kappa at the export's concentrations
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_GLGP" ; bgf:hasValue "4.395289861672892e-21 mol/s"^^cdt:ucum ] .

:q_G6P.Re_PGM bgf:hasSource :q_G6P ; bgf:hasTarget :Re_PGM .
:Re_PGM.q_G1P bgf:hasSource :Re_PGM ; bgf:hasTarget :q_G1P .
:q_G1P.Re_GLGC bgf:hasSource :q_G1P ; bgf:hasTarget :Re_GLGC .
:q_ATP.Re_GLGC bgf:hasSource :q_ATP ; bgf:hasTarget :Re_GLGC .
:q_H.Re_GLGC bgf:hasSource :q_H ; bgf:hasTarget :Re_GLGC .
:Re_GLGC.q_ADPglc bgf:hasSource :Re_GLGC ; bgf:hasTarget :q_ADPglc .
:Re_GLGC.q_PPi bgf:hasSource :Re_GLGC ; bgf:hasTarget :q_PPi .
:q_ADPglc.Re_GLGA bgf:hasSource :q_ADPglc ; bgf:hasTarget :Re_GLGA .
:Re_GLGA.q_ADP bgf:hasSource :Re_GLGA ; bgf:hasTarget :q_ADP .
:Re_GLGA.q_Gly bgf:hasSource :Re_GLGA ; bgf:hasTarget :q_Gly .
:Re_GLGA.q_H bgf:hasSource :Re_GLGA ; bgf:hasTarget :q_H .
:q_PPi.Re_PPA bgf:hasSource :q_PPi ; bgf:hasTarget :Re_PPA .
:q_H2O.Re_PPA bgf:hasSource :q_H2O ; bgf:hasTarget :Re_PPA .
:Re_PPA.q_Pi bgf:hasSource :Re_PPA ; bgf:hasTarget :q_Pi ; bgf:bondCount 2 .
:Re_PPA.q_H bgf:hasSource :Re_PPA ; bgf:hasTarget :q_H .
:q_Gly.Re_GLGP bgf:hasSource :q_Gly ; bgf:hasTarget :Re_GLGP .
:q_Pi.Re_GLGP bgf:hasSource :q_Pi ; bgf:hasTarget :Re_GLGP .
:Re_GLGP.q_G1P bgf:hasSource :Re_GLGP ; bgf:hasTarget :q_G1P .
