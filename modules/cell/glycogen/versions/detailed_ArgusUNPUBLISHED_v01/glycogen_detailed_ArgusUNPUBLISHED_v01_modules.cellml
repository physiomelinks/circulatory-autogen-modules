        <variable name="Pf_GLGA" public_interface="out" units="dimensionless"/>
        <!-- exp(reverse affinity / RT) -->
        <variable name="Pr_GLGA" public_interface="out" units="dimensionless"/>
        <!-- glycogen synthase (GlgA) -->
        <variable name="v_GLGA" public_interface="out" units="millimolar_per_s"/>
        <!-- affinity: minus the reaction's Gibbs energy -->
        <variable name="A_GLGA" public_interface="out" units="J_per_mol"/>
        <!-- saturation (half-saturated at Pf = sigma) -->
        <variable name="sigma_GLGA" public_interface="in" units="dimensionless"/>
        <!-- inorganic pyrophosphatase: rate constant -->
        <variable name="kappa_PPA" public_interface="in" units="millimolar_per_s"/>
        <!-- exp(forward affinity / RT) -->
        <variable name="Pf_PPA" public_interface="out" units="dimensionless"/>
        <!-- exp(reverse affinity / RT) -->
        <variable name="Pr_PPA" public_interface="out" units="dimensionless"/>
        <!-- inorganic pyrophosphatase -->
        <variable name="v_PPA" public_interface="out" units="millimolar_per_s"/>
        <!-- affinity: minus the reaction's Gibbs energy -->
        <variable name="A_PPA" public_interface="out" units="J_per_mol"/>
        <!-- glycogen phosphorylase (GlgP): rate constant -->
        <variable name="kappa_GLGP" public_interface="in" units="millimolar_per_s"/>
        <!-- exp(forward affinity / RT) -->
        <variable name="Pf_GLGP" public_interface="out" units="dimensionless"/>
        <!-- exp(reverse affinity / RT) -->
        <variable name="Pr_GLGP" public_interface="out" units="dimensionless"/>
        <!-- glycogen phosphorylase (GlgP) -->
        <variable name="v_GLGP" public_interface="out" units="millimolar_per_s"/>
        <!-- affinity: minus the reaction's Gibbs energy -->
        <variable name="A_GLGP" public_interface="out" units="J_per_mol"/>
        <!-- inhibition of glycogen phosphorylase (GlgP) by ATP -->
