                                    <ci>mu0_H</ci>
                                    <apply>
                                        <times/>
                                        <ci>R</ci>
                                        <ci>T</ci>
                                    </apply>
                                </apply>
                            </apply>
                            <ci>C_H</ci>
                        </apply>
                        <ci>c_std_H</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Pr_GLGC</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <ci>mu0_ADPglc</ci>
                                    <apply>
                                        <times/>
                                        <ci>R</ci>
                                        <ci>T</ci>
                                    </apply>
                                </apply>
                            </apply>
                            <ci>C_ADPglc</ci>
                        </apply>
                        <ci>c_std_ADPglc</ci>
                    </apply>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
