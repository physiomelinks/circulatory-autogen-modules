                    <apply>
                        <times/>
                        <ci>kappa_GLGA</ci>
                        <apply>
                            <minus/>
                            <ci>Pf_GLGA</ci>
                            <ci>Pr_GLGA</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <divide/>
                            <apply>
                                <plus/>
                                <ci>Pf_GLGA</ci>
                                <ci>Pr_GLGA</ci>
                            </apply>
                            <ci>sigma_GLGA</ci>
                        </apply>
                    </apply>
