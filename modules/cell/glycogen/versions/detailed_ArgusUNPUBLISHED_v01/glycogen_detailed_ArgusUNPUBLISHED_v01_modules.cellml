        <variable name="Pf_PGM" public_interface="out" units="dimensionless"/>
        <!-- exp(reverse affinity / RT) -->
        <variable name="Pr_PGM" public_interface="out" units="dimensionless"/>
        <!-- phosphoglucomutase -->
        <variable name="v_PGM" public_interface="out" units="millimolar_per_s"/>
        <!-- affinity: minus the reaction's Gibbs energy -->
        <variable name="A_PGM" public_interface="out" units="J_per_mol"/>
        <!-- ADP-glucose pyrophosphorylase (GlgC): rate constant -->
        <variable name="kappa_GLGC" public_interface="in" units="millimolar_per_s"/>
        <!-- exp(forward affinity / RT) -->
        <variable name="Pf_GLGC" public_interface="out" units="dimensionless"/>
        <!-- exp(reverse affinity / RT) -->
        <variable name="Pr_GLGC" public_interface="out" units="dimensionless"/>
        <!-- ADP-glucose pyrophosphorylase (GlgC) -->
        <variable name="v_GLGC" public_interface="out" units="millimolar_per_s"/>
        <!-- affinity: minus the reaction's Gibbs energy -->
        <variable name="A_GLGC" public_interface="out" units="J_per_mol"/>
        <!-- saturation (half-saturated at Pf = sigma) -->
        <variable name="sigma_GLGC" public_interface="in" units="dimensionless"/>
        <!-- glycogen synthase (GlgA): rate constant -->
        <variable name="kappa_GLGA" public_interface="in" units="millimolar_per_s"/>
