        <!-- standard chemical potential of pyrophosphate (from the reactions' Gibbs energies, tools/bondgraph.py) -->
        <variable name="mu0_PPi" public_interface="in" units="J_per_mol"/>
        <variable name="c_std_PPi" public_interface="in" units="millimolar"/>
        <variable name="C_PPi_init" public_interface="in" units="millimolar"/>
        <!-- pyrophosphate -->
        <variable initial_value="C_PPi_init" name="C_PPi" public_interface="out" units="millimolar"/>
        <!-- standard chemical potential of glycogen (glucose units) (from the reactions' Gibbs energies, tools/bondgraph.py) -->
        <variable name="mu0_Gly" public_interface="in" units="J_per_mol"/>
        <variable name="c_std_Gly" public_interface="in" units="millimolar"/>
        <variable name="C_Gly_init" public_interface="in" units="millimolar"/>
        <!-- glycogen (glucose units) -->
        <variable initial_value="C_Gly_init" name="C_Gly" public_interface="out" units="millimolar"/>
        <!-- phosphoglucomutase: rate constant -->
        <variable name="kappa_PGM" public_interface="in" units="millimolar_per_s"/>
