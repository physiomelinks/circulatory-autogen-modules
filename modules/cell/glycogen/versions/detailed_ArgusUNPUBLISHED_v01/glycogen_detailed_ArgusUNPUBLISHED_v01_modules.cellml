                <eq/>
                <ci>A_PGM</ci>
                <apply>
                    <times/>
                    <ci>R</ci>
                    <ci>T</ci>
                    <apply>
                        <minus/>
                        <apply>
                            <ln/>
                            <ci>Pf_PGM</ci>
                        </apply>
                        <apply>
                            <ln/>
                            <ci>Pr_PGM</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Pf_GLGC</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <exp/>
