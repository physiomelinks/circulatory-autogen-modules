<?xml version='1.0' encoding='UTF-8'?>
<model name="protein_pool_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="protein_pool">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="m_init" public_interface="in" units="dimensionless"/>
        <!-- expression: copies relative to n_0 (protein_expression port) -->
        <variable initial_value="m_init" name="m" public_interface="out" units="dimensionless"/>
        <!-- expression the cell is moving to (set by the game) -->
        <variable name="m_target" public_interface="in" units="dimensionless"/>
        <!-- the target after regulation: m_target R_reg -->
        <variable name="m_goal" public_interface="out" units="dimensionless"/>
        <!-- time constant of the rise (the mRNA's mean lifetime) -->
        <variable name="tau" public_interface="in" units="second"/>
        <!-- copies per cell at m = 1 -->
        <variable name="n_0" public_interface="in" units="dimensionless"/>
        <!-- amino acids per functional unit -->
        <variable name="L" public_interface="in" units="dimensionless"/>
        <!-- membrane area one copy takes (0 for a cytosolic protein) -->
        <variable name="footprint" public_interface="in" units="nm2"/>
        <!-- ~P per amino acid made from glucose -->
        <variable name="c_syn" public_interface="in" units="dimensionless"/>
        <!-- ~P per peptide bond -->
        <variable name="c_poly" public_interface="in" units="dimensionless"/>
        <!-- ~P per residue for ATP-dependent proteolysis -->
        <variable name="c_deg" public_interface="in" units="dimensionless"/>
        <!-- ~P per amino acid returned to the pool -->
        <variable name="c_recycle" public_interface="in" units="dimensionless"/>
        <!-- fraction of the protein degraded per second -->
        <variable name="k_deg" public_interface="in" units="per_s"/>
        <variable name="N_A" public_interface="in" units="per_mol"/>
        <!-- ATP for half-rate synthesis -->
        <variable name="K_m_ATP" public_interface="in" units="millimolar"/>
        <!-- ATP at which the costs are stated (rest) -->
        <variable name="ATP_ref" public_interface="in" units="millimolar"/>
        <!-- cytosol ATP (protein_synthesis port) -->
        <variable name="ATP" public_interface="in" units="millimolar"/>
        <!-- share of the build demand the cell can serve (protein_synthesis port) -->
        <variable name="s_build" public_interface="in" units="dimensionless"/>
        <!-- regulation of the cell's protein synthesis: the share of the degraded copies it replaces (protein_synthesis port) -->
        <variable name="R_syn" public_interface="in" units="dimensionless"/>
        <!-- copies per cell -->
        <variable name="n" public_interface="out" units="dimensionless"/>
        <!-- (m_goal - m)/tau -->
        <variable name="r_rel" public_interface="out" units="per_s"/>
        <!-- rising part of r_rel (copies to build) -->
        <variable name="r_up" public_interface="out" units="per_s"/>
        <!-- the copies the cell replaces as they are degraded: min(m, m_goal) -->
        <variable name="m_kept" public_interface="out" units="dimensionless"/>
        <!-- replacement synthesis: k_deg R_syn m_kept, slowed as ATP runs out -->
        <variable name="r_rep" public_interface="out" units="per_s"/>
        <!-- degradation: k_deg m, slowed as ATP runs out -->
        <variable name="r_deg" public_interface="out" units="per_s"/>
        <!-- net loss: copies degraded and not replaced (r_rep - r_deg, never positive) -->
        <variable name="r_down" public_interface="out" units="per_s"/>
        <!-- synthesis slows as ATP runs out: 1 at ATP_ref -->
        <variable name="f_ATP" public_interface="out" units="dimensionless"/>
        <!-- f_ATP capped at 1: building never runs faster than asked -->
        <variable name="f_build" public_interface="out" units="dimensionless"/>
        <!-- ATP to keep the copies: replacement synthesis and degradation -->
        <variable name="J_keep" public_interface="out" units="mol_per_s"/>
        <!-- ATP the rise asks for: building r_up n_0 copies per second -->
        <variable name="J_demand" public_interface="out" units="mol_per_s"/>
        <!-- ATP spent building -->
        <variable name="J_build" public_interface="out" units="mol_per_s"/>
        <!-- all ATP this protein uses -->
        <variable name="J_ATP" public_interface="out" units="mol_per_s"/>
        <!-- ATP to build the present copies from scratch (its share of a daughter) -->
        <variable name="M_build" public_interface="out" units="mole"/>
        <!-- membrane area per unit of m -->
        <variable name="a_unit" public_interface="out" units="um2"/>
        <!-- membrane area the copies take -->
        <variable name="A_protein" public_interface="out" units="um2"/>
        <!-- most membrane area the proteins may take (membrane_ceiling port) -->
        <variable name="A_ceiling" public_interface="in" units="um2"/>
        <!-- share of the ceiling the present copies take -->
        <variable name="share" public_interface="out" units="dimensionless"/>
        <!-- share of the ceiling one unit of m takes (one flagellum for the Flagellum) -->
        <variable name="s_unit" public_interface="out" units="dimensionless"/>
        <!-- regulation by ATP, 0-1, 1 at and above rest (regulation_signals port) -->
        <variable name="f_ATP_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by G6P, 0-1, 1 at and above rest (regulation_signals port) -->
        <variable name="f_G6P_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by glucose inside, 0-1, 1 at and above rest (regulation_signals port) -->
        <variable name="f_glc_reg" public_interface="in" units="dimensionless"/>
        <!-- regulation by H+ (falling pH), 0-1, 1 at and above rest (regulation_signals port) -->
        <variable name="f_H_reg" public_interface="in" units="dimensionless"/>
        <!-- 1: falling ATP lowers the expression target (set by the game); 0: it does not -->
        <variable name="reg_on_ATP" public_interface="in" units="dimensionless"/>
        <!-- 1: falling G6P lowers the expression target (set by the game); 0: it does not -->
        <variable name="reg_on_G6P" public_interface="in" units="dimensionless"/>
        <!-- 1: falling glucose inside lowers the expression target (set by the game); 0: it does not -->
        <variable name="reg_on_glc" public_interface="in" units="dimensionless"/>
        <!-- 1: falling H+ (falling pH) lowers the expression target (set by the game); 0: it does not -->
        <variable name="reg_on_H" public_interface="in" units="dimensionless"/>
        <!-- regulation factor on the expression target: prod (1 - reg_on + reg_on f) -->
        <variable name="R_reg" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>n</ci>
                <apply>
                    <times/>
                    <ci>n_0</ci>
                    <ci>m</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_reg</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_ATP</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_ATP</ci>
                            <ci>f_ATP_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_G6P</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_G6P</ci>
                            <ci>f_G6P_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_glc</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_glc</ci>
                            <ci>f_glc_reg</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>reg_on_H</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>reg_on_H</ci>
                            <ci>f_H_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>m_goal</ci>
                <apply>
                    <times/>
                    <ci>m_target</ci>
                    <ci>R_reg</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_rel</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>m_goal</ci>
                        <ci>m</ci>
                    </apply>
                    <ci>tau</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_up</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>r_rel</ci>
                        <apply>
                            <abs/>
                            <ci>r_rel</ci>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2.0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_ATP</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>ATP</ci>
                            <apply>
                                <plus/>
                                <ci>K_m_ATP</ci>
                                <ci>ATP</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>K_m_ATP</ci>
                            <ci>ATP_ref</ci>
                        </apply>
                    </apply>
                    <ci>ATP_ref</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_build</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>f_ATP</ci>
                            <cn cellml:units="dimensionless">1.0</cn>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <ci>f_ATP</ci>
                                <cn cellml:units="dimensionless">1.0</cn>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2.0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>m_kept</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>m</ci>
                            <ci>m_goal</ci>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <ci>m</ci>
                                <ci>m_goal</ci>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">2.0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_deg</ci>
                <apply>
                    <times/>
                    <ci>k_deg</ci>
                    <ci>m</ci>
                    <ci>f_build</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_down</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>k_deg</ci>
                    </apply>
                    <ci>f_build</ci>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <plus/>
                                <apply>
                                    <minus/>
                                    <ci>m</ci>
                                    <ci>m_goal</ci>
                                </apply>
                                <apply>
                                    <abs/>
                                    <apply>
                                        <minus/>
                                        <ci>m</ci>
                                        <ci>m_goal</ci>
                                    </apply>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">2.0</cn>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <ci>R_syn</ci>
                            </apply>
                            <ci>m_kept</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_rep</ci>
                <apply>
                    <plus/>
                    <ci>r_deg</ci>
                    <ci>r_down</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_keep</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>n_0</ci>
                        <ci>L</ci>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <apply>
                                    <plus/>
                                    <ci>c_poly</ci>
                                    <ci>c_recycle</ci>
                                </apply>
                                <ci>r_rep</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>c_deg</ci>
                                <ci>r_deg</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>N_A</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_demand</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>r_up</ci>
                        <ci>n_0</ci>
                        <ci>L</ci>
                        <apply>
                            <plus/>
                            <ci>c_syn</ci>
                            <ci>c_poly</ci>
                        </apply>
                    </apply>
                    <ci>N_A</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_build</ci>
                <apply>
                    <times/>
                    <ci>J_demand</ci>
                    <ci>s_build</ci>
                    <ci>f_build</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_ATP</ci>
                <apply>
                    <plus/>
                    <ci>J_keep</ci>
                    <ci>J_build</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>M_build</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>n</ci>
                        <ci>L</ci>
                        <apply>
                            <plus/>
                            <ci>c_syn</ci>
                            <ci>c_poly</ci>
                        </apply>
                    </apply>
                    <ci>N_A</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>a_unit</ci>
                <apply>
                    <times/>
                    <ci>n_0</ci>
                    <ci>footprint</ci>
                    <cn cellml:units="um2_per_nm2" type="e-notation">1<sep/>-6</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A_protein</ci>
                <apply>
                    <times/>
                    <ci>a_unit</ci>
                    <ci>m</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>share</ci>
                <apply>
                    <divide/>
                    <ci>A_protein</ci>
                    <ci>A_ceiling</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>s_unit</ci>
                <apply>
                    <divide/>
                    <ci>a_unit</ci>
                    <ci>A_ceiling</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>m</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>r_up</ci>
                        <ci>s_build</ci>
                        <ci>f_build</ci>
                    </apply>
                    <ci>r_down</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
