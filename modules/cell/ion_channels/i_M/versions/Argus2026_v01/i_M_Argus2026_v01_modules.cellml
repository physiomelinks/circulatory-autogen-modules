<?xml version='1.0' encoding='UTF-8'?>
<model name="i_M_Argus2026_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_M_SN">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="Delta_V_mid_w" public_interface="in" units="milliV"/>
        <variable name="E_K" public_interface="in" units="milliV"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="V" public_interface="in" units="milliV"/>
        <variable name="V_den_w" public_interface="in" units="milliV"/>
        <variable name="V_mid_w" public_interface="in" units="milliV"/>
        <variable name="V_rest_approx" public_interface="in" units="milliV"/>
        <variable name="g_M" public_interface="out" units="microS"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <variable name="rho_M" public_interface="in" units="per_um2"/>
        <variable name="gamma_M" public_interface="in" units="picoS"/>
        <variable name="g_M_mod" public_interface="in" units="dimensionless"/>
        <variable name="i_M" public_interface="out" units="nanoA"/>
        <variable name="j_KM" public_interface="out" units="mol_per_s"/>
        <variable name="tau_w" public_interface="out" units="millis"/>
        <variable name="tau_w_min" public_interface="in" units="millis"/>
        <variable name="tau_w_num" public_interface="in" units="millis"/>
        <variable name="w" public_interface="out" units="dimensionless" initial_value="w_init"/>
        <variable name="w_inf" public_interface="out" units="dimensionless"/>
        <variable name="w_init" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>w_init</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V_rest_approx</ci>
                                        <ci>V_mid_w</ci>
                                        <ci>Delta_V_mid_w</ci>
                                    </apply>
                                </apply>
                                <ci>V_den_w</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>w_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <ci>V_mid_w</ci>
                                        <ci>Delta_V_mid_w</ci>
                                    </apply>
                                </apply>
                                <ci>V_den_w</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_w</ci>
                <apply>
                    <plus/>
                    <ci>tau_w_min</ci>
                    <apply>
                        <divide/>
                        <ci>tau_w_num</ci>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless">2.0</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <ci>V</ci>
                                            <ci>V_mid_w</ci>
                                            <ci>Delta_V_mid_w</ci>
                                        </apply>
                                        <cn cellml:units="milliV">15</cn>
                                    </apply>
                                </apply>
                            </apply>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>V</ci>
                                            <ci>V_mid_w</ci>
                                            <ci>Delta_V_mid_w</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="milliV">25</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>w</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>w_inf</ci>
                        <ci>w</ci>
                    </apply>
                    <apply>
                        <divide/>
                        <ci>tau_w</ci>
                        <cn cellml:units="millis_per_s">1000</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_M</ci>
                <apply>
                    <times/>
                    <ci>g_M_mod</ci>
                    <ci>g_M</ci>
                    <ci>w</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_K</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_KM</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>i_M</ci>
                        </apply>
                        <ci>F</ci>
                    </apply>
                    <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>g_M</ci><apply><times/><ci>A_mem</ci><ci>rho_M</ci><ci>gamma_M</ci><cn cellml:units="microS_per_picoS" type="e-notation">1<sep/>-6</cn></apply></apply>
        </math>
    </component>
</model>
