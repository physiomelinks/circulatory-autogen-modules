        <variable name="R" public_interface="in" units="J_per_MK"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="F" public_interface="in" units="C_per_M"/>
        <variable name="P_Ca" public_interface="in" units="m_per_s"/>
        <variable initial_value="0.0" name="c" units="dimensionless"/>
        <variable name="c_bar" units="dimensionless"/>
        <variable name="tau_c" units="second"/>
        <variable initial_value="0.0" name="hc" units="dimensionless"/>
        <variable name="hc_bar" units="dimensionless"/>
        <variable name="tau_hc" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_Ca</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="dimensionless">4</cn>
                                    <apply>
                                        <power/>
                                        <ci>F</ci>
                                        <cn cellml:units="dimensionless">2</cn>
                                    </apply>
                                    <ci>Vm</ci>
                                    <ci>P_Ca</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                            <apply>
                                <minus/>
                                <apply>
                                    <times/>
                                    <ci>Cai</ci>
