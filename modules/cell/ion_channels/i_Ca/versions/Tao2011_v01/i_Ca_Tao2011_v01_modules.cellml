                                <cn cellml:units="dimensionless">0.0434</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="per_milliV">0.0201</cn>
                                        </apply>
                                        <ci>Vm</ci>
                                    </apply>
