<?xml version='1.0' encoding='UTF-8'?>
<model name="i_Ca_Tao2011_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_Ca_Tao_2011">
        <variable name="i_Ca" public_interface="out" units="nanoA"/>
