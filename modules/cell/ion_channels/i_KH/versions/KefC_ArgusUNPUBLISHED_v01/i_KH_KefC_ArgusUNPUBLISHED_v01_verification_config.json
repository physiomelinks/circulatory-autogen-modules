{
  "module_type": "i_KH",
  "version": "KefC_ArgusUNPUBLISHED_v01",
  "sim_time": 1.0,
  "pre_time": 0.0,
  "dt": 0.01,
  "solver": "CVODE_myokit",
  "solver_info": {
    "rtol": 1e-10,
    "atol": 1e-14
  },
  "outputs": [
    "drive",
    "r_cycle",
    "j_KH_K",
    "j_KH_H"
  ],
  "run_parameters": {},
  "invariants": [
    {
      "description": "stoichiometry: 1 K+ out, 1 H+ in, no net charge (exact)",
      "expr": "np.allclose(j_KH_H, -j_KH_K, rtol=1e-12, atol=0)"
    },
    {
      "description": "second law: the exchange runs down its free energy, r drive >= 0",
      "expr": "np.all(r_cycle*drive >= 0)"
    }
  ],
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
        "atol": 1e-08
      }
    ]
  }
}
