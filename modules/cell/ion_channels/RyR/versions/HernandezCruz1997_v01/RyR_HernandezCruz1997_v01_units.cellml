<?xml version='1.0' encoding='UTF-8'?>
<model name="Units" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <units name="millimolar">
        <unit prefix="milli" units="mole"/>
        <unit exponent="-1" units="litre"/>
    </units>
    <units name="per_s">
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_millimolar_per_s">
        <unit exponent="-1" units="millimolar"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="m3_per_s">
        <unit exponent="3" units="metre"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="mol_per_s">
        <unit units="mole"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="um2">
        <unit exponent="2" prefix="micro" units="metre"/>
    </units>
    <units name="per_um2">
        <unit exponent="-2" prefix="micro" units="metre"/>
    </units>
    <units name="m3_per_um3">
        <unit exponent="3" units="metre"/>
        <unit exponent="-3" prefix="micro" units="metre"/>
    </units>
    <units name="um3_per_s">
        <unit exponent="3" prefix="micro" units="metre"/>
        <unit exponent="-1" units="second"/>
    </units>
</model>
