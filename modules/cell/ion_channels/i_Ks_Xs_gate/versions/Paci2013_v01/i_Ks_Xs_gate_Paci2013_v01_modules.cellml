<?xml version='1.0' encoding='UTF-8'?>
<model name="i_Ks_Xs_gate_Paci2013_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_Ks_Xs_gate_Paci_2013">
        <variable name="Xs_init" public_interface="in" units="dimensionless"/>
        <variable initial_value="Xs_init" name="Xs" public_interface="out" units="dimensionless"/>
        <variable name="Xs_infinity" units="dimensionless"/>
        <variable name="alpha_Xs" units="dimensionless"/>
        <variable name="beta_Xs" units="dimensionless"/>
        <variable name="tau_Xs" units="second"/>
        <variable name="Vm" public_interface="in" units="volt"/>
        <variable name="t" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Xs_infinity</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <minus/>
                                            <ci>Vm</ci>
                                        </apply>
                                        <cn cellml:units="milliV_per_V">1000</cn>
                                    </apply>
                                    <cn cellml:units="milliV">20</cn>
                                </apply>
                                <cn cellml:units="milliV">16</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>alpha_Xs</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1100</cn>
                    <apply>
                        <root/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <minus/>
                                            <cn cellml:units="milliV">10</cn>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>Vm</ci>
                                            <cn cellml:units="milliV_per_V">1000</cn>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="milliV">6</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>beta_Xs</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <minus/>
                                        <cn cellml:units="milliV">60</cn>
                                    </apply>
                                    <apply>
                                        <times/>
                                        <ci>Vm</ci>
                                        <cn cellml:units="milliV_per_V">1000</cn>
                                    </apply>
                                </apply>
                                <cn cellml:units="milliV">20</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_Xs</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="second">1</cn>
                        <ci>alpha_Xs</ci>
                        <ci>beta_Xs</ci>
                    </apply>
                    <cn cellml:units="dimensionless">1000</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Xs</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>Xs_infinity</ci>
                        <ci>Xs</ci>
                    </apply>
                    <ci>tau_Xs</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
