<?xml version='1.0' encoding='UTF-8'?>
<model name="i_to_Paci2013_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_to_Paci_2013">
        <variable name="i_to" public_interface="out" units="A_per_F"/>
        <variable name="g_to" public_interface="in" units="S_per_F"/>
        <variable name="E_K" public_interface="in" units="volt"/>
        <variable name="t" private_interface="out" public_interface="in" units="second"/>
        <variable name="Vm" private_interface="out" public_interface="in" units="volt"/>
        <variable name="q" private_interface="in" units="dimensionless"/>
        <variable name="r" private_interface="in" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_to</ci>
                <apply>
                    <times/>
                    <ci>g_to</ci>
                    <apply>
                        <minus/>
                        <ci>Vm</ci>
                        <ci>E_K</ci>
                    </apply>
                    <ci>q</ci>
                    <ci>r</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
