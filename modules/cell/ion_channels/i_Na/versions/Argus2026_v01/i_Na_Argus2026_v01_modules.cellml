<?xml version='1.0' encoding='UTF-8'?>
<model name="i_Na_Argus2026_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_Na_SN">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="E_Na" public_interface="in" units="milliV"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="V" public_interface="in" units="milliV"/>
        <variable name="V_den_h" public_interface="in" units="milliV"/>
        <variable name="V_den_m" public_interface="in" units="milliV"/>
        <variable name="V_mid_h" public_interface="in" units="milliV"/>
        <variable name="V_mid_m" public_interface="in" units="milliV"/>
        <variable name="V_rest_approx" public_interface="in" units="milliV"/>
        <variable name="epsilon_tau" units="second" initial_value="1e-6"/>
        <variable name="g_Na" public_interface="out" units="microS"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <variable name="rho_Na" public_interface="in" units="per_um2"/>
        <variable name="gamma_Na" public_interface="in" units="picoS"/>
        <variable name="g_Na_mod" public_interface="in" units="dimensionless"/>
        <variable name="h" public_interface="out" units="dimensionless" initial_value="h_init"/>
        <variable name="h_inf" public_interface="out" units="dimensionless"/>
        <variable name="h_init" public_interface="out" units="dimensionless"/>
        <variable name="i_Na" public_interface="out" units="nanoA"/>
        <variable name="j_Na" public_interface="out" units="mol_per_s"/>
        <variable name="m" public_interface="out" units="dimensionless" initial_value="m_init"/>
        <variable name="m_inf" public_interface="out" units="dimensionless"/>
        <variable name="m_init" public_interface="out" units="dimensionless"/>
        <variable name="tau_h" public_interface="out" units="millis"/>
        <variable name="tau_h_max" public_interface="in" units="millis"/>
        <variable name="tau_h_min" public_interface="in" units="millis"/>
        <variable name="tau_m" public_interface="out" units="millis"/>
        <!-- temperature scaling of the gating kinetics: every gating time constant is divided by phi = Q10^((T - T_ref)/10 K) (review 2026-10-05) -->
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="Q10_m_Na" public_interface="in" units="dimensionless"/>
        <variable name="Q10_h_Na" public_interface="in" units="dimensionless"/>
        <variable name="T_ref_Na" public_interface="in" units="kelvin"/>
        <variable name="phi_m_Na" public_interface="out" units="dimensionless"/>
        <variable name="phi_h_Na" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>m_init</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V_rest_approx</ci>
                                        <ci>V_mid_m</ci>
                                    </apply>
                                </apply>
                                <ci>V_den_m</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>h_init</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>V_rest_approx</ci>
                                    <ci>V_mid_h</ci>
                                </apply>
                                <ci>V_den_h</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>m_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <ci>V_mid_m</ci>
                                    </apply>
                                </apply>
                                <ci>V_den_m</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>h_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>V</ci>
                                    <ci>V_mid_h</ci>
                                </apply>
                                <ci>V_den_h</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_m</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="millis">0.06</cn>
                    <apply>
                        <divide/>
                        <cn cellml:units="millis">0.8</cn>
                        <apply>
                            <plus/>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>V_mid_m</ci>
                                        <cn cellml:units="milliV">10</cn>
                                        <ci>V</ci>
                                    </apply>
                                    <cn cellml:units="milliV">10</cn>
                                </apply>
                            </apply>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>V_mid_m</ci>
                                            <cn cellml:units="milliV">10</cn>
                                            <ci>V</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="milliV">20</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_h</ci>
                <apply>
                    <plus/>
                    <ci>tau_h_min</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>tau_h_max</ci>
                            <ci>tau_h_min</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>V_mid_h</ci>
                                            <cn cellml:units="milliV">10</cn>
                                            <ci>V</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="milliV">14</cn>
                                </apply>
                            </apply>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>V_mid_h</ci>
                                            <cn cellml:units="milliV">20</cn>
                                        </apply>
                                        <ci>V</ci>
                                    </apply>
                                    <cn cellml:units="milliV">2</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>m</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>m_inf</ci>
                        <ci>m</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <abs/>
                                <apply>
                                    <divide/>
                                    <ci>tau_m</ci>
                                    <cn cellml:units="millis_per_s">1000</cn>
                                </apply>
                            </apply>
                            <ci>phi_m_Na</ci>
                        </apply>
                        <ci>epsilon_tau</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>h</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>h_inf</ci>
                        <ci>h</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <abs/>
                                <apply>
                                    <divide/>
                                    <ci>tau_h</ci>
                                    <cn cellml:units="millis_per_s">1000</cn>
                                </apply>
                            </apply>
                            <ci>phi_h_Na</ci>
                        </apply>
                        <ci>epsilon_tau</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_Na</ci>
                <apply>
                    <times/>
                    <ci>g_Na</ci>
                    <ci>g_Na_mod</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_Na</ci>
                    </apply>
                    <apply>
                        <power/>
                        <ci>m</ci>
                        <cn cellml:units="dimensionless">3</cn>
                    </apply>
                    <ci>h</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_Na</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>i_Na</ci>
                        </apply>
                        <ci>F</ci>
                    </apply>
                    <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>g_Na</ci><apply><times/><ci>A_mem</ci><ci>rho_Na</ci><ci>gamma_Na</ci><cn cellml:units="microS_per_picoS" type="e-notation">1<sep/>-6</cn></apply></apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>phi_m_Na</ci>
                <apply>
                    <power/>
                    <ci>Q10_m_Na</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>T</ci>
                            <ci>T_ref_Na</ci>
                        </apply>
                        <cn cellml:units="kelvin">10</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi_h_Na</ci>
                <apply>
                    <power/>
                    <ci>Q10_h_Na</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>T</ci>
                            <ci>T_ref_Na</ci>
                        </apply>
                        <cn cellml:units="kelvin">10</cn>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
