<?xml version='1.0' encoding='UTF-8'?>
<model name="i_CaL_f2_gate_Paci2013_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_CaL_f2_gate_Paci_2013">
        <variable name="f2_init" public_interface="in" units="dimensionless"/>
        <variable initial_value="f2_init" name="f2" public_interface="out" units="dimensionless"/>
        <variable name="f2_inf" units="dimensionless"/>
        <variable name="tau_f2" units="second"/>
        <variable name="constf2" units="dimensionless"/>
        <variable name="Vm" public_interface="in" units="volt"/>
        <variable name="t" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>f2_inf</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.33</cn>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">0.67</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <times/>
                                            <ci>Vm</ci>
                                            <cn cellml:units="milliV_per_V">1000</cn>
                                        </apply>
                                        <cn cellml:units="milliV">35</cn>
                                    </apply>
                                    <cn cellml:units="milliV">4</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>constf2</ci>
                <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
                <eq/>
                <ci>tau_f2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <cn cellml:units="second">600</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <minus/>
                                            <apply>
                                                <power/>
                                                <apply>
                                                    <plus/>
                                                    <apply>
                                                        <times/>
                                                        <ci>Vm</ci>
                                                        <cn cellml:units="milliV_per_V">1000</cn>
                                                    </apply>
                                                    <cn cellml:units="milliV">25</cn>
                                                </apply>
                                                <cn cellml:units="dimensionless">2</cn>
                                            </apply>
                                        </apply>
                                        <cn cellml:units="milliV2">170</cn>
                                    </apply>
                                </apply>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="second">31</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <exp/>
                                        <apply>
                                            <divide/>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="milliV">25</cn>
                                                <apply>
                                                    <times/>
                                                    <ci>Vm</ci>
                                                    <cn cellml:units="milliV_per_V">1000</cn>
                                                </apply>
                                            </apply>
                                            <cn cellml:units="milliV">10</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                            <apply>
                                <divide/>
                                <cn cellml:units="second">16</cn>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <exp/>
                                        <apply>
                                            <divide/>
                                            <apply>
                                                <plus/>
                                                <cn cellml:units="milliV">30</cn>
                                                <apply>
                                                    <times/>
                                                    <ci>Vm</ci>
                                                    <cn cellml:units="milliV_per_V">1000</cn>
                                                </apply>
                                            </apply>
                                            <cn cellml:units="milliV">10</cn>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <ci>constf2</ci>
                    </apply>
                    <cn cellml:units="dimensionless">1000</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>f2</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>f2_inf</ci>
                        <ci>f2</ci>
                    </apply>
                    <ci>tau_f2</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
