<?xml version='1.0' encoding='UTF-8'?>
<model name="Units" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <units name="dim">
        <unit units="dimensionless"/>
    </units>
    <units name="fmol">
        <unit prefix="femto" units="mole"/>
    </units>
    <units name="per_fmol">
        <unit exponent="-1" units="fmol"/>
    </units>
    <units name="nJ_per_s">
        <unit prefix="nano" units="joule"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="fmol_per_s">
        <unit units="fmol"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="nC_per_fmol">
        <unit prefix="nano" units="coulomb"/>
        <unit exponent="-1" units="fmol"/>
    </units>
    <units name="nC">
        <unit prefix="nano" units="coulomb"/>
    </units>
    <units name="nJ_per_fmol">
        <unit prefix="nano" units="joule"/>
        <unit exponent="-1" units="fmol"/>
    </units>
    <units name="nJ_per_nC">
        <unit prefix="nano" units="joule"/>
        <unit exponent="-1" units="nC"/>
    </units>
    <units name="fC">
        <unit prefix="femto" units="coulomb"/>
    </units>
    <units name="fF">
        <unit prefix="femto" units="farad"/>
    </units>
    <units name="volt_per_sec">
        <unit exponent="-1.0" units="second"/>
        <unit units="volt"/>
    </units>
    <units name="J_per_K_per_mol">
        <unit units="joule"/>
        <unit exponent="-1.0" units="kelvin"/>
        <unit exponent="-1.0" units="mole"/>
    </units>
</model>
