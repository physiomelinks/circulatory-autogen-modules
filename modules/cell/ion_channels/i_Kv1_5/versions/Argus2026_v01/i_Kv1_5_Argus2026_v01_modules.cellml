                <ci>tau_m_Kv1_5</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="millis_per_milliV">0.1165</cn>
                                </apply>
