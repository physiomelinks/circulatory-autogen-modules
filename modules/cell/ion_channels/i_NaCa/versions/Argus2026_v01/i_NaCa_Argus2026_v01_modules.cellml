<?xml version='1.0' encoding='UTF-8'?>
<model name="i_NaCa_Argus2026_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_NaCa_SN">
        <variable name="Cai" public_interface="in" units="millimolar"/>
        <variable name="Cao" public_interface="in" units="millimolar"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="KmCa" public_interface="in" units="millimolar"/>
        <variable name="KmNai" public_interface="in" units="millimolar"/>
        <variable name="Ksat" public_interface="in" units="dimensionless"/>
        <variable name="Nai" public_interface="in" units="millimolar"/>
        <variable name="Nao" public_interface="in" units="millimolar"/>
        <variable name="R" public_interface="in" units="J_per_mol_K"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="V" public_interface="in" units="milliV"/>
        <variable name="alpha_NaCa" public_interface="in" units="dimensionless"/>
        <variable name="gamma_NaCa" public_interface="in" units="dimensionless"/>
        <variable name="i_NaCa" public_interface="out" units="nanoA"/>
        <variable name="j_NaCa_Ca" public_interface="out" units="mol_per_s"/>
        <variable name="j_NaCa_Na" public_interface="out" units="mol_per_s"/>
        <variable name="k_NaCa" public_interface="out" units="nanoA"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <variable name="rho_NaCa" public_interface="in" units="per_um2"/>
        <variable name="r_NaCa" public_interface="in" units="per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_NaCa</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>k_NaCa</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>gamma_NaCa</ci>
                                            <ci>V</ci>
                                            <cn cellml:units="V_per_milliV" type="e-notation">1<sep/>-3</cn>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>Nai</ci>
                                    <cn cellml:units="dimensionless">3</cn>
                                </apply>
                                <ci>Cao</ci>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <ci>gamma_NaCa</ci>
                                                <cn cellml:units="dimensionless">1</cn>
                                            </apply>
                                            <ci>V</ci>
                                            <cn cellml:units="V_per_milliV" type="e-notation">1<sep/>-3</cn>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>Nao</ci>
                                    <cn cellml:units="dimensionless">3</cn>
                                </apply>
                                <ci>Cai</ci>
                                <ci>alpha_NaCa</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>KmNai</ci>
                                <cn cellml:units="dimensionless">3</cn>
                            </apply>
                            <apply>
                                <power/>
                                <ci>Nao</ci>
                                <cn cellml:units="dimensionless">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>KmCa</ci>
                            <ci>Cao</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <times/>
                                <ci>Ksat</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <ci>gamma_NaCa</ci>
                                                <cn cellml:units="dimensionless">1</cn>
                                            </apply>
                                            <ci>V</ci>
                                            <cn cellml:units="V_per_milliV" type="e-notation">1<sep/>-3</cn>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_NaCa_Ca</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <ci>i_NaCa</ci>
                        <ci>F</ci>
                    </apply>
                    <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_NaCa_Na</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">3</cn>
                            </apply>
                            <ci>i_NaCa</ci>
                        </apply>
                        <ci>F</ci>
                    </apply>
                    <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>k_NaCa</ci><apply><times/><ci>A_mem</ci><ci>rho_NaCa</ci><ci>r_NaCa</ci><cn cellml:units="nanoC" type="e-notation">1.602176634<sep/>-10</cn></apply></apply>
        </math>
    </component>
</model>
