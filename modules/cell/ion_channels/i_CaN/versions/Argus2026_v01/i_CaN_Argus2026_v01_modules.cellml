<?xml version='1.0' encoding='UTF-8'?>
<model name="i_CaN_Argus2026_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_CaN_SN">
        <variable name="t" units="second" public_interface="in"/>
        <variable name="E_Ca" public_interface="in" units="milliV"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="V" public_interface="in" units="milliV"/>
        <variable name="V_den_c" public_interface="in" units="milliV"/>
        <variable name="V_den_hc" public_interface="out" units="milliV"/>
        <variable name="V_mid_c" public_interface="in" units="milliV"/>
        <variable name="V_mid_hc" public_interface="out" units="milliV"/>
        <variable name="c" public_interface="out" units="dimensionless" initial_value="c_init"/>
        <variable name="c_inf" public_interface="out" units="dimensionless"/>
        <variable name="c_init" public_interface="in" units="dimensionless"/>
        <variable name="epsilon_tau" units="second" initial_value="1e-6"/>
        <variable name="g_CaN" public_interface="out" units="microS"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <variable name="rho_CaN" public_interface="in" units="per_um2"/>
        <variable name="gamma_CaN" public_interface="in" units="picoS"/>
        <variable name="hc" public_interface="out" units="dimensionless" initial_value="hc_init"/>
        <variable name="hc_inf" public_interface="out" units="dimensionless"/>
        <variable name="hc_init" public_interface="in" units="dimensionless"/>
        <variable name="i_Ca_N" public_interface="out" units="nanoA"/>
        <variable name="j_Ca_N" public_interface="out" units="mol_per_s"/>
        <variable name="tau_c" public_interface="out" units="millis"/>
        <variable name="tau_c_max" public_interface="in" units="millis"/>
        <variable name="tau_c_min" public_interface="in" units="millis"/>
        <variable name="tau_hc" public_interface="in" units="millis"/>
        <!-- temperature scaling of the gating kinetics: every gating time constant is divided by phi = Q10^((T - T_ref)/10 K) (review 2026-10-05) -->
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="Q10_CaN" public_interface="in" units="dimensionless"/>
        <variable name="T_ref_CaN" public_interface="in" units="kelvin"/>
        <variable name="phi_CaN" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>V_mid_hc</ci>
                <apply>
                    <plus/>
                    <ci>V_mid_c</ci>
                    <cn cellml:units="milliV">11</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_den_hc</ci>
                <ci>V_den_c</ci>
            </apply>
            <apply>
                <eq/>
                <ci>c_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V</ci>
                                        <ci>V_mid_c</ci>
                                    </apply>
                                </apply>
                                <ci>V_den_c</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>hc_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>V</ci>
                                    <ci>V_mid_hc</ci>
                                </apply>
                                <ci>V_den_hc</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_c</ci>
                <apply>
                    <plus/>
                    <ci>tau_c_min</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>tau_c_max</ci>
                            <ci>tau_c_min</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>V_mid_c</ci>
                                            <cn cellml:units="milliV">20</cn>
                                        </apply>
                                        <ci>V</ci>
                                    </apply>
                                    <ci>V_den_c</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>c</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>c_inf</ci>
                        <ci>c</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <abs/>
                                <apply>
                                    <divide/>
                                    <ci>tau_c</ci>
                                    <cn cellml:units="millis_per_s">1000</cn>
                                </apply>
                            </apply>
                            <ci>phi_CaN</ci>
                        </apply>
                        <ci>epsilon_tau</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>hc</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>hc_inf</ci>
                        <ci>hc</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <divide/>
                            <apply>
                                <abs/>
                                <apply>
                                    <divide/>
                                    <ci>tau_hc</ci>
                                    <cn cellml:units="millis_per_s">1000</cn>
                                </apply>
                            </apply>
                            <ci>phi_CaN</ci>
                        </apply>
                        <ci>epsilon_tau</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_Ca_N</ci>
                <apply>
                    <times/>
                    <ci>g_CaN</ci>
                    <apply>
                        <minus/>
                        <ci>V</ci>
                        <ci>E_Ca</ci>
                    </apply>
                    <apply>
                        <power/>
                        <ci>c</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <ci>hc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_Ca_N</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>i_Ca_N</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <cn cellml:units="A_per_nanoA" type="e-notation">1<sep/>-9</cn>
                </apply>
            </apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>g_CaN</ci><apply><times/><ci>A_mem</ci><ci>rho_CaN</ci><ci>gamma_CaN</ci><cn cellml:units="microS_per_picoS" type="e-notation">1<sep/>-6</cn></apply></apply>
        </math>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>phi_CaN</ci>
                <apply>
                    <power/>
                    <ci>Q10_CaN</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>T</ci>
                            <ci>T_ref_CaN</ci>
                        </apply>
                        <cn cellml:units="kelvin">10</cn>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
