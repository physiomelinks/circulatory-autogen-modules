<?xml version='1.0' encoding='UTF-8'?>
<model name="Units" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <units name="milliV">
        <unit prefix="milli" units="volt"/>
    </units>
    <units name="nanoA">
        <unit prefix="nano" units="ampere"/>
    </units>
    <units name="um">
        <unit prefix="micro" units="metre"/>
    </units>
    <units name="m_per_s">
        <unit units="metre"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="pascal_second">
        <unit units="pascal"/>
        <unit units="second"/>
    </units>
    <units name="newton_s_per_m">
        <unit units="newton"/>
        <unit units="second"/>
        <unit exponent="-1" units="metre"/>
    </units>
    <units name="m_per_um">
        <unit units="metre"/>
        <unit exponent="-1" prefix="micro" units="metre"/>
    </units>
    <units name="V_per_milliV">
        <unit units="volt"/>
        <unit exponent="-1" units="milliV"/>
    </units>
    <units name="nanoA_per_A">
        <unit prefix="nano" units="ampere"/>
        <unit exponent="-1" units="ampere"/>
    </units>
    <units name="C_per_mol">
        <unit units="coulomb"/>
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="per_s">
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_mol">
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="mol_per_s">
        <unit units="mole"/>
        <unit exponent="-1" units="second"/>
    </units>
</model>
