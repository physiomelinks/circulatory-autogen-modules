  "bc_sweep": {
    "ranges": {
      "I_in_soma_membrane": {"min": -0.2, "max": 0.05, "points": 6}
    },
    "rationale": "Supermodule default: the globals (R, F, T; factors 0.5-2) and the boundary conditions no internal connection closes: the soma's injected current I_in_soma_membrane -0.2 to +0.05 nA (as soma sympathetic_monolithic_v01) and the varicosity NaCa exchanger's Nai_varicosity_i_NaCa (factors 0.5-2). Each submodule's own parameters are swept in that submodule version's tests."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [2e-06, 1e-06, 5e-07, 2.5e-07],
    "t_end": 0.002,
    "min_order": 0.8,
    "tol": 0.001,
    "cvode_tol": 0.01
  },
  "stability": {
