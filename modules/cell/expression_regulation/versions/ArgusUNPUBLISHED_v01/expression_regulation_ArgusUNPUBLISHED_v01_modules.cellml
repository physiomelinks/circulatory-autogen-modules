<?xml version='1.0' encoding='UTF-8'?>
<model name="expression_regulation_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="expression_regulation">
        <variable name="t" public_interface="in" units="second"/>
        <!-- cytosol ATP (metabolite_levels port) -->
        <variable name="C_ATP" public_interface="in" units="millimolar"/>
        <!-- cytosol glucose 6-phosphate (metabolite_levels port) -->
        <variable name="C_G6P" public_interface="in" units="millimolar"/>
        <!-- cytosol glucose (metabolite_levels port) -->
        <variable name="C_glc" public_interface="in" units="millimolar"/>
        <!-- free cytosolic H+ (internal_H port) -->
        <variable name="H_i" public_interface="in" units="millimolar"/>
        <!-- steepness of the regulation function -->
        <variable name="n_reg" public_interface="in" units="dimensionless"/>
        <!-- resting ATP: f_ATP is 1 at and above it -->
        <variable name="C_ATP_rest" public_interface="in" units="millimolar"/>
        <!-- resting G6P -->
        <variable name="C_G6P_rest" public_interface="in" units="millimolar"/>
        <!-- resting glucose inside -->
        <variable name="C_glc_rest" public_interface="in" units="millimolar"/>
        <!-- resting free H+: f_H is 1 at and below it -->
        <variable name="H_rest" public_interface="in" units="millimolar"/>
        <!-- ATP at which f_ATP is half-way down -->
        <variable name="K_ATP_reg" public_interface="in" units="millimolar"/>
        <!-- G6P at which f_G6P is half-way down -->
        <variable name="K_G6P_reg" public_interface="in" units="millimolar"/>
        <!-- glucose at which f_glc is half-way down -->
        <variable name="K_glc_reg" public_interface="in" units="millimolar"/>
        <!-- H+ at which f_H is half-way down (pH below rest) -->
        <variable name="K_H_reg" public_interface="in" units="millimolar"/>
        <!-- C_ATP/C_ATP_rest (0 for a negative round-off value) -->
        <variable name="x_ATP_reg" public_interface="out" units="dimensionless"/>
        <!-- shortfall below rest, 1 at the half-way level: max(0, 1 - x)/(1 - x_half) -->
        <variable name="u_ATP_reg" public_interface="out" units="dimensionless"/>
        <!-- regulation by ATP: 1 at and above rest, falls as it falls -->
        <variable name="f_ATP_reg" public_interface="out" units="dimensionless"/>
        <!-- C_G6P/C_G6P_rest (0 for a negative round-off value) -->
        <variable name="x_G6P_reg" public_interface="out" units="dimensionless"/>
        <!-- shortfall below rest, 1 at the half-way level: max(0, 1 - x)/(1 - x_half) -->
        <variable name="u_G6P_reg" public_interface="out" units="dimensionless"/>
        <!-- regulation by G6P: 1 at and above rest, falls as it falls -->
        <variable name="f_G6P_reg" public_interface="out" units="dimensionless"/>
        <!-- C_glc/C_glc_rest (0 for a negative round-off value) -->
        <variable name="x_glc_reg" public_interface="out" units="dimensionless"/>
        <!-- shortfall below rest, 1 at the half-way level: max(0, 1 - x)/(1 - x_half) -->
        <variable name="u_glc_reg" public_interface="out" units="dimensionless"/>
        <!-- regulation by glucose inside: 1 at and above rest, falls as it falls -->
        <variable name="f_glc_reg" public_interface="out" units="dimensionless"/>
        <!-- H_rest/H_i -->
        <variable name="x_H_reg" public_interface="out" units="dimensionless"/>
        <!-- shortfall below rest, 1 at the half-way level: max(0, 1 - x)/(1 - x_half) -->
        <variable name="u_H_reg" public_interface="out" units="dimensionless"/>
        <!-- regulation by H+ (falling pH): 1 at and below rest, falls as it rises -->
        <variable name="f_H_reg" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>x_ATP_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>C_ATP</ci>
                        <apply>
                            <abs/>
                            <ci>C_ATP</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <ci>C_ATP_rest</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_ATP_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>x_ATP_reg</ci>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <ci>x_ATP_reg</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <apply>
                                <divide/>
                                <ci>K_ATP_reg</ci>
                                <ci>C_ATP_rest</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_ATP_reg</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1.0</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <power/>
                            <ci>u_ATP_reg</ci>
                            <ci>n_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>x_G6P_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>C_G6P</ci>
                        <apply>
                            <abs/>
                            <ci>C_G6P</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <ci>C_G6P_rest</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_G6P_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>x_G6P_reg</ci>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <ci>x_G6P_reg</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <apply>
                                <divide/>
                                <ci>K_G6P_reg</ci>
                                <ci>C_G6P_rest</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_G6P_reg</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1.0</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <power/>
                            <ci>u_G6P_reg</ci>
                            <ci>n_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>x_glc_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>C_glc</ci>
                        <apply>
                            <abs/>
                            <ci>C_glc</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <ci>C_glc_rest</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_glc_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>x_glc_reg</ci>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <ci>x_glc_reg</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <apply>
                                <divide/>
                                <ci>K_glc_reg</ci>
                                <ci>C_glc_rest</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_glc_reg</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1.0</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <power/>
                            <ci>u_glc_reg</ci>
                            <ci>n_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>x_H_reg</ci>
                <apply>
                    <divide/>
                    <ci>H_rest</ci>
                    <ci>H_i</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_H_reg</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>x_H_reg</ci>
                        </apply>
                        <apply>
                            <abs/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <ci>x_H_reg</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2.0</cn>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <apply>
                                <divide/>
                                <ci>H_rest</ci>
                                <ci>K_H_reg</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_H_reg</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1.0</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <power/>
                            <ci>u_H_reg</ci>
                            <ci>n_reg</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
