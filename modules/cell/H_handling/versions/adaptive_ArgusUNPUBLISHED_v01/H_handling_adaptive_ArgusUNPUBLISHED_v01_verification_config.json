    "leak/j_leak_H"
  ],
  "run_parameters": {},
  "harness": {
    "module_array": [
      [
        "leak",
        "ArgusUNPUBLISHED_v01",
        "i_leak_H",
        "",
        "mod",
        "default"
      ],
      [
        "mod",
        "adaptive_ArgusUNPUBLISHED_v01",
        "H_handling",
        "leak",
        "",
        "default"
      ]
    ],
    "parameters": [
      [
        "leak/V",
        "milliV",
        -105.0,
        "harness: the fermenter cell's resting potential"
      ],
      [
        "leak/A_mem",
        "um2",
        12.566370614359172,
        "harness: in-plane membrane of the 2 um cell"
      ]
    ]
  },
  "invariants": [
    {
      "description": "proton conservation with the buffer: Vol d(H_i - beta_H pH_i) = int j_H dt (relative 1e-6)",
      "expr": "abs(Vol*(H_total_rel[-1] - H_total_rel[0]) - np.trapz(leak__j_leak_H, t)) <= 1e-6*np.trapz(np.abs(leak__j_leak_H), t) + 1e-30"
