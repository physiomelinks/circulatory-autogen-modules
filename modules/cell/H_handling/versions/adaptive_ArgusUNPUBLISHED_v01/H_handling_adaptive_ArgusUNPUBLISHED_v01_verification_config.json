    {
      "description": "pH and Nernst potential definitions (exact)",
      "expr": "np.allclose(pH_i, -np.log10(H_i/c_std), rtol=1e-12, atol=0) and np.allclose(E_H, 1000*R*T/F*np.log(H_o/H_i), rtol=1e-10, atol=1e-12)"
    }
  ],
  "stability": {
    "supported": [
