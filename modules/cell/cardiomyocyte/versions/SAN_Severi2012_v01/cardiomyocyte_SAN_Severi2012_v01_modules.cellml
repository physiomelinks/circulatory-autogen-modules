    <variable name="alpha_h" units="per_second"/>
    <variable name="beta_h" units="per_second"/>
    <variable name="h" initial_value="h_init" public_interface="out" units="dimensionless"/>
    <variable name="ACh_block" units="dimensionless"/>
    <variable name="Iso_increase_i_CaL" units="dimensionless"/>
    <variable name="i_CaL" units="nanoA"/>
    <variable name="i_siCa" units="nanoA"/>
    <variable name="i_siK" units="nanoA"/>
    <variable name="i_siNa" units="nanoA"/>
    <variable name="Iso_shift_i_CaL_dL_gate" units="millivolt"/>
    <variable name="Iso_slope" units="dimensionless"/>
    <variable name="adVm" units="millivolt"/>
    <variable name="alpha_dL" units="per_second"/>
    <variable name="bdVm" units="millivolt"/>
    <variable name="beta_dL" units="per_second"/>
    <variable name="dL" initial_value="dL_init" public_interface="out" units="dimensionless"/>
    <variable name="dL_infinity" units="dimensionless"/>
    <variable name="tau_dL" units="second"/>
    <variable name="fL" initial_value="fL_init" public_interface="out" units="dimensionless"/>
    <variable name="fL_infinity" units="dimensionless"/>
    <variable name="tau_fL" units="second"/>
    <variable name="fCa" initial_value="fCa_init" public_interface="out" units="dimensionless"/>
    <variable name="fCa_infinity" units="dimensionless"/>
    <variable name="tau_fCa" units="second"/>
    <variable name="i_CaT" units="nanoA"/>
    <variable name="dT" initial_value="dT_init" public_interface="out" units="dimensionless"/>
    <variable name="dT_infinity" units="dimensionless"/>
    <variable name="tau_dT" units="second"/>
    <variable name="fT" initial_value="fT_init" public_interface="out" units="dimensionless"/>
    <variable name="fT_infinity" units="dimensionless"/>
    <variable name="tau_fT" units="second"/>
    <variable name="I" initial_value="I_init" public_interface="out" units="dimensionless"/>
    <variable name="O" initial_value="O_init" public_interface="out" units="dimensionless"/>
    <variable name="R_Ca_SR_release" initial_value="R_Ca_SR_release_init" public_interface="out" units="dimensionless"/>
    <variable name="RI" initial_value="RI_init" public_interface="out" units="dimensionless"/>
    <variable name="j_SRCarel" units="millimolar_per_second"/>
    <variable name="kCaSR" units="dimensionless"/>
    <variable name="kiSRCa" units="per_millimolar_second"/>
    <variable name="koSRCa" units="per_millimolar2_second"/>
    <variable name="P_up" units="millimolar_per_second"/>
    <variable name="b_up" units="dimensionless"/>
    <variable name="j_Ca_dif" units="millimolar_per_second"/>
    <variable name="j_tr" units="millimolar_per_second"/>
    <variable name="j_up" units="millimolar_per_second"/>
    <variable name="delta_fCMi" units="per_second"/>
    <variable name="delta_fCMs" units="per_second"/>
    <variable name="delta_fCQ" units="per_second"/>
    <variable name="delta_fTC" units="per_second"/>
    <variable name="delta_fTMC" units="per_second"/>
    <variable name="delta_fTMM" units="per_second"/>
    <variable name="fCMi" initial_value="fCMi_init" public_interface="out" units="dimensionless"/>
    <variable name="fCMs" initial_value="fCMs_init" public_interface="out" units="dimensionless"/>
    <variable name="fCQ" initial_value="fCQ_init" public_interface="out" units="dimensionless"/>
    <variable name="fTC" initial_value="fTC_init" public_interface="out" units="dimensionless"/>
    <variable name="fTMC" initial_value="fTMC_init" public_interface="out" units="dimensionless"/>
    <variable name="fTMM" initial_value="fTMM_init" public_interface="out" units="dimensionless"/>
    <variable name="BAPTA" units="millimolar"/>
    <variable name="Ca_jsr" initial_value="Ca_jsr_init" public_interface="out" units="millimolar"/>
    <variable name="Ca_nsr" initial_value="Ca_nsr_init" public_interface="out" units="millimolar"/>
    <variable name="Ca_sub" initial_value="Ca_sub_init" public_interface="out" units="millimolar"/>
    <variable name="Cai" initial_value="Cai_init" public_interface="out" units="millimolar"/>
    <variable name="fBAPTA" initial_value="fBAPTA_init" public_interface="out" units="millimolar"/>
    <variable name="fBAPTA_sub" initial_value="fBAPTA_sub_init" public_interface="out" units="millimolar"/>
    <variable name="V_cell" units="millimetre3"/>
    <variable name="V_i" units="millimetre3"/>
    <variable name="V_jsr" units="millimetre3"/>
    <variable name="V_nsr" units="millimetre3"/>
    <variable name="V_sub" units="millimetre3"/>
    <variable name="i_to" units="nanoA"/>
    <variable name="q" initial_value="q_init" public_interface="out" units="dimensionless"/>
    <variable name="q_infinity" units="dimensionless"/>
    <variable name="tau_q" units="second"/>
    <variable name="r" initial_value="r_init" public_interface="out" units="dimensionless"/>
    <variable name="r_infinity" units="dimensionless"/>
    <variable name="tau_r" units="second"/>
    <variable name="i_Kr" units="nanoA"/>
    <variable name="alfapaF" units="per_second"/>
    <variable name="betapaF" units="per_second"/>
    <variable name="paF" initial_value="paF_init" public_interface="out" units="dimensionless"/>
    <variable name="paS" initial_value="paS_init" public_interface="out" units="dimensionless"/>
    <variable name="pa_infinity" units="dimensionless"/>
    <variable name="tau_paF" units="second"/>
    <variable name="tau_paS" units="second"/>
    <variable name="pi_infinity" units="dimensionless"/>
    <variable name="piy" initial_value="piy_init" public_interface="out" units="dimensionless"/>
    <variable name="tau_pi" units="second"/>
    <variable name="E_Ks" units="millivolt"/>
    <variable name="g_Ks" units="microS"/>
    <variable name="i_Ks" units="nanoA"/>
    <variable name="Iso_shift_i_Ks_n_gate" units="millivolt"/>
    <variable name="alpha_n" units="per_second"/>
    <variable name="beta_n" units="per_second"/>
    <variable name="n" initial_value="n_init" public_interface="out" units="dimensionless"/>
    <variable name="n_infinity" units="dimensionless"/>
    <variable name="tau_n" units="second"/>
    <variable name="i_KACh" units="nanoA"/>
    <variable name="a" initial_value="a_init" public_interface="out" units="dimensionless"/>
    <variable name="a_infinity" units="dimensionless"/>
    <variable name="alpha_a" units="per_second"/>
    <variable name="beta_a" units="per_second"/>
    <variable name="tau_a" units="second"/>
    <!-- from PMR e/139 component Membrane -->
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>i_tot</ci>
        <apply>
          <plus/>
          <ci>i_f</ci>
          <ci>i_Kr</ci>
          <ci>i_Ks</ci>
          <ci>i_to</ci>
          <ci>i_NaK</ci>
          <ci>i_NaCa</ci>
          <ci>i_Na</ci>
          <ci>i_CaL</ci>
          <ci>i_CaT</ci>
          <ci>i_KACh</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>V_ode</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>i_tot</ci>
          </apply>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>RTONF</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>R</ci>
            <ci>T</ci>
          </apply>
          <ci>F</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>V</ci>
        <piecewise>
          <piece>
            <ci>V_clamp</ci>
            <apply>
              <geq/>
              <ci>clamp_mode</ci>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>V_ode</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <!-- from PMR e/139 component Voltage_clamp -->
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>V_clamp</ci>
        <piecewise>
          <piece>
            <ci>V_test</ci>
            <apply>
              <and/>
              <apply>
                <gt/>
                <ci>t</ci>
                <ci>t_holding</ci>
              </apply>
              <apply>
                <lt/>
                <ci>t</ci>
                <apply>
                  <plus/>
                  <ci>t_holding</ci>
                  <ci>t_test</ci>
                </apply>
              </apply>
            </apply>
          </piece>
          <otherwise>
            <ci>V_holding</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <!-- from PMR e/139 component Ionic_values -->
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>E_Na</ci>
        <apply>
          <times/>
          <ci>RTONF</ci>
          <apply>
            <ln/>
            <apply>
              <divide/>
              <ci>Nao</ci>
              <ci>Nai</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>E_K</ci>
        <apply>
          <times/>
          <ci>RTONF</ci>
          <apply>
            <ln/>
            <apply>
              <divide/>
              <ci>Ko</ci>
              <ci>Ki</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>E_Ca</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">0.5</cn>
          <ci>RTONF</ci>
          <apply>
            <ln/>
            <apply>
              <divide/>
              <ci>Cao</ci>
              <ci>Ca_sub</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <!-- from PMR e/139 component Nai_concentration -->
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Nai_</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="mA_nA">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>i_Na</ci>
              <ci>i_fNa</ci>
              <ci>i_siNa</ci>
              <apply>
                <times/>
                <cn xmlns:ns1="http://www.cellml.org/cellml/1.1#" ns1:units="dimensionless">3</cn>
                <ci>i_NaK</ci>
              </apply>
              <apply>
                <times/>
                <cn xmlns:ns2="http://www.cellml.org/cellml/1.1#" ns2:units="dimensionless">3</cn>
                <ci>i_NaCa</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <times/>
            <cn xmlns:ns3="http://www.cellml.org/cellml/1.1#" ns3:units="litre_millimetre3">1</cn>
            <apply>
              <plus/>
              <ci>V_i</ci>
              <ci>V_sub</ci>
            </apply>
            <ci>F</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Nai</ci>
        <piecewise>
          <piece>
            <cn xmlns:ns4="http://www.cellml.org/cellml/1.1#" ns4:units="millimolar">7.5</cn>
            <apply>
              <gt/>
              <ci>BAPTA_10_mM</ci>
              <cn xmlns:ns5="http://www.cellml.org/cellml/1.1#" ns5:units="dimensionless">0</cn>
            </apply>
          </piece>
          <otherwise>
            <ci>Nai_</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <!-- from PMR e/139 component i_f -->
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>g_f_Na</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <cn cellml:units="microS">0.03</cn>
              <apply>
                <minus/>
                <cn xmlns:ns1="http://www.cellml.org/cellml/1.1#" ns1:units="dimensionless">1</cn>
                <cn xmlns:ns2="http://www.cellml.org/cellml/1.1#" ns2:units="dimensionless">0.66</cn>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>Iva_3_uM</ci>
              <cn xmlns:ns3="http://www.cellml.org/cellml/1.1#" ns3:units="dimensionless">1</cn>
            </apply>
          </piece>
          <otherwise>
            <cn xmlns:ns4="http://www.cellml.org/cellml/1.1#" ns4:units="microS">0.03</cn>
          </otherwise>
