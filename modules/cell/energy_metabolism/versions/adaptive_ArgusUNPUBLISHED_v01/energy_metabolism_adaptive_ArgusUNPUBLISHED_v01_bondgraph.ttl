    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_MOB" ; bgf:hasValue "1.574266327074785e-19 mol/s"^^cdt:ucum ] .

:Re_MX
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_MX" ; bgf:hasValue "1.279080856342665e-18 mol/s"^^cdt:ucum ] .

:q_glc.Re_HK bgf:hasSource :q_glc ; bgf:hasTarget :Re_HK .
