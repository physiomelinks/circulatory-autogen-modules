:q_Pi
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.283185307179586e-17 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "9.288808692130524e+11 mol-1"^^cdt:ucum ] .

:q_glyc  # activity C k_sat / (k_sat + C), k_sat 10 mM: linear here, at the export point
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "3.141592653589793e-16 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1.650081038149820e+19 mol-1"^^cdt:ucum ] .

:q_mx  # a chemostat of the module (held by its port), here a store
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.283185307179586e-18 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "9.900486228898952e+17 mol-1"^^cdt:ucum ] .

:Re_HK
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_HK" ; bgf:hasValue "2.387758141583535e-13 mol/s"^^cdt:ucum ] .

:Re_LG
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_LG" ; bgf:hasValue "1.115762979324902e+07 mol/s"^^cdt:ucum ] .

:Re_HYD
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_HYD" ; bgf:hasValue "1.032019716948043e-18 mol/s"^^cdt:ucum ] .

:Re_STORE
    a bgf:ChemicalReactionNode ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasSymbol "kappa_STORE" ; bgf:hasValue "3.425585022139600e-18 mol/s"^^cdt:ucum ] .

:Re_MOB
