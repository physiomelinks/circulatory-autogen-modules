@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix tpl: <https://bg-rdf.org/templates/> .

@prefix : <#> .

# Lumped cytosol (energy_metabolism adaptive): written by tools/bondgraph.py from the module's description (circulatory-autogen-modules)
# T = 293.15 K; volume 6.28319e-18 m3; stores q = C V, K = exp(mu0/RT) / (c_std V)

:energy_metabolism_adaptive
    a bgf:BondgraphModel ;
    bgf:usesTemplate tpl:chemical.ttl ;
    bgf:hasBondElement :q_glc, :q_G6P, :q_lac, :q_ATP, :q_ADP, :q_Pi, :q_glyc, :q_mx, :Re_HK, :Re_LG, :Re_HYD, :Re_STORE, :Re_MOB, :Re_MX .

:q_glc
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "1.256637061435917e-20 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "4.074161339853868e+14 mol-1"^^cdt:ucum ] .

:q_G6P
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "6.283185307179586e-18 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "6.842363448957599e+14 mol-1"^^cdt:ucum ] .

:q_lac
    a bgf:ChemicalStorageNode ;
    bgf:hasValue "1.695851609969200e-18 mol"^^cdt:ucum ;
