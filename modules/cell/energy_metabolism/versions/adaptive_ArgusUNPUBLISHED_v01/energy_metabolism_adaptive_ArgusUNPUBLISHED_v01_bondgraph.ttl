:q_Pi.Re_MOB bgf:hasSource :q_Pi ; bgf:hasTarget :Re_MOB .
:Re_MOB.q_G6P bgf:hasSource :Re_MOB ; bgf:hasTarget :q_G6P .
:q_G6P.Re_MX bgf:hasSource :q_G6P ; bgf:hasTarget :Re_MX .
