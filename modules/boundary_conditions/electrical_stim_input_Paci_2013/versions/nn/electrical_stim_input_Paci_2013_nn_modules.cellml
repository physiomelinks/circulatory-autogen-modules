<?xml version='1.0' encoding='UTF-8'?>
<model name="electrical_stim_input_Paci_2013_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="stim_mode_Paci_2013">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="Cm" public_interface="in" units="farad"/>
        <variable name="stim_flag" public_interface="in" units="dimensionless"/>
        <variable name="i_stim" public_interface="out" units="A_per_F"/>
        <variable name="i_stim_start" public_interface="in" units="second"/>
        <variable name="i_stim_end" public_interface="in" units="second"/>
        <variable name="i_stim_amplitude" public_interface="in" units="ampere"/>
        <variable name="i_stim_frequency" public_interface="in" units="per_s"/>
        <variable name="i_stim_period" public_interface="out" units="second"/>
        <variable name="i_stim_pulse_duration" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i_stim_period</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <ci>i_stim_frequency</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>i_stim</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>stim_flag</ci>
                                <ci>i_stim_amplitude</ci>
                            </apply>
                            <ci>Cm</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>t</ci>
                                <ci>i_stim_start</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>t</ci>
                                <ci>i_stim_end</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <ci>t</ci>
                                        <ci>i_stim_start</ci>
                                    </apply>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <floor/>
                                            <apply>
                                                <divide/>
                                                <apply>
                                                    <minus/>
                                                    <ci>t</ci>
                                                    <ci>i_stim_start</ci>
                                                </apply>
                                                <ci>i_stim_period</ci>
                                            </apply>
                                        </apply>
                                        <ci>i_stim_period</ci>
                                    </apply>
                                </apply>
                                <ci>i_stim_pulse_duration</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="A_per_F">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
</model>
