{
  "module_type": "voltage_change",
  "version": "ArgusUNPUBLISHED_v01",
  "sim_time": 3.0,
  "pre_time": 0.0,
  "dt": 0.001,
  "solver": "CVODE_myokit",
  "outputs": ["Vm"],
  "invariants": [
    {
      "description": "Vm is the exact ramp -0.08 V + 0.01 V/s t",
      "expr": "np.max(np.abs(Vm - (-0.08 + 0.01*t))) <= 1e-12"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {}
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.004, 0.002, 0.001, 0.0005],
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "prescribed voltage ramp (test input); verified against its exact analytic form"
      },
      "calibrate": {
        "note": "not_applicable: prescribed voltage ramp (test input); verified against its exact analytic form"
      }
    }
  }
}
