<?xml version='1.0' encoding='UTF-8'?>
<model name="i_stim_periodic_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="i_stim_periodic">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="stim_flag" public_interface="in" units="dimensionless"/>
        <variable name="i" public_interface="out" units="nanoA"/>
        <variable name="t_start" public_interface="in" units="second"/>
        <variable name="t_end" public_interface="in" units="second"/>
        <variable name="i_amplitude" public_interface="in" units="nanoA"/>
        <variable name="period" public_interface="in" units="second"/>
        <variable name="pulse_duration" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>i</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <ci>stim_flag</ci>
                            </apply>
                            <ci>i_amplitude</ci>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>t</ci>
                                <ci>t_start</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>t</ci>
                                <ci>t_end</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <ci>t</ci>
                                        <ci>t_start</ci>
                                    </apply>
                                    <apply>
                                        <times/>
                                        <apply>
                                            <floor/>
                                            <apply>
                                                <divide/>
                                                <apply>
                                                    <minus/>
                                                    <ci>t</ci>
                                                    <ci>t_start</ci>
                                                </apply>
                                                <ci>period</ci>
                                            </apply>
                                        </apply>
                                        <ci>period</ci>
                                    </apply>
                                </apply>
                                <ci>pulse_duration</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="nanoA">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
    </component>
</model>
