{
  "module_type": "muscle_pressure",
  "version": "cosine_EllweinFix2018_v01",
  "sim_time": 20.0,
  "pre_time": 0.0,
  "dt": 0.01,
  "solver": "CVODE_myokit",
  "solver_info": {
    "MaximumStep": 0.001,
    "rtol": 1e-08,
    "atol": 1e-10
  },
  "outputs": [
    "c",
    "s",
    "P_mus"
  ],
  "invariants": [
    {
      "description": "exact oscillator: c = cos(2 pi f t), s = sin(2 pi f t) from phase 0",
      "expr": "(c_init != 1) | (s_init != 0) | (np.max(np.abs(c - np.cos(2*np.pi*f*t))) + np.max(np.abs(s - np.sin(2*np.pi*f*t))) <= 1e-5)"
    },
    {
      "description": "P_mus = -A (1 - c)/2 and between -A and 0",
      "expr": "(np.max(np.abs(P_mus + A*(1 - c)/2)) <= 1e-9*abs(A) + 1e-12) & (np.min(P_mus) >= -abs(A)*(1 + 1e-5)) & (np.max(P_mus) <= abs(A)*1e-5)"
    }
  ],
  "bc_sweep": {
    "factors": [
      0.5,
      0.75,
      1.0,
      1.5,
      2.0
    ],
    "ranges": {
      "f": {
        "min": 0.1,
        "max": 1.0,
        "points": 5
      },
      "A": {
        "min": 100.0,
        "max": 2000.0,
        "points": 5
      },
      "c_init": {
        "values": [
          1.0
        ]
      },
      "s_init": {
        "values": [
          0.0
        ]
      }
    },
    "rationale": "6-60 breaths/min; peak muscle pressure 1-20 cmH2O. The initial phase stays on the unit circle."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [
      0.004,
      0.002,
      0.001,
      0.0005
    ],
    "t_end": 10.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
        "atol": 1e-08
      }
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "pending",
        "reason": "no data: a synthetic module of the known-structure test model (ICUHealthy models/simple)"
      },
      "calibrate": {
        "note": "not_applicable: no data to calibrate against"
      }
    }
  }
}
