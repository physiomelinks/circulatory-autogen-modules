<?xml version='1.0' encoding='UTF-8'?>
<model name="CO2_O2_generator_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="CO2_O2_generator_type">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="C_CO2_multiplier" public_interface="in" units="dim"/>
        <variable name="t_start_C_CO2" public_interface="in" units="second"/>
        <variable name="t_end_C_CO2" public_interface="in" units="second"/>
        <variable name="C_O2_multiplier" public_interface="in" units="dim"/>
        <variable name="t_start_C_O2" public_interface="in" units="second"/>
        <variable name="t_end_C_O2" public_interface="in" units="second"/>
        <variable name="C_CO2_a0" public_interface="in" units="dimensionless"/>
        <variable name="C_O2_a0" public_interface="in" units="dimensionless"/>
        <variable name="C_O2_a" public_interface="out" units="dimensionless"/>
        <variable name="C_CO2_a" public_interface="out" units="dimensionless"/>
        <variable name="dot_C_CO2_a" public_interface="out" units="per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C_O2_a</ci>
                <piecewise>
                    <piece>
                        <ci>C_O2_a0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_C_O2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_C_O2</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>C_O2_a0</ci>
                            <ci>C_O2_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C_CO2_a</ci>
                <piecewise>
                    <piece>
                        <ci>C_CO2_a0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_C_CO2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_C_CO2</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>C_CO2_a0</ci>
                            <ci>C_CO2_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>dot_C_CO2_a</ci>
                <cn cellml:units="per_s">0</cn>
            </apply>
        </math>
    </component>
</model>
