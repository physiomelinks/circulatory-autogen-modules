{
  "module_type": "inlet_flow",
  "version": "adan_2",
  "sim_time": 2.0,
  "pre_time": 0.0,
  "dt": 0.005,
  "solver": "CVODE_myokit",
  "outputs": ["v"],
  "invariants": [
    {
      "description": "v equals the linear interpolation of the knot table at t_loc = t mod T (hits every knot value)",
      "expr": "np.max(np.abs(v - np.interp(np.mod(t, T), np.array([0.0, 0.02193, 0.041305, 0.06068, 0.080055, 0.09943, 0.118805, 0.128492, 0.13818, 0.157555, 0.17693, 0.196305, 0.244742, 0.322242, 0.351305, 0.390055, 0.415117, 0.437555, 0.48693, 0.515992, 0.583805, 1.0]), np.array([0.0, 0.0, 0.000105089, 0.00027323, 0.000404592, 0.000535952, 0.000567479, 0.000572734, 0.000567479, 0.000535952, 0.000488663, 0.000451882, 0.000315266, 0.000178651, 0.000136615, 0.0, -0.000162888, -2.10178e-05, 0.0, 5.25444e-06, 0.0, 0.0])))) <= 1e-9*max(1e-12, np.max(np.abs(v)))"
    },
    {
      "description": "v stays within the knot-value range [min q_k, max q_k] (linear interpolation cannot overshoot)",
      "expr": "(np.min(v) >= -0.000162888 - 1e-12) & (np.max(v) <= 0.000572734 + 1e-12)"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "T": {"min": 0.5, "max": 1.0, "points": 3},
      "P": {"min": 0, "max": 20000, "points": 3}
    },
    "rationale": "The knot times end at 1.0 s, so only T <= 1 s is a valid region (T < 1 s truncates the waveform); P is unused by the equations."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.004, 0.002, 0.001, 0.0005],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "calibrate": {"note": "not_applicable: prescribed input waveform (data table); nothing to identify"}
    },
    "boileau2015_adan56_inflow": {
      "baseline": {
        "status": "proposed",
        "source": "Boileau et al. (2015) Int J Numer Method Biomed Eng 31(10):e02732, benchmark inflow waveforms (supplementary material, as redistributed in openBF models/boileau2015), ADAN56 aortic-root inflow",
        "source_short": "Boileau2015 ADAN56 inflow",
        "data": "instances/boileau2015_adan56_inflow/boileau2015_adan56_inflow.csv",
        "time_column": "t",
        "time_offset": 0,
        "variables": {"v": "Q"},
        "parameters": {"T": 1.0},
        "sim_time": 1.0,
        "dt": 0.001,
        "metric": "nrmse",
        "threshold": 0.01
      }
    }
  }
}
