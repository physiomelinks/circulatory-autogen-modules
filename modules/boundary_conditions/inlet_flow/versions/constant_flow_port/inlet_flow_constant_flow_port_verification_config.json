{
  "module_type": "inlet_flow",
  "version": "constant_flow_port",
  "sim_time": 2.0,
  "pre_time": 0.0,
  "dt": 0.001,
  "solver": "CVODE_myokit",
  "solver_info": {"rtol": 1e-08, "atol": 1e-12},
  "outputs": ["v"],
  "invariants": [
    {"description": "the flow is the constant v", "expr": "np.all(v == v[0])"}
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "v": {"min": 0.0, "max": 1e-07, "points": 5}
    },
    "exclude": ["P"],
    "rationale": "flows 0-1e-7 m^3/s span the microvasculature operating points; P is unused"
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.004, 0.002, 0.001, 0.0005],
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {"status": "not_applicable", "reason": "test fixture (a constant boundary flow)"},
      "calibrate": {"note": "not_applicable: test fixture"}
    }
  }
}
