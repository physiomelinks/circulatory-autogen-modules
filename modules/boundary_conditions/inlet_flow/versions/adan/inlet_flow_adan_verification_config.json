    {
      "description": "periodic: v(t + T) = v(t) (run point; index shift needs T/dt integral)",
      "expr": "np.max(np.abs(v[np.rint(T/(t[1] - t[0])).astype(np.int64):] - v[:len(v) - np.rint(T/(t[1] - t[0])).astype(np.int64)])) <= 1e-9*np.max(np.abs(v))",
      "applies": "run"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "T": {"min": 0.5, "max": 2.0, "points": 4},
