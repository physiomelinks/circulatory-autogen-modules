{
  "module_type": "efferent_respiratory_effector",
  "version": "GeeArgus2026_v01",
  "sim_time": 400.0,
  "pre_time": 0.0,
  "dt": 0.5,
  "solver": "CVODE_myokit",
  "outputs": [
    "tau_pA",
    "tau_pf",
    "G_cA",
    "G_cf",
    "tau_cA",
    "tau_cf",
    "Delta_RR_c",
    "Delta_RR_p",
    "alpha_P_mus_c",
    "alpha_P_mus_p",
    "Delta_RR_resp",
    "alpha_P_mus"
  ],
  "invariants": [
    {
      "description": "Delta_RR_c = G_cf u_c_resp (1 - exp(-t/tau_cf))",
      "expr": "np.max(np.abs(Delta_RR_c - G_cf*u_c_resp*(1 - np.exp(-t/tau_cf)))) <= 1e-4*max(1e-6, np.max(np.abs(G_cf*u_c_resp))) + 1e-9"
    },
    {
      "description": "Delta_RR_p = G_pf u_p_resp (1 - exp(-t/tau_pf))",
      "expr": "np.max(np.abs(Delta_RR_p - G_pf*u_p_resp*(1 - np.exp(-t/tau_pf)))) <= 1e-4*max(1e-6, np.max(np.abs(G_pf*u_p_resp))) + 1e-9"
    },
    {
      "description": "alpha_P_mus_c = 1 + G_cA u_c_resp (1 - exp(-t/tau_cA)) (starts at 1)",
      "expr": "np.max(np.abs(alpha_P_mus_c - (1 + G_cA*u_c_resp*(1 - np.exp(-t/tau_cA))))) <= 1e-4*max(1.0, np.max(np.abs(G_cA*u_c_resp)))"
    },
    {
      "description": "alpha_P_mus_p = 1 + G_pA u_p_resp (1 - exp(-t/tau_pA))",
      "expr": "np.max(np.abs(alpha_P_mus_p - (1 + G_pA*u_p_resp*(1 - np.exp(-t/tau_pA))))) <= 1e-4*max(1.0, np.max(np.abs(G_pA*u_p_resp)))"
    },
    {
      "description": "outputs are the clamped sum / product",
      "expr": "(np.max(np.abs(Delta_RR_resp - np.clip(Delta_RR_c + Delta_RR_p, Delta_RR_resp_min, Delta_RR_resp_max))) <= 1e-12) & (np.max(np.abs(alpha_P_mus - np.clip(alpha_P_mus_c*alpha_P_mus_p, alpha_P_mus_min, alpha_P_mus_max))) <= 1e-12)"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "u_c_resp": {"min": -200.0, "max": 1000.0, "points": 7},
      "u_p_resp": {"min": -5.0, "max": 15.0, "points": 5},
      "u_CO2_c_thresh": {"min": 0.0, "max": 100.0, "points": 3}
    },
    "rationale": "u_c_resp = K_c_resp (PaCO2 - PaCO2_nom) with K_c_resp = 1 is numerically the PCO2 excess in Pa: -200 to +1000 Pa (-1.5 to +7.5 mmHg); u_p_resp spans chemoreceptor firing -5..+15 spikes/s about f_apc_nom."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.4, 0.2, 0.1, 0.05],
    "t_end": 200.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "pending",
        "reason": "Candidate: ventilatory (rate and effort) response to a hypercapnic step; needs the respiratory network and real parameter values first."
      },
      "calibrate": {"note": "pending: see baseline"}
    }
  }
}
