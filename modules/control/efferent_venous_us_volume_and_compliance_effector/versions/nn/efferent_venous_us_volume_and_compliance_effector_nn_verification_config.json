{
  "module_type": "efferent_venous_us_volume_and_compliance_effector",
  "version": "nn",
  "sim_time": 100.0,
  "pre_time": 0.0,
  "dt": 0.1,
  "solver": "CVODE_myokit",
  "outputs": ["Delta_theta_us", "sigma_theta_us", "Delta_theta_compliance", "sigma_theta_compliance"],
  "invariants": [
    {
      "description": "sigma_theta_us exact first-order solution",
      "expr": "np.max(np.abs(sigma_theta_us - max(f_s - f_es_min, 0)*(1 - np.exp(-t/tau_theta_us)))) <= 1e-4*max(1e-6, abs(f_s - f_es_min))"
    },
    {
      "description": "sigma_theta_compliance exact first-order solution",
      "expr": "np.max(np.abs(sigma_theta_compliance - max(f_s - f_es_min, 0)*(1 - np.exp(-t/tau_theta_compliance)))) <= 1e-4*max(1e-6, abs(f_s - f_es_min))"
    },
    {
      "description": "Delta_theta_compliance = G_theta_compliance sigma/(f_es_mid + sigma)",
      "expr": "np.max(np.abs(Delta_theta_compliance - G_theta_compliance*sigma_theta_compliance/(f_es_mid + sigma_theta_compliance))) <= 1e-9*max(1.0, abs(G_theta_compliance))"
    },
    {
      "description": "Delta_theta_us = G_theta_us sigma_us/(f_es_mid + sigma_us) (intended law; fails when G_theta_us differs from G_theta_compliance)",
      "expr": "np.max(np.abs(Delta_theta_us - G_theta_us*sigma_theta_us/(f_es_mid + sigma_theta_us))) <= 1e-9*max(1.0, abs(G_theta_us))"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "f_s": {"min": 0.0, "max": 60.0, "points": 7}
    },
    "rationale": "f_s from silent to f_es_max; gains and time constants 0.5-2x."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.2, 0.1, 0.05, 0.025],
    "t_end": 100.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "effector transfer block with placeholder gains; exact solution checked."
      },
      "calibrate": {"note": "not_applicable: see baseline"}
    }
  }
}
