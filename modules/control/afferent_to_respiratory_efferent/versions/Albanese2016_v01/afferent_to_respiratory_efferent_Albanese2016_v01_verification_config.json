{
  "module_type": "afferent_to_respiratory_efferent",
  "version": "Albanese2016_v01",
  "sim_time": 1.0,
  "pre_time": 0.0,
  "dt": 0.1,
  "solver": "CVODE_myokit",
  "outputs": ["u_c_resp", "u_p_resp"],
  "run_parameters": {"P_CO2_a": 6000.0, "f_apc": 5.0},
  "invariants": [
    {
      "description": "u_c_resp = K_c_resp (P_CO2_a - P_CO2_a_nom)",
      "expr": "np.max(np.abs(u_c_resp - K_c_resp*(P_CO2_a - P_CO2_a_nom))) <= 1e-9*max(1.0, abs(K_c_resp*P_CO2_a))"
    },
    {
      "description": "u_p_resp = K_p_resp (f_apc - f_apc_nom)",
      "expr": "np.max(np.abs(u_p_resp - K_p_resp*(f_apc - f_apc_nom))) <= 1e-9*max(1.0, abs(K_p_resp*f_apc))"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "P_CO2_a": {"min": 3333, "max": 9333, "points": 7},
      "P_O2_a": {"min": 4000, "max": 20000, "points": 3},
      "f_apc": {"min": 0.0, "max": 20.0, "points": 5}
    },
    "rationale": "PaCO2 25-70 mmHg (hyperventilation to marked hypercapnia); PaO2 30-150 mmHg (unused, checked for finiteness); f_apc over the chemoreceptor output range."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.04, 0.02, 0.01, 0.005],
    "t_end": 40.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "linear signal-conditioning block with placeholder gains; verified against its exact law. Ventilatory CO2/O2 response data belong to the respiratory network that uses it."
      },
      "calibrate": {"note": "not_applicable: see baseline"}
    }
  }
}
