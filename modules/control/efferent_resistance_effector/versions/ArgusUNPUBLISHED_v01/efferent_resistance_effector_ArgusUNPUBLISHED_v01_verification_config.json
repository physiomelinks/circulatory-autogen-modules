{
  "module_type": "efferent_resistance_effector",
  "version": "ArgusUNPUBLISHED_v01",
  "sim_time": 40.0,
  "pre_time": 0.0,
  "dt": 0.05,
  "solver": "CVODE_myokit",
  "outputs": ["Delta_theta", "sigma_theta"],
  "invariants": [
    {
      "description": "sigma_theta matches max(f_s - f_es_min, 0) (1 - exp(-t/tau_theta))",
      "expr": "np.max(np.abs(sigma_theta - max(f_s - f_es_min, 0)*(1 - np.exp(-t/tau_theta)))) <= 1e-4*max(1e-6, abs(f_s - f_es_min))"
    },
    {
      "description": "Delta_theta = G_theta sigma/(f_es_mid + sigma)",
      "expr": "np.max(np.abs(Delta_theta - G_theta*sigma_theta/(f_es_mid + sigma_theta))) <= 1e-9*max(1.0, abs(G_theta))"
    },
    {
      "description": "Delta_theta stays within [0, G_theta) (for G_theta >= 0)",
      "expr": "(G_theta < 0) or ((np.min(Delta_theta) >= -1e-12) & (np.max(Delta_theta) < G_theta + 1e-12))"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "f_s": {"min": 0.0, "max": 60.0, "points": 7}
    },
    "rationale": "f_s from silent to f_es_max (60 spikes/s); gains/time constants 0.5-2x."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.04, 0.02, 0.01, 0.005],
    "t_end": 40.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "effector transfer block with placeholder gain; verified against its exact solution; validation of vascular resistance responses belongs to a closed-loop network."
      },
      "calibrate": {"note": "not_applicable: see baseline"}
    }
  }
}
