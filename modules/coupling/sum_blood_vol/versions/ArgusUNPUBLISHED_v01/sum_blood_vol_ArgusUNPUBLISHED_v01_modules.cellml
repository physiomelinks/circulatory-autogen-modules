<?xml version='1.0' encoding='UTF-8'?>
<model name="sum_blood_vol_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="sum_blood_vol_type">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="q" public_interface="out" units="litre"/>
        <!-- boundary conditions-->
        <variable name="q_sum" public_interface="in" units="litre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q</ci>
                <ci>q_sum</ci>
            </apply>
        </math>
    </component>
</model>
