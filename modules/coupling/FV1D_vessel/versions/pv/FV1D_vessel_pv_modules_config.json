[
  {
    "module_type": "FV1D_vessel",
    "module_subtype": "pv",
    "module_format": "external_api",
    "component_file": "FV1D_vessel_pv_modules.cellml",
    "component_type": "Muller_1d__FV1D_vessel_pv",
    "default_instance": "default",
    "licence": "CC0-1.0",
    "creator": [],
    "api": {
      "name": "FV_1d_pipe",
      "description": "0D-1D coupling to the FV 1D solver (libcuflynx/solver1d) through the coupler (libcuflynx/coupler) over named pipes. Every 0D right-hand-side evaluation exchanges one message per connection.",
      "role": "consumer",
      "transport": "named_pipe",
      "exchange": "per_rhs",
      "message_length": 2,
      "channels": {
        "dt": {
          "send": "zero_to_parent_dt",
          "recv": "parent_to_zero_dt"
        },
        "conn": {
          "send": "zero_to_parent_{i}",
          "recv": "parent_to_zero_{i}",
          "indexed_by": "connection"
        },
        "volume": {
          "recv": "parent_to_zero_vol"
        }
      },
      "calls": [
        {
          "name": "sync_step",
          "kind": "send_recv",
          "when": "step_start",
          "channel": "dt",
          "send": [
            "$voi",
            "$dt"
          ],
          "recv": [
            "$ignore",
            "$dt"
          ]
        },
        {
          "name": "sync_time",
          "kind": "send",
          "when": "rhs_start",
          "channel": "dt",
          "send": [
            "$voi",
            "$dt_stage"
          ]
        },
        {
          "name": "bc_exchange",
          "kind": "send_recv",
          "when": "rhs",
          "channel": "conn",
          "per": "connection",
          "send_by_input": {
            "flow": [
              "port.pressure",
              "control.FV_resistance_port|0"
            ],
            "pressure": [
              "port.flow",
              0.0
            ]
          },
          "recv": [
            "port.input"
          ]
        },
        {
          "name": "step_done",
          "kind": "send_recv",
          "when": "step_end",
          "channel": "dt",
          "send": [
            "$voi",
            -999.0
          ],
          "recv": [
            "$ignore",
            "$ignore"
          ]
        }
      ]
    },
    "entrance_ports": [
      {
        "port_type": "vessel_port",
        "variables": [
          "",
          ""
        ]
      }
    ],
    "exit_ports": [
      {
        "port_type": "vessel_port",
        "variables": [
          "",
          ""
        ]
      }
    ],
    "general_ports": [],
    "variables_and_units": []
  }
]
