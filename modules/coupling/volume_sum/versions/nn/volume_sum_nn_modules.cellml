<?xml version='1.0' encoding='UTF-8'?>
<model name="volume_sum_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="volume_sum">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="q" public_interface="in" units="m3"/>
        <!-- the total, as an output so another component can use it (an input can't be passed on) -->
        <variable name="q_sum" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_sum</ci>
                <ci>q</ci>
            </apply>
        </math>
    </component>
</model>
