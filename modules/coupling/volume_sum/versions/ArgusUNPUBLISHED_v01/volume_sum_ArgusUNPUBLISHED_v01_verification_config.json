{
  "module_type": "volume_sum",
  "version": "ArgusUNPUBLISHED_v01",
  "sim_time": 2.0,
  "pre_time": 0.0,
  "dt": 0.001,
  "solver": "CVODE_myokit",
  "outputs": ["q_sum", "multiport_sum_mod_q/q", "va/q", "vb/q", "va/v", "vb/v", "flow_out_a/v", "flow_out_b/v"],
  "harness": {
    "module_array": [
      ["p_in_a", "constant", "inlet_pressure", "", "va", "default"],
      ["va", "pv", "arterial_simple", "p_in_a", "flow_out_a mod", "default"],
      ["flow_out_a", "constant", "outlet_flow", "va", "", "default"],
      ["p_in_b", "constant", "inlet_pressure", "", "vb", "default"],
      ["vb", "pv", "arterial_simple", "p_in_b", "flow_out_b mod", "default"],
      ["flow_out_b", "constant", "outlet_flow", "vb", "", "default"],
      ["mod", "ArgusUNPUBLISHED_v01", "volume_sum", "va vb", "", "default"]
    ],
    "parameters": [
      ["p_in_a/P", "J_per_m3", 2000, "harness test value"],
      ["flow_out_a/v", "m3_per_s", 0.0001, "harness test value"],
      ["va/R", "Js_per_m6", 10000000.0, "harness test value"],
      ["va/C", "m6_per_J", 1e-08, "harness test value"],
      ["va/I", "Js2_per_m6", 100000.0, "harness test value"],
      ["va/q_0", "m3", 0, "harness: zero unstressed volume"],
      ["va/u_0", "J_per_m3", 0, "harness: zero reference pressure"],
      ["va/u_ext", "J_per_m3", 0, "harness: zero external pressure"],
      ["p_in_b/P", "J_per_m3", 1500, "harness test value"],
      ["flow_out_b/v", "m3_per_s", 2e-05, "harness test value"],
      ["vb/R", "Js_per_m6", 10000000.0, "harness test value"],
      ["vb/C", "m6_per_J", 1e-08, "harness test value"],
      ["vb/I", "Js2_per_m6", 100000.0, "harness test value"],
      ["vb/q_0", "m3", 0, "harness: zero unstressed volume"],
      ["vb/u_0", "J_per_m3", 0, "harness: zero reference pressure"],
      ["vb/u_ext", "J_per_m3", 0, "harness: zero external pressure"]
    ]
  },
  "invariants": [
    {
      "description": "the output is exactly the sum of the connected vessels' volumes, Σq = q_va + q_vb",
      "expr": "np.max(np.abs(multiport_sum_mod_q__q - (va__q + vb__q))) <= 1e-12*max(1e-30, np.max(np.abs(multiport_sum_mod_q__q)))"
    },
    {
      "description": "q_sum, the total on the exit volume_port, equals the generated sum exactly",
      "expr": "np.max(np.abs(q_sum - multiport_sum_mod_q__q)) <= 1e-12*max(1e-30, np.max(np.abs(multiport_sum_mod_q__q)))"
    },
    {
      "description": "volume balance: Σq(t) − Σq(0) = ∫(inflows − outflows) dt over both vessels (trapezoidal, < 1e-3 of max Σq)",
      "expr": "np.max(np.abs((multiport_sum_mod_q__q - multiport_sum_mod_q__q[0]) - np.concatenate(([0.0], np.cumsum(0.5*((va__v + vb__v - flow_out_a__v - flow_out_b__v)[1:] + (va__v + vb__v - flow_out_a__v - flow_out_b__v)[:-1])*np.diff(t)))))) <= 1e-3*np.max(np.abs(multiport_sum_mod_q__q))"
    },
    {
      "description": "steady state: Σq → C_a (P_in,a − R v_out,a) + C_b (P_in,b − R v_out,b) = 1e-8 (2000 − 1000) + 1e-8 (1500 − 200) = 2.3e-5 m^3 (0.1%)",
      "expr": "abs(multiport_sum_mod_q__q[-1] - 2.3e-5) <= 2.3e-8"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {},
    "exclude": ["q"],
    "rationale": "Nothing of the component to sweep: q is supplied by the connected vessels (the sum is formed by libcuflynx). The harness vessels have different pressures and outflows so the summed volumes differ and change in time."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.004, 0.002, 0.001, 0.0005],
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {"status": "not_applicable", "reason": "bookkeeping component (sum of volumes); verified exactly."},
      "calibrate": {"note": "not_applicable: bookkeeping component; nothing to calibrate."}
    }
  }
}
