  "dt": 0.004,
  "solver": "CVODE_myokit",
  "solver_info": {
    "rtol": 1e-08,
    "atol": 1e-10
  },
  "outputs": [
    "V_lv",
    "V_a",
    "V_v",
    "c",
    "s",
    "P_lv",
    "P_a"
  ],
  "invariants": [
    {
      "description": "total volume conserved (V_lv + V_a + V_v constant to 1e-6 relative)",
      "expr": "np.ptp(V_lv + V_a + V_v) <= 1e-6 * np.max(V_lv + V_a + V_v)"
    },
    {
      "description": "the clock stays on the unit circle (|c^2 + s^2 - 1| < 1e-5)",
      "expr": "np.max(np.abs(c**2 + s**2 - 1)) < 1e-5",
      "applies": "abs(c_init**2 + s_init**2 - 1) < 1e-12"
    }
  ],
  "bc_sweep": {
    "factors": [
      0.5,
      1.0,
      1.5
    ],
    "ranges": {
      "u": {
        "min": -0.3,
        "max": 0.3,
        "points": 3
      }
    }
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [
      0.004,
      0.002,
      0.001,
      0.0005
    ],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
