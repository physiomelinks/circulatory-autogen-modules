{
  "module_type": "limit_cycle_oscillator",
  "version": "ArgusUNPUBLISHED_v01",
  "sim_time": 8.0,
  "pre_time": 0.0,
  "dt": 0.004,
  "solver": "CVODE_myokit",
  "solver_info": {
    "rtol": 1e-08,
    "atol": 1e-10
  },
  "outputs": [
    "x",
    "y",
    "z"
  ],
  "invariants": [
    {
      "description": "stays on the unit circle from a start on it (|x^2 + y^2 - 1| < 1e-4)",
      "expr": "np.max(np.abs(x**2 + y**2 - 1)) < 1e-4",
      "applies": "abs(x_init**2 + y_init**2 - 1) < 1e-12"
    },
    {
      "description": "z stays bounded (|z| < 2)",
      "expr": "np.max(np.abs(z)) < 2"
    }
  ],
  "bc_sweep": {
    "factors": [
      0.5,
      1.0,
      2.0
    ],
    "ranges": {
      "kappa": {
        "min": 0.0,
        "max": 2.0,
        "points": 3
      }
    }
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [
      0.004,
      0.002,
      0.001,
      0.0005
    ],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
        "atol": 1e-08
      }
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "a test system for Operator Inference (Lift & Learn) with no physiological counterpart"
      }
    }
  }
}
