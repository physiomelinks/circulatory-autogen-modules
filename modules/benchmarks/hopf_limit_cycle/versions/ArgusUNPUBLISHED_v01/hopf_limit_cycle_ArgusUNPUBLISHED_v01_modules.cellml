<?xml version='1.0' encoding='UTF-8'?>
<model xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#" name="hopf_limit_cycle_ArgusUNPUBLISHED_v01">
    <component name="hopf_limit_cycle">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="a" public_interface="in" units="dimensionless"/>
        <variable name="w" public_interface="in" units="dimensionless"/>
        <variable name="beta" public_interface="in" units="dimensionless"/>
        <variable name="gamma" public_interface="in" units="dimensionless"/>
        <variable name="lam" public_interface="in" units="dimensionless"/>
        <variable name="c" public_interface="in" units="dimensionless"/>
        <variable name="d" public_interface="in" units="dimensionless"/>
        <variable name="kappa" public_interface="in" units="dimensionless"/>
        <variable name="x_init" public_interface="in" units="dimensionless"/>
        <variable name="y_init" public_interface="in" units="dimensionless"/>
        <variable name="z_init" public_interface="in" units="dimensionless"/>
        <variable initial_value="x_init" name="x" public_interface="out" units="dimensionless"/>
        <variable initial_value="y_init" name="y" public_interface="out" units="dimensionless"/>
        <variable initial_value="z_init" name="z" public_interface="out" units="dimensionless"/>
        <variable name="r2" public_interface="out" units="dimensionless"/>
        <variable name="z2" public_interface="out" units="dimensionless"/>
        <variable name="thdot" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>r2</ci>
                <apply>
                    <plus/>
                    <apply>
                        <power/>
                        <ci>x</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <apply>
                        <power/>
                        <ci>y</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>z2</ci>
                <apply>
                    <power/>
                    <ci>z</ci>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>thdot</ci>
                <apply>
                    <times/>
                    <ci>w</ci>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1.0</cn>
                        <apply>
                            <times/>
                            <ci>beta</ci>
                            <apply>
                                <minus/>
                                <ci>r2</ci>
                                <cn cellml:units="dimensionless">1.0</cn>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>gamma</ci>
                            <ci>z</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>a</ci>
                        <ci>x</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>r2</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>thdot</ci>
                        <ci>y</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>y</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>a</ci>
                        <ci>y</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1.0</cn>
                            <ci>r2</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>thdot</ci>
                        <ci>x</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>z</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>lam</ci>
                            <ci>z</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>c</ci>
                        <apply>
                            <power/>
                            <ci>z</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>d</ci>
                            <apply>
                                <power/>
                                <ci>z</ci>
                                <cn cellml:units="dimensionless">3</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>kappa</ci>
                        <apply>
                            <minus/>
                            <ci>r2</ci>
                            <cn cellml:units="dimensionless">1.0</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
