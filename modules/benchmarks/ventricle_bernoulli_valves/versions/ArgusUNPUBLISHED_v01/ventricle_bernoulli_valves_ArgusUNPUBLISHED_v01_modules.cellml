            <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>zeta_mi</ci></apply><piecewise><piece><apply><times/><ci>K_o</ci><ci>dp_mi</ci><apply><plus/><cn cellml:units="dimensionless">1</cn><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>zeta_mi</ci></apply></apply></apply><apply><gt/><ci>dp_mi</ci><cn cellml:units="dimensionless">0</cn></apply></piece><otherwise><apply><times/><ci>K_c</ci><ci>dp_mi</ci><ci>zeta_mi</ci></apply></otherwise></piecewise></apply>
