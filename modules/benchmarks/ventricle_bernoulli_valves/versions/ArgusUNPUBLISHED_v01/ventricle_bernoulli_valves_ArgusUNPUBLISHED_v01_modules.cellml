            <apply><eq/><ci>q_mi</ci><piecewise><piece><apply><divide/><apply><times/><cn cellml:units="dimensionless">1</cn><ci>zeta_mi</ci><apply><plus/><apply><root/><apply><plus/><apply><power/><ci>R_mi</ci><cn cellml:units="dimensionless">2</cn></apply><apply><times/><cn cellml:units="dimensionless">4</cn><ci>B_mi</ci><apply><abs/><ci>dp_mi</ci></apply></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>R_mi</ci></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">2</cn><ci>B_mi</ci></apply></apply><apply><geq/><ci>dp_mi</ci><cn cellml:units="dimensionless">0</cn></apply></piece><otherwise><apply><divide/><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>zeta_mi</ci><apply><plus/><apply><root/><apply><plus/><apply><power/><ci>R_mi</ci><cn cellml:units="dimensionless">2</cn></apply><apply><times/><cn cellml:units="dimensionless">4</cn><ci>B_mi</ci><apply><abs/><ci>dp_mi</ci></apply></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>R_mi</ci></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">2</cn><ci>B_mi</ci></apply></apply></otherwise></piecewise></apply>
            <apply><eq/><ci>q_ao</ci><piecewise><piece><apply><divide/><apply><times/><cn cellml:units="dimensionless">1</cn><ci>zeta_ao</ci><apply><plus/><apply><root/><apply><plus/><apply><power/><ci>R_ao</ci><cn cellml:units="dimensionless">2</cn></apply><apply><times/><cn cellml:units="dimensionless">4</cn><ci>B_ao</ci><apply><abs/><ci>dp_ao</ci></apply></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>R_ao</ci></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">2</cn><ci>B_ao</ci></apply></apply><apply><geq/><ci>dp_ao</ci><cn cellml:units="dimensionless">0</cn></apply></piece><otherwise><apply><divide/><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>zeta_ao</ci><apply><plus/><apply><root/><apply><plus/><apply><power/><ci>R_ao</ci><cn cellml:units="dimensionless">2</cn></apply><apply><times/><cn cellml:units="dimensionless">4</cn><ci>B_ao</ci><apply><abs/><ci>dp_ao</ci></apply></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>R_ao</ci></apply></apply></apply><apply><times/><cn cellml:units="dimensionless">2</cn><ci>B_ao</ci></apply></apply></otherwise></piecewise></apply>
            <apply><eq/><ci>q_s</ci><apply><divide/><apply><plus/><ci>P_a</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>P_v</ci></apply></apply><ci>R_s</ci></apply></apply>
            <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>V_lv</ci></apply><apply><plus/><ci>q_mi</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>q_ao</ci></apply></apply></apply>
