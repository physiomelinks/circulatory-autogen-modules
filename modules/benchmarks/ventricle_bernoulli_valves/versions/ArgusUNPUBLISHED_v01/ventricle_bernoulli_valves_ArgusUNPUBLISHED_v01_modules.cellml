        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>e</ci><piecewise><piece><apply><power/><apply><sin/><apply><divide/><apply><times/><pi/><apply><plus/><ci>t</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>T</ci><apply><floor/><apply><divide/><ci>t</ci><ci>T</ci></apply></apply></apply></apply></apply><ci>Ts</ci></apply></apply><cn cellml:units="dimensionless">2</cn></apply><apply><gt/><ci>Ts</ci><apply><plus/><ci>t</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>T</ci><apply><floor/><apply><divide/><ci>t</ci><ci>T</ci></apply></apply></apply></apply></apply></piece><otherwise><cn cellml:units="dimensionless">0</cn></otherwise></piecewise></apply>
            <apply><eq/><ci>P_lv</ci><apply><times/><apply><plus/><ci>E_min</ci><apply><times/><ci>e</ci><apply><plus/><ci>E_max</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>E_min</ci></apply></apply></apply></apply><apply><plus/><ci>V_lv</ci><apply><times/><cn cellml:units="dimensionless">-1</cn><ci>V0</ci></apply></apply></apply></apply>
