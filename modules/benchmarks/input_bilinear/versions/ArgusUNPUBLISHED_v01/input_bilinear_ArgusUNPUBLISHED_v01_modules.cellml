<?xml version='1.0' encoding='UTF-8'?>
<model xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#" name="input_bilinear_ArgusUNPUBLISHED_v01">
    <component name="input_bilinear">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="A_1_1" public_interface="in" units="dimensionless"/>
        <variable name="A_1_2" public_interface="in" units="dimensionless"/>
        <variable name="A_2_1" public_interface="in" units="dimensionless"/>
        <variable name="A_2_2" public_interface="in" units="dimensionless"/>
        <variable name="A_2_3" public_interface="in" units="dimensionless"/>
        <variable name="A_3_2" public_interface="in" units="dimensionless"/>
        <variable name="A_3_3" public_interface="in" units="dimensionless"/>
        <variable name="N_1_1" public_interface="in" units="dimensionless"/>
        <variable name="N_1_3" public_interface="in" units="dimensionless"/>
        <variable name="N_2_2" public_interface="in" units="dimensionless"/>
        <variable name="N_3_1" public_interface="in" units="dimensionless"/>
        <variable name="N_3_3" public_interface="in" units="dimensionless"/>
        <variable name="f0_1" public_interface="in" units="dimensionless"/>
        <variable name="f0_2" public_interface="in" units="dimensionless"/>
        <variable name="f0_3" public_interface="in" units="dimensionless"/>
        <variable name="u" public_interface="in" units="dimensionless"/>
        <variable name="x_1_init" public_interface="in" units="dimensionless"/>
        <variable name="x_2_init" public_interface="in" units="dimensionless"/>
        <variable name="x_3_init" public_interface="in" units="dimensionless"/>
        <variable initial_value="x_1_init" name="x_1" public_interface="out" units="dimensionless"/>
        <variable initial_value="x_2_init" name="x_2" public_interface="out" units="dimensionless"/>
        <variable initial_value="x_3_init" name="x_3" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_1</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>A_1_1</ci>
                        <ci>x_1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>A_1_2</ci>
                        <ci>x_2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>N_1_1</ci>
                            <ci>x_1</ci>
                        </apply>
                        <ci>u</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>N_1_3</ci>
                            <ci>x_3</ci>
                        </apply>
                        <ci>u</ci>
                    </apply>
                    <ci>f0_1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_2</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>A_2_1</ci>
                        <ci>x_1</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>A_2_2</ci>
                        <ci>x_2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>A_2_3</ci>
                        <ci>x_3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>N_2_2</ci>
                            <ci>x_2</ci>
                        </apply>
                        <ci>u</ci>
                    </apply>
                    <ci>f0_2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_3</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>A_3_2</ci>
                        <ci>x_2</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>A_3_3</ci>
                        <ci>x_3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>N_3_1</ci>
                            <ci>x_1</ci>
                        </apply>
                        <ci>u</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <times/>
                            <ci>N_3_3</ci>
                            <ci>x_3</ci>
                        </apply>
                        <ci>u</ci>
