{
  "module_type": "drug_effect_emax",
  "version": "ArgusUNPUBLISHED_v01",
  "sim_time": 40.0,
  "pre_time": 0.0,
  "dt": 0.05,
  "solver": "CVODE_myokit",
  "solver_info": {
    "rtol": 1e-08,
    "atol": 1e-10
  },
  "outputs": [
    "C",
    "C_e",
    "R",
    "E"
  ],
  "invariants": [
    {
      "description": "concentrations stay non-negative and E within [0, E_max]",
      "expr": "(np.min(C) >= -1e-9) & (np.min(C_e) >= -1e-9) & (np.max(E) <= E_max + 1e-9)"
    }
  ],
  "bc_sweep": {
    "factors": [
      0.5,
      1.0,
      2.0
    ],
    "ranges": {
      "R_inf": {
        "min": 0.0,
        "max": 1.0,
        "points": 3
      }
    }
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [
      0.004,
      0.002,
      0.001,
      0.0005
    ],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {
        "solver": "CVODE_myokit",
        "rtol": 1e-06,
        "atol": 1e-08
      }
    ]
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "not_applicable",
        "reason": "an illustrative PK/PD benchmark for Operator Inference; values set by hand, not fitted to data"
      }
    }
  }
}
