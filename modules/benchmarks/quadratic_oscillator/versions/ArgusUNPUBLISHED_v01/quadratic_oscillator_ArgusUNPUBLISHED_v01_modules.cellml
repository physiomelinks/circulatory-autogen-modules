<?xml version='1.0' encoding='UTF-8'?>
<model xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#" name="quadratic_oscillator_ArgusUNPUBLISHED_v01">
    <component name="quadratic_oscillator">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="damping" public_interface="in" units="dimensionless"/>
        <variable name="w" public_interface="in" units="dimensionless"/>
        <variable name="back" public_interface="in" units="dimensionless"/>
        <variable name="y1_init" public_interface="in" units="dimensionless"/>
        <variable name="y2_init" public_interface="in" units="dimensionless"/>
        <variable name="z_init" public_interface="in" units="dimensionless"/>
        <variable initial_value="y1_init" name="y1" public_interface="out" units="dimensionless"/>
        <variable initial_value="y2_init" name="y2" public_interface="out" units="dimensionless"/>
        <variable initial_value="z_init" name="z" public_interface="out" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>y1</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>damping</ci>
                            <ci>y1</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>w</ci>
                            <ci>y2</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>back</ci>
                        <ci>z</ci>
                        <ci>y2</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>y2</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>w</ci>
                        <ci>y1</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>damping</ci>
                            <ci>y2</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>z</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <ci>z</ci>
                    </apply>
                    <apply>
                        <power/>
                        <ci>y1</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <apply>
                        <times/>
                        <ci>y1</ci>
                        <ci>y2</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
</model>
