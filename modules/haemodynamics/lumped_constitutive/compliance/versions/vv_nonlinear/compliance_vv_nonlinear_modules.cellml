<?xml version='1.0' encoding='UTF-8'?>
<model name="compliance_vv_nonlinear" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="compliance_vv_nonlinear">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="q_0" public_interface="in" units="m3"/>
        <variable name="fraction" public_interface="in" units="dimensionless"/>
        <variable name="u_0" public_interface="in" units="J_per_m3"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="v_in" public_interface="in" units="m3_per_s"/>
        <variable name="v_out" public_interface="in" units="m3_per_s"/>
        <variable name="m_tube" public_interface="in" units="dimensionless"/>
        <variable name="n_tube" public_interface="in" units="dimensionless"/>
        <variable name="K_tube" public_interface="in" units="J_per_m3"/>
        <variable name="q_0f" public_interface="out" units="m3"/>
        <variable initial_value="q_C_init" name="q_C" public_interface="out" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="du_C_dt" public_interface="out" units="J_per_m3s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>q_0f</ci><apply><times/><ci>fraction</ci><ci>q_0</ci></apply></apply>
            <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_C</ci></apply><apply><minus/><ci>v_in</ci><ci>v_out</ci></apply></apply>
            <apply><eq/><ci>q</ci><apply><plus/><ci>q_0f</ci><ci>q_C</ci></apply></apply>
            <apply><eq/><ci>du_C_dt</ci><apply><times/><ci>K_tube</ci><apply><minus/><ci>v_in</ci><ci>v_out</ci></apply><apply><minus/><apply><divide/><apply><times/><ci>m_tube</ci><apply><power/><ci>q</ci><apply><minus/><ci>m_tube</ci><cn cellml:units="dimensionless">1</cn></apply></apply></apply><apply><power/><ci>q_0f</ci><ci>m_tube</ci></apply></apply><apply><divide/><apply><times/><ci>n_tube</ci><apply><power/><ci>q</ci><apply><minus/><ci>n_tube</ci><cn cellml:units="dimensionless">1</cn></apply></apply></apply><apply><power/><ci>q_0f</ci><ci>n_tube</ci></apply></apply></apply></apply></apply>
            <apply><eq/><ci>u</ci><apply><plus/><apply><times/><ci>K_tube</ci><apply><minus/><apply><power/><apply><divide/><ci>q</ci><ci>q_0f</ci></apply><ci>m_tube</ci></apply><apply><power/><apply><divide/><ci>q</ci><ci>q_0f</ci></apply><ci>n_tube</ci></apply></apply></apply><ci>u_0</ci><ci>u_ext</ci></apply></apply>
        </math>
    </component>
</model>
