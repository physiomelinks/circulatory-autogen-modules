<?xml version='1.0' encoding='UTF-8'?>
<model name="compliance_vv_linear_geometric" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="compliance_vv_linear_geometric">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="r_0" public_interface="in" units="metre"/>
        <variable name="l" public_interface="in" units="metre"/>
        <variable name="E" public_interface="in" units="J_per_m3"/>
        <variable name="h" public_interface="out" units="metre"/>
        <variable name="C" public_interface="out" units="m6_per_J"/>
        <variable name="q_0" public_interface="out" units="m3"/>
        <variable name="a_vessel" public_interface="in" units="dimensionless"/>
        <variable name="b_vessel" public_interface="in" units="per_m"/>
        <variable name="c_vessel" public_interface="in" units="dimensionless"/>
        <variable name="d_vessel" public_interface="in" units="per_m"/>
        <variable name="fraction" public_interface="in" units="dimensionless"/>
        <variable name="u_0" public_interface="in" units="J_per_m3"/>
        <variable name="q_C_init" public_interface="in" units="m3"/>
        <variable name="u_ext" public_interface="in" units="J_per_m3"/>
        <variable name="v_in" public_interface="in" units="m3_per_s"/>
        <variable name="v_out" public_interface="in" units="m3_per_s"/>
        <variable name="C_eff" public_interface="out" units="m6_per_J"/>
        <variable initial_value="q_C_init" name="q_C" public_interface="out" units="m3"/>
        <variable name="u_C" public_interface="out" units="J_per_m3"/>
        <variable name="u" public_interface="out" units="J_per_m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <variable name="du_C_dt" public_interface="out" units="J_per_m3s"/>
        <variable name="R_v" public_interface="out" units="Js_per_m6"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>h</ci><apply><times/><ci>r_0</ci><apply><plus/><apply><times/><ci>a_vessel</ci><apply><exp/><apply><times/><ci>b_vessel</ci><ci>r_0</ci></apply></apply></apply><apply><times/><ci>c_vessel</ci><apply><exp/><apply><times/><ci>d_vessel</ci><ci>r_0</ci></apply></apply></apply></apply></apply></apply>
            <apply><eq/><ci>C</ci><apply><divide/><apply><times/><cn cellml:units="dimensionless">2</cn><pi/><ci>l</ci><apply><power/><ci>r_0</ci><cn cellml:units="dimensionless">3</cn></apply></apply><apply><times/><ci>E</ci><ci>h</ci></apply></apply></apply>
            <apply><eq/><ci>q_0</ci><apply><times/><pi/><apply><power/><ci>r_0</ci><cn cellml:units="dimensionless">2</cn></apply><ci>l</ci></apply></apply>
            <apply><eq/><ci>C_eff</ci><apply><times/><ci>fraction</ci><ci>C</ci></apply></apply>
            <apply><eq/><apply><diff/><bvar><ci>t</ci></bvar><ci>q_C</ci></apply><apply><minus/><ci>v_in</ci><ci>v_out</ci></apply></apply>
            <apply><eq/><ci>u_C</ci><apply><divide/><ci>q_C</ci><ci>C_eff</ci></apply></apply>
            <apply><eq/><ci>q</ci><apply><plus/><apply><times/><ci>fraction</ci><ci>q_0</ci></apply><ci>q_C</ci></apply></apply>
            <apply><eq/><ci>du_C_dt</ci><apply><divide/><apply><minus/><ci>v_in</ci><ci>v_out</ci></apply><ci>C_eff</ci></apply></apply>
            <apply><eq/><ci>R_v</ci><apply><divide/><cn cellml:units="second">0.01</cn><ci>C_eff</ci></apply></apply>
            <apply><eq/><ci>u</ci><apply><plus/><ci>u_0</ci><ci>u_C</ci><apply><times/><ci>R_v</ci><apply><minus/><ci>v_in</ci><ci>v_out</ci></apply></apply><ci>u_ext</ci></apply></apply>
        </math>
    </component>
</model>
