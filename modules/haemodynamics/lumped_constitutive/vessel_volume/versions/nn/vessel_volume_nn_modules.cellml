<?xml version='1.0' encoding='UTF-8'?>
<model name="vessel_volume_nn" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="vessel_volume_nn">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="q_total" public_interface="in" units="m3"/>
        <variable name="q" public_interface="out" units="m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>q</ci><ci>q_total</ci></apply>
        </math>
    </component>
</model>
