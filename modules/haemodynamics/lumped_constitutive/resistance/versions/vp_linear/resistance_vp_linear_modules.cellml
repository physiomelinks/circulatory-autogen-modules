<?xml version='1.0' encoding='UTF-8'?>
<model name="resistance_vp_linear" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="resistance_vp_linear">
        <variable name="t" public_interface="in" units="second"/>
        <variable name="fraction" public_interface="in" units="dimensionless"/>
        <variable name="R_eff" public_interface="out" units="Js_per_m6"/>
        <variable name="R" public_interface="in" units="Js_per_m6"/>
        <variable name="u_out" public_interface="in" units="J_per_m3"/>
        <variable name="v" public_interface="in" units="m3_per_s"/>
        <variable name="v_out" public_interface="out" units="m3_per_s"/>
        <variable name="u_in" public_interface="out" units="J_per_m3"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>R_eff</ci><apply><times/><ci>fraction</ci><ci>R</ci></apply></apply>
            <apply><eq/><ci>v_out</ci><ci>v</ci></apply>
            <apply><eq/><ci>u_in</ci><apply><plus/><ci>u_out</ci><apply><times/><ci>R_eff</ci><ci>v</ci></apply></apply></apply>
        </math>
    </component>
</model>
