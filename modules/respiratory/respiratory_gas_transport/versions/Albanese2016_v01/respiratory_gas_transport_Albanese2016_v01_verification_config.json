      ["R_1_T_terma", "Js_per_m6", 5000000.0, "harness flow source"],
      ["R_2_T_terma", "Js_per_m6", 5000000.0, "harness flow source"],
      ["C_T_terma", "m6_per_J", 1e-09, "harness flow source"],
      ["I_T_terma", "Js2_per_m6", 25000.0, "harness: I/R = 5 ms"],
      ["u_ext_terma", "J_per_m3", 0.0, "harness"],
      ["u_in_terma", "J_per_m3", 833.0, "harness: gives v_T = 8.33e-05 m3/s"],
      ["u_out_terma", "J_per_m3", 0.0, "harness"],
      ["q_us_terma", "m3", 0.0, "harness"],
      ["q_init_terma", "m3", 4.165e-07, "harness: equilibrium volume"],
      ["R_1_T_termp", "Js_per_m6", 5000000.0, "harness flow source"],
      ["R_2_T_termp", "Js_per_m6", 5000000.0, "harness flow source"],
      ["C_T_termp", "m6_per_J", 1e-09, "harness flow source"],
      ["I_T_termp", "Js2_per_m6", 25000.0, "harness: I/R = 5 ms"],
      ["u_ext_termp", "J_per_m3", 0.0, "harness"],
      ["u_in_termp", "J_per_m3", 833.0, "harness: gives v_T = 8.33e-05 m3/s"],
      ["u_out_termp", "J_per_m3", 0.0, "harness"],
      ["q_us_termp", "m3", 0.0, "harness"],
      ["q_init_termp", "m3", 4.165e-07, "harness: equilibrium volume"],
      ["C_CO2_in_ven", "dimensionless", 0.53, "gas_exchange_parameters.csv (harness value)"],
      ["C_O2_in_ven", "dimensionless", 0.15, "gas_exchange_parameters.csv (harness value)"],
      ["C_CO2_out_init_ven", "dimensionless", 0.53, "gas_exchange_parameters.csv (harness value)"],
      ["C_O2_out_init_ven", "dimensionless", 0.15, "gas_exchange_parameters.csv (harness value)"],
      ["q_0_ven", "m3", 0.0003, "gas_exchange_parameters.csv"],
      ["C_CO2_in_artg", "dimensionless", 0.485, "gas_exchange_parameters.csv (harness value)"],
      ["C_O2_in_artg", "dimensionless", 0.199, "gas_exchange_parameters.csv (harness value)"],
      ["C_CO2_out_init_artg", "dimensionless", 0.485, "gas_exchange_parameters.csv (harness value)"],
      ["C_O2_out_init_artg", "dimensionless", 0.199, "gas_exchange_parameters.csv (harness value)"],
      ["q_0_artg", "m3", 0.0003, "gas_exchange_parameters.csv"],
      ["C_CO2_p_init_pge", "dimensionless", 0.48, "gas_exchange_parameters.csv"],
      ["C_O2_p_init_pge", "dimensionless", 0.2, "gas_exchange_parameters.csv"],
      ["C_CO2_a_pge", "dimensionless", 0.485, "gas_exchange_parameters.csv (harness value)"],
      ["C_O2_a_pge", "dimensionless", 0.199, "gas_exchange_parameters.csv (harness value)"],
      ["q_0_pge", "m3", 0.002, "gas_exchange_parameters.csv"],
      ["k_O2_pge", "m6_per_Js", 1.7e-08, "gas_exchange_parameters.csv"],
      ["k_CO2_pge", "m6_per_Js", 4.9e-07, "gas_exchange_parameters.csv"],
      ["shunt_fraction_pge", "dimensionless", 0.017, "gas_exchange_parameters.csv"],
      ["overcap_solubility", "J_per_m3", 10000000000.0, "gas_exchange_parameters.csv global"],
      ["saturation_cap", "dimensionless", 0.9999, "gas_exchange_parameters.csv global"],
      ["k_1", "J_per_m3", 1998.5, "gas_exchange_parameters.csv global"],
      ["k_2", "J_per_m3", 25917.4, "gas_exchange_parameters.csv global"],
