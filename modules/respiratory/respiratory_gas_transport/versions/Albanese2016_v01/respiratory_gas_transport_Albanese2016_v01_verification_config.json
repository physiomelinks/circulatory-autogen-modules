      ["P_plEE_lung", "J_per_m3", -490.0, "lung_parameters.csv (library value)"],
      ["q_D_min_lung", "m3", 1e-05, "lung_parameters.csv (library value)"],
      ["q_l_us_lung", "m3", 3.44e-05, "lung_parameters.csv (library value)"],
      ["q_t_us_lung", "m3", 6.63e-06, "lung_parameters.csv (library value)"],
      ["q_b_us_lung", "m3", 1.87e-05, "lung_parameters.csv (library value)"],
      ["q_A_us_lung", "m3", 1.26e-06, "lung_parameters.csv (library value)"],
      ["R_ml_lung", "Js_per_m6", 250000.0, "lung_parameters.csv (library value)"],
      ["R_lt_lung", "Js_per_m6", 85000.0, "lung_parameters.csv (library value)"],
      ["R_tb_lung", "Js_per_m6", 80000.0, "lung_parameters.csv (library value)"],
      ["R_bA_lung", "Js_per_m6", 22000.0, "lung_parameters.csv (library value)"],
      ["R_plwall_lung", "Js_per_m6", 10000.0, "lung_parameters.csv (library value)"],
      ["alpha_LR_lung", "dimensionless", 1.0, "lung_parameters.csv (library value)"],
      ["C_l_lung", "m6_per_J", 1.3e-08, "lung_parameters.csv (library value)"],
      ["C_t_lung", "m6_per_J", 2.43e-08, "lung_parameters.csv (library value)"],
      ["C_b_lung", "m6_per_J", 1.34e-06, "lung_parameters.csv (library value)"],
      ["C_A_lung", "m6_per_J", 2.04e-05, "lung_parameters.csv (library value)"],
      ["C_pl_lung", "m6_per_J", 2.5e-06, "lung_parameters.csv (library value)"],
      ["T_resp_lung", "second", 5.0, "lung_parameters.csv (library value)"],
      ["Delta_RR_resp_lung", "per_s", 0.0, "lung_parameters.csv (library value)"],
      ["Delta_P_mus_lung", "J_per_m3", 0.0, "lung_parameters.csv (library value)"],
      ["IE_ratio_lung", "dimensionless", 0.6, "lung_parameters.csv (library value)"],
      ["P_m", "J_per_m3", 0.0, "lung_parameters.csv global (atmospheric reference)"]
    ]
  },
  "invariants": [
    {
      "description": "P_O2_A = F_O2_A (P_atm - P_ws) and P_CO2_A = F_CO2_A (P_atm - P_ws)",
      "expr": "np.max(np.abs(P_O2_A - F_O2_A*(P_atm - P_ws))) + np.max(np.abs(P_CO2_A - F_CO2_A*(P_atm - P_ws))) <= 1e-6"
    },
    {
      "description": "gas fractions in [0, 1] and F_O2 + F_CO2 <= 1",
      "expr": "np.all((F_O2_A >= 0) & (F_CO2_A >= 0) & (F_O2_D >= 0) & (F_CO2_D >= 0) & (F_O2_A + F_CO2_A <= 1) & (F_O2_D + F_CO2_D <= 1))"
    },
    {
      "description": "alveolar O2 balance: F_O2_A(t) - F_O2_A(t0) = time integral of [max(v_bA,0)(F_D - F_A) - K M_O2]/q_A (trapezoid, t0 = 5 s after the lung start-up transient)",
      "expr": "np.max(np.abs((F_O2_A - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*(((np.maximum(lung__v_bA, 0)*(F_O2_D - F_O2_A) - K_LOSSES*pge__M_O2)/lung__q_A)[1:] + ((np.maximum(lung__v_bA, 0)*(F_O2_D - F_O2_A) - K_LOSSES*pge__M_O2)/lung__q_A)[:-1])))))[t >= 5] - (F_O2_A - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*(((np.maximum(lung__v_bA, 0)*(F_O2_D - F_O2_A) - K_LOSSES*pge__M_O2)/lung__q_A)[1:] + ((np.maximum(lung__v_bA, 0)*(F_O2_D - F_O2_A) - K_LOSSES*pge__M_O2)/lung__q_A)[:-1])))))[t >= 5][0])) <= 2e-2*np.ptp(F_O2_A[t >= 5]) + 1e-6"
    },
    {
      "description": "dead-space O2 balance: F_O2_D(t) - F_O2_D(t0) = time integral of [max(v_ml,0)(F_i - F_D) - max(-v_bA,0)(F_D - F_A)]/q_D",
      "expr": "np.max(np.abs((F_O2_D - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*(((np.maximum(lung__v_ml, 0)*(F_O2_i - F_O2_D) - np.maximum(-lung__v_bA, 0)*(F_O2_D - F_O2_A))/lung__q_D)[1:] + ((np.maximum(lung__v_ml, 0)*(F_O2_i - F_O2_D) - np.maximum(-lung__v_bA, 0)*(F_O2_D - F_O2_A))/lung__q_D)[:-1])))))[t >= 5] - (F_O2_D - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*(((np.maximum(lung__v_ml, 0)*(F_O2_i - F_O2_D) - np.maximum(-lung__v_bA, 0)*(F_O2_D - F_O2_A))/lung__q_D)[1:] + ((np.maximum(lung__v_ml, 0)*(F_O2_i - F_O2_D) - np.maximum(-lung__v_bA, 0)*(F_O2_D - F_O2_A))/lung__q_D)[:-1])))))[t >= 5][0])) <= 2e-2*np.ptp(F_O2_D[t >= 5]) + 1e-6"
    },
    {
      "description": "inspired gas bounds: F_O2_D and F_O2_A never exceed F_O2_i (no O2 source other than inspired air), once the initial fractions have washed out (t >= 30 s). Run point only: with hypoxic inspired air (F_O2_i = 0.12) the 2 L pulmonary capillary pool, initialised at 0.20 ml/ml, releases O2 into the alveoli (M_O2 < 0) for longer than 30 s, which is physically correct",
      "expr": "np.all((F_O2_D <= F_O2_i + 1e-9)[t >= 30]) & np.all((F_O2_A <= F_O2_i + 1e-9)[t >= 30])",
      "applies": "run"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "F_O2_i": {"min": 0.12, "max": 0.6, "points": 4},
      "F_CO2_i": {"min": 0.0, "max": 0.05, "points": 4},
      "K_LOSSES": {"min": 1.0, "max": 1.2103, "points": 2},
      "F_CO2_D_init": {"min": 0.0, "max": 0.06, "points": 3},
      "F_O2_D_init": {"min": 0.12, "max": 0.21, "points": 3},
      "F_CO2_A_init": {"min": 0.03, "max": 0.07, "points": 3},
      "F_O2_A_init": {"min": 0.1, "max": 0.18, "points": 3}
    },
    "exclude": ["v_ml", "v_bA", "q_D", "q_A"],
    "rationale": "Inspired O2 from hypoxic (12%) to 60% supplemental O2; inspired CO2 0-5% (hypercapnia challenges); K from the library 1 to the BTPS/STPD factor 1.2103 of Albanese. v_ml, v_bA, q_D, q_A are supplied by the lung in the harness, so their parameter values are unused and not swept."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.00025, 0.000125, 6.25e-05, 3.125e-05],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.01,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ],
    "t_end": 10.0
  },
  "validation": {
    "default": {
      "baseline": {
        "status": "pending",
        "reason": "candidate: normal alveolar P_O2 104 / P_CO2 40 mmHg and dead-space extremes (albanese2014physiology Table 2-12); depends on the lung parameters (see lung review) so set up once those are settled"
      },
      "calibrate": {"note": "pending: candidate: capnography (end-tidal CO2 waveform) data; owner to choose"}
    }
  }
}
