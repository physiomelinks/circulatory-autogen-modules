      ["beta_1", "m3_per_J", 6.21e-05, "gas_exchange_parameters.csv global"],
      ["beta_2", "m3_per_J", 0.000244, "gas_exchange_parameters.csv global"],
      ["C_O2_sat", "dimensionless", 0.20448, "gas_exchange_parameters.csv global"],
