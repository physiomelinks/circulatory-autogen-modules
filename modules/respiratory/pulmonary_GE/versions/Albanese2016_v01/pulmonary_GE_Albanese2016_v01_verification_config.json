        "note": "pending: k_O2/k_CO2 could be identified from alveolar-arterial gradients (e.g. A-a O2 difference ~5-10 mmHg); needs the owner to choose data"
      }
    },
    "pulmonary_GE_normal_blood_gases": {
      "baseline": {
        "status": "proposed",
        "source": "albanese2014physiology Table 2-12 normal resting values (arterial P_O2 100 mmHg, P_CO2 40 mmHg; mixed venous 15 ml/dl O2, 53 ml/dl CO2 used as the harness venous input)",
        "source_short": "normal resting blood gases (Albanese 2014 Table 2-12)",
        "data": "instances/pulmonary_GE_normal_blood_gases/pulmonary_GE_normal_blood_gases.csv",
        "time_column": "t",
        "variables": {"P_O2_p": "P_O2_Pa", "P_CO2_p": "P_CO2_Pa"},
        "parameters": {},
