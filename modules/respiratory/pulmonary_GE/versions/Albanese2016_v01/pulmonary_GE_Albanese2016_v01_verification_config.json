  "invariants": [
    {
      "description": "Spencer inverse is exact: the forward Spencer curve at (P_O2_p, P_CO2_p) returns C_O2_p (below the cap)",
      "expr": "np.max(np.where(C_O2_p_extra_ub == 0, np.abs(C_O2_sat*((P_O2_p)*(1 + beta_1*(P_CO2_p))/(k_1*(1 + alpha_1*(P_CO2_p))))**(1/h_1)/(1 + ((P_O2_p)*(1 + beta_1*(P_CO2_p))/(k_1*(1 + alpha_1*(P_CO2_p))))**(1/h_1)) - C_O2_p), 0)) <= 1e-6*C_O2_sat"
    },
    {
      "description": "... and returns C_CO2_p",
      "expr": "np.max(np.where((C_O2_p_extra_ub == 0) & (C_CO2_p < saturation_cap*C_CO2_sat), np.abs(C_CO2_sat*((P_CO2_p)*(1 + beta_2*(P_O2_p))/(k_2*(1 + alpha_2*(P_O2_p))))**(1/h_2)/(1 + ((P_CO2_p)*(1 + beta_2*(P_O2_p))/(k_2*(1 + alpha_2*(P_O2_p))))**(1/h_2)) - C_CO2_p), 0)) <= 1e-6*C_CO2_sat"
    },
    {
      "description": "arterial content is the exact flow-weighted mix of capillary and shunted venous blood",
      "expr": "np.max(np.abs(C_O2_a - ((1 - shunt_fraction)*C_O2_p + shunt_fraction*ven__C_O2_out))[t > 0.1]) <= 1e-9"
    },
    {
      "description": "Fick flux law M_O2 = k_O2 (P_O2_A - P_O2_p)",
      "expr": "np.max(np.abs(M_O2 - k_O2*(resp__P_O2_A - P_O2_p))) <= 1e-9*max(1e-12, np.max(np.abs(M_O2)))"
    },
    {
      "description": "capillary O2 mass balance: q_0 (C(t) - C(0)) = time integral of v_p (C_v - C) + M_O2 (trapezoid; after the 1 s start-up transient)",
      "expr": "np.max(np.abs((q_0*(C_O2_p - C_O2_p[0]) - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*((termp__v_T*(1 - shunt_fraction)*(ven__C_O2_out - C_O2_p) + M_O2)[1:] + (termp__v_T*(1 - shunt_fraction)*(ven__C_O2_out - C_O2_p) + M_O2)[:-1])))))[t >= 1] - (q_0*(C_O2_p - C_O2_p[0]) - np.concatenate(([0.0], np.cumsum(0.5*np.diff(t)*((termp__v_T*(1 - shunt_fraction)*(ven__C_O2_out - C_O2_p) + M_O2)[1:] + (termp__v_T*(1 - shunt_fraction)*(ven__C_O2_out - C_O2_p) + M_O2)[:-1])))))[t >= 1][0])) <= 5e-3*max(np.ptp(q_0*C_O2_p), 1e-9)"
    },
    {
      "description": "bounds: C_O2_p >= 0, C_O2_p <= C_O2_sat once the initial condition has washed out (t >= 10 s; C_O2_p_init may exceed a swept C_O2_sat), partial pressures >= 0",
      "expr": "np.all(C_O2_p >= 0) & np.all((C_O2_p <= C_O2_sat)[t >= 10]) & np.all(P_O2_p >= 0) & np.all(P_CO2_p >= 0)"
    }
  ],
  "bc_sweep": {
    "sweep": "all",
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "q_0": {"min": 5e-05, "max": 0.002, "points": 4, "scale": "log"},
      "k_O2": {"min": 2e-09, "max": 5e-08, "points": 4, "scale": "log"},
      "k_CO2": {"min": 2e-08, "max": 1e-06, "points": 4, "scale": "log"},
      "shunt_fraction": {"min": 0.0, "max": 0.3, "points": 4},
      "C_O2_p_init": {"min": 0.1, "max": 0.2, "points": 3},
      "C_CO2_p_init": {"min": 0.42, "max": 0.56, "points": 3},
      "C_O2_sat": {"min": 0.19, "max": 0.25, "points": 3},
      "C_CO2_sat": {"min": 1.6, "max": 2.4, "points": 3}
    },
    "exclude": ["C_CO2_a", "C_O2_a"],
    "rationale": "q_0 from a textbook capillary volume (~75 ml) to the library 2 L; k_O2 from a diffusing-capacity-like 2.6e-9 (D_LO2 ~ 20 ml/min/mmHg) to 3x library; k_CO2 similarly; shunt 0-30% (normal to severe shunt). C_CO2_a/C_O2_a are excluded: they are computed, the config wrongly declares them boundary conditions. C_O2_sat is swept -7%..+22% (Hb ~14-18 g/dl) and C_CO2_sat +-20%; below that the fixed venous input (0.15 ml/ml) and initial content (0.20) are inconsistent with the saturation. Other Spencer globals use the default factors."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.00025, 0.000125, 6.25e-05, 3.125e-05],
    "t_end": 2.0,
    "min_order": 0.8,
    "tol": 0.01,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ],
    "t_end": 10.0
  },
  "validation": {
    "default": {
