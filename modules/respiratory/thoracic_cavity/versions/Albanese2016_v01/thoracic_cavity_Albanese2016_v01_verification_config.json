{
  "module_type": "thoracic_cavity",
  "version": "Albanese2016_v01",
  "sim_time": 1.0,
  "pre_time": 0.0,
  "dt": 0.01,
  "solver": "CVODE_myokit",
  "outputs": ["P_thor"],
  "invariants": [
    {
      "description": "P_thor = P_pl exactly",
      "expr": "np.max(np.abs(P_thor - P_pl)) <= 1e-12*max(1.0, abs(P_pl))"
    }
  ],
  "bc_sweep": {
    "factors": [0.5, 0.75, 1.0, 1.5, 2.0],
    "ranges": {
      "P_pl": {"min": -2000, "max": 1000, "points": 7}
    },
    "rationale": "Pleural pressure from deep inspiration (-20 cmH2O) to positive-pressure ventilation / forced expiration (+10 cmH2O)."
  },
  "timestep": {
    "scheme": "rk4",
    "dts": [0.004, 0.002, 0.001, 0.0005],
    "min_order": 0.8,
    "tol": 0.0001,
    "cvode_tol": 0.001
  },
  "stability": {
    "supported": [
      {"solver": "CVODE_myokit", "rtol": 1e-06, "atol": 1e-08}
    ]
  },
  "validation": {
    "default": {
      "baseline": {"status": "not_applicable", "reason": "identity map with no physiology of its own"},
      "calibrate": {"note": "not_applicable: no parameters"}
    }
  }
}
