<?xml version='1.0' encoding='UTF-8'?>
<model name="glucose_carrier_ATP_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="glucose_carrier_ATP">
        <variable name="t" public_interface="in" units="second"/>
        <!-- medium side (entrance medium_face_port) -->
        <variable name="C_glc_e" public_interface="in" units="millimolar"/>
        <!-- carried for the port -->
        <variable name="C_lac_e" public_interface="in" units="millimolar"/>
        <!-- cytosol side (exit cytosol_face_port) -->
        <variable name="C_glc" public_interface="in" units="millimolar"/>
        <!-- carried for the port -->
        <variable name="C_lac" public_interface="in" units="millimolar"/>
        <variable name="C_ATP" public_interface="in" units="millimolar"/>
        <variable name="C_ADP" public_interface="in" units="millimolar"/>
        <variable name="C_Pi" public_interface="in" units="millimolar"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <!-- expression (protein_expression port): n_0 copies at 1 -->
        <variable name="m_expr" public_interface="in" units="dimensionless"/>
        <!-- capacity per membrane area at m_expr = 1 -->
        <variable name="jmax_glc" public_interface="in" units="mol_per_s_per_um2"/>
        <!-- affinity for glucose outside -->
        <variable name="K_glc_t" public_interface="in" units="millimolar"/>
        <variable name="R" public_interface="in" units="J_per_mol_K"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <!-- glucose into the cell -->
        <variable name="J_glc" public_interface="out" units="mol_per_s"/>
        <!-- affinity of one transport cycle (&gt; 0 drives glucose in) -->
        <variable name="A_glc" public_interface="out" units="J_per_mol"/>
        <variable name="J_glc_e" public_interface="out" units="mol_per_s"/>
        <variable name="J_lac_e" public_interface="out" units="mol_per_s"/>
        <variable name="J_glc_c" public_interface="out" units="mol_per_s"/>
        <variable name="J_lac_c" public_interface="out" units="mol_per_s"/>
        <!-- ATP, ADP and Pi do not cross -->
        <variable name="J_ATP_c" public_interface="out" units="mol_per_s"/>
        <variable name="J_ADP_c" public_interface="out" units="mol_per_s"/>
        <variable name="J_Pi_c" public_interface="out" units="mol_per_s"/>
        <!-- ATP equivalents hydrolysed per glucose taken up -->
        <variable name="n_P" public_interface="in" units="dimensionless"/>
        <!-- ATP for half-rate -->
        <variable name="K_m_ATP" public_interface="in" units="millimolar"/>
        <!-- cytosol ATP (ATP_hydrolysis_port) -->
        <variable name="ATP" public_interface="in" units="millimolar"/>
        <variable name="ADP" public_interface="in" units="millimolar"/>
        <variable name="Pi" public_interface="in" units="millimolar"/>
        <variable name="dG0_hyd" public_interface="in" units="J_per_mol"/>
        <variable name="c_std" public_interface="in" units="millimolar"/>
        <!-- ATP at which hydrolysis would be at equilibrium with the present ADP and Pi -->
        <variable name="ATP_eq" public_interface="out" units="millimolar"/>
        <!-- free energy of ATP hydrolysis -->
        <variable name="A_ATP" public_interface="out" units="J_per_mol"/>
        <!-- ATP hydrolysed, n_P per glucose -->
        <variable name="J_ATP_cost" public_interface="out" units="mol_per_s"/>
        <variable name="j_ATP" public_interface="out" units="mol_per_s"/>
        <variable name="j_ADP" public_interface="out" units="mol_per_s"/>
        <variable name="j_Pi" public_interface="out" units="mol_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>ATP_eq</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>ADP</ci>
                            <ci>Pi</ci>
                        </apply>
                        <ci>c_std</ci>
                    </apply>
                    <apply>
                        <exp/>
                        <apply>
                            <divide/>
                            <ci>dG0_hyd</ci>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A_ATP</ci>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>dG0_hyd</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>R</ci>
                        <ci>T</ci>
                        <apply>
                            <ln/>
                            <apply>
                                <plus/>
                                <apply>
                                    <abs/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <divide/>
                                                <ci>ADP</ci>
                                                <ci>c_std</ci>
                                            </apply>
                                            <apply>
                                                <divide/>
                                                <ci>Pi</ci>
                                                <ci>c_std</ci>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <divide/>
                                            <ci>ATP</ci>
                                            <ci>c_std</ci>
                                        </apply>
                                    </apply>
                                </apply>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>-300</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_glc</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>jmax_glc</ci>
                        <ci>m_expr</ci>
                        <ci>A_mem</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <ci>C_glc_e</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <ci>ATP</ci>
                                        <ci>K_m_ATP</ci>
                                    </apply>
                                    <ci>n_P</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>C_glc</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <ci>ATP_eq</ci>
                                        <ci>K_m_ATP</ci>
                                    </apply>
                                    <ci>n_P</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_glc_t</ci>
                            <ci>C_glc_e</ci>
                        </apply>
                        <apply>
                            <power/>
                            <apply>
                                <plus/>
                                <cn cellml:units="dimensionless">1.0</cn>
                                <apply>
                                    <divide/>
                                    <ci>ATP</ci>
                                    <ci>K_m_ATP</ci>
                                </apply>
                            </apply>
                            <ci>n_P</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A_glc</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>R</ci>
                        <ci>T</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <ln/>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <abs/>
                                        <apply>
                                            <divide/>
                                            <ci>C_glc_e</ci>
                                            <ci>c_std</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>-300</cn>
                                </apply>
                            </apply>
                            <apply>
                                <ln/>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <abs/>
                                        <apply>
                                            <divide/>
                                            <ci>C_glc</ci>
                                            <ci>c_std</ci>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>-300</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>n_P</ci>
                        <ci>A_ATP</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_ATP_cost</ci>
                <apply>
                    <times/>
                    <ci>n_P</ci>
                    <ci>J_glc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_ATP</ci>
                <apply>
                    <minus/>
                    <ci>J_ATP_cost</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_ADP</ci>
                <ci>J_ATP_cost</ci>
            </apply>
            <apply>
                <eq/>
                <ci>j_Pi</ci>
                <ci>J_ATP_cost</ci>
            </apply>
            <apply>
                <eq/>
                <ci>J_glc_e</ci>
                <apply>
                    <minus/>
                    <ci>J_glc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_lac_e</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
            <apply>
                <eq/>
                <ci>J_glc_c</ci>
                <ci>J_glc</ci>
            </apply>
            <apply>
                <eq/>
                <ci>J_lac_c</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
            <apply>
                <eq/>
                <ci>J_ATP_c</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
            <apply>
                <eq/>
                <ci>J_ADP_c</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
            <apply>
                <eq/>
                <ci>J_Pi_c</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
        </math>
    </component>
</model>
