<?xml version='1.0' encoding='UTF-8'?>
<model name="glucose_carrier_PTS_ArgusUNPUBLISHED_v01" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="glucose_carrier_PTS">
        <variable name="t" public_interface="in" units="second"/>
        <!-- medium side (entrance medium_face_port) -->
        <variable name="C_glc_e" public_interface="in" units="millimolar"/>
        <!-- carried for the port -->
        <variable name="C_lac_e" public_interface="in" units="millimolar"/>
        <variable name="A_mem" public_interface="in" units="um2"/>
        <!-- expression (protein_expression port): n_0 copies at 1 -->
        <variable name="m_expr" public_interface="in" units="dimensionless"/>
        <!-- capacity per membrane area at m_expr = 1 -->
        <variable name="jmax_glc" public_interface="in" units="mol_per_s_per_um2"/>
        <!-- affinity for glucose outside -->
        <variable name="K_glc_t" public_interface="in" units="millimolar"/>
        <!-- ATP (the PEP equivalent) for half-rate -->
        <variable name="K_m_ATP" public_interface="in" units="millimolar"/>
        <!-- cytosol ATP (ATP_hydrolysis_port): PEP is charged as ATP -->
        <variable name="ATP" public_interface="in" units="millimolar"/>
        <!-- ADP for half-rate of the PEP supply (the lower glycolysis' ADP affinity) -->
        <variable name="K_ADP_PEP" public_interface="in" units="millimolar"/>
        <!-- Pi for half-rate of the PEP supply (the lower glycolysis' Pi affinity) -->
        <variable name="K_Pi_PEP" public_interface="in" units="millimolar"/>
        <!-- PEP supply: the lower glycolysis makes PEP only as fast as ADP and Pi allow -->
        <variable name="f_PEP" public_interface="out" units="dimensionless"/>
        <variable name="ADP" public_interface="in" units="millimolar"/>
        <variable name="Pi" public_interface="in" units="millimolar"/>
        <!-- cytosol glucose 6-phosphate (G6P_port) -->
        <variable name="C_G6P" public_interface="in" units="millimolar"/>
        <!-- standard Gibbs energy of glucose + ATP -&gt; G6P + ADP -->
        <variable name="dG0_hk" public_interface="in" units="J_per_mol"/>
        <variable name="c_std" public_interface="in" units="millimolar"/>
        <variable name="R" public_interface="in" units="J_per_mol_K"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <!-- equilibrium constant of glc_e + ATP &lt;=&gt; G6P_i + ADP -->
        <variable name="K_eq" public_interface="out" units="dimensionless"/>
        <!-- its mass-action ratio, G6P ADP/(glc_e ATP) -->
        <variable name="Gamma" public_interface="out" units="dimensionless"/>
        <!-- glucose taken from the medium (and delivered as G6P) -->
        <variable name="J_glc" public_interface="out" units="mol_per_s"/>
        <!-- affinity of one transport cycle (&gt; 0 drives glucose in) -->
        <variable name="A_glc" public_interface="out" units="J_per_mol"/>
        <variable name="J_glc_e" public_interface="out" units="mol_per_s"/>
        <variable name="J_lac_e" public_interface="out" units="mol_per_s"/>
        <!-- G6P into the cytosol (G6P_port) -->
        <variable name="J_G6P" public_interface="out" units="mol_per_s"/>
        <!-- PEP spent, in ATP equivalents: one per glucose -->
        <variable name="J_ATP_cost" public_interface="out" units="mol_per_s"/>
        <variable name="j_ATP" public_interface="out" units="mol_per_s"/>
        <variable name="j_ADP" public_interface="out" units="mol_per_s"/>
        <!-- no Pi is released: the phosphoryl goes onto the glucose -->
        <variable name="j_Pi" public_interface="out" units="mol_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>K_eq</ci>
                <apply>
                    <exp/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>dG0_hk</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Gamma</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>C_G6P</ci>
                            <ci>c_std</ci>
                        </apply>
                        <apply>
                            <divide/>
                            <ci>ADP</ci>
                            <ci>c_std</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>C_glc_e</ci>
                            <ci>c_std</ci>
                        </apply>
                        <apply>
                            <divide/>
                            <ci>ATP</ci>
                            <ci>c_std</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>f_PEP</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <ci>ADP</ci>
                            <apply>
                                <plus/>
                                <ci>K_ADP_PEP</ci>
                                <ci>ADP</ci>
                            </apply>
                        </apply>
                        <ci>Pi</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>K_Pi_PEP</ci>
                        <ci>Pi</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_glc</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>jmax_glc</ci>
                        <ci>m_expr</ci>
                        <ci>A_mem</ci>
                        <ci>f_PEP</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <ci>C_glc_e</ci>
                                <ci>ATP</ci>
                            </apply>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>C_G6P</ci>
                                    <ci>ADP</ci>
                                </apply>
                                <ci>K_eq</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_m_ATP</ci>
                            <ci>ATP</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>K_glc_t</ci>
                            <ci>C_glc_e</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A_glc</ci>
                <apply>
                    <times/>
                    <ci>R</ci>
                    <ci>T</ci>
                    <apply>
                        <minus/>
                        <apply>
                            <ln/>
                            <ci>K_eq</ci>
                        </apply>
                        <apply>
                            <ln/>
                            <apply>
                                <plus/>
                                <apply>
                                    <abs/>
                                    <ci>Gamma</ci>
                                </apply>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>-300</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_glc_e</ci>
                <apply>
                    <minus/>
                    <ci>J_glc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_lac_e</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
            <apply>
                <eq/>
                <ci>J_G6P</ci>
                <ci>J_glc</ci>
            </apply>
            <apply>
                <eq/>
                <ci>J_ATP_cost</ci>
                <ci>J_glc</ci>
            </apply>
            <apply>
                <eq/>
                <ci>j_ATP</ci>
                <apply>
                    <minus/>
                    <ci>J_glc</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>j_ADP</ci>
                <ci>J_glc</ci>
            </apply>
            <apply>
                <eq/>
                <ci>j_Pi</ci>
                <cn cellml:units="mol_per_s">0.0</cn>
            </apply>
        </math>
    </component>
</model>
