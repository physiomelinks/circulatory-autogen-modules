.DS_Store
venv/
__pycache__/
*.egg-info/
.pytest_cache/
# generated by the tests and the report generator (published by CI to GitHub Pages)
modules/**/plots/
modules/**/results/
modules/**/*.html
site/
system_models/**/results/
system_models/**/plots/
# libcuflynx writes a copy of the user inputs next to the resources it generates from
system_models/**/user_inputs_*.yaml
# the old layout, until the poiseuille work moves (another session's)
modules/*/plots/
modules/*/results/
modules/system/*/*/results/
modules/system/*/*/plots/
modules/system/**/user_inputs_*.yaml
# per-instance COMBINE archives for CUFLynx (tools/build_instance_omex.py)
modules/**/instances/*/*.omex
