        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
