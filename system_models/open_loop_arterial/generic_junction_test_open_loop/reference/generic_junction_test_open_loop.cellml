      <apply>
        <eq/>
        <ci>v_popliteal_R_I_sum_Nout</ci>
        <apply>
          <plus/>
          <ci>v_anterior_tibial_R_Nout</ci>
          <ci>v_popliteal_R_II_Nout</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_femoral_L_I_sum_Nout</ci>
        <apply>
          <plus/>
          <ci>v_profunda_femoris_L_Nout</ci>
          <ci>v_femoral_L_II_Nout</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_popliteal_L_I_sum_Nout</ci>
        <apply>
          <plus/>
          <ci>v_anterior_tibial_L_Nout</ci>
          <ci>v_popliteal_L_II_Nout</ci>
        </apply>
      </apply>
    </math>
  </component>
