                    <apply>
                      <minus/>
                      <ci>t_loc</ci>
                      <ci>t_19</ci>
                    </apply>
                    <apply>
                      <minus/>
                      <ci>t_20</ci>
                      <ci>t_19</ci>
                    </apply>
