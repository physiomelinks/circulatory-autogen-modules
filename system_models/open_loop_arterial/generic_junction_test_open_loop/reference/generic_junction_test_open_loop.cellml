            </apply>
          </apply>
          <apply>
            <times/>
            <ci>K_tube_visco</ci>
            <apply>
              <minus/>
              <ci>v</ci>
              <ci>v_out</ci>
            </apply>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
    </math>
