              <ci>c_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- Gamma is the wall viscosity
 evaluated as the product of the viscoelastic parameter K_m and the volume fraction of smooth muscle SMvolfrac
 Gamma = 0.1{dimensionless}*K_m;-->
      <apply>
        <eq/>
        <ci>Gamma</ci>
        <apply>
          <times/>
          <ci>SMvolfrac_art</ci>
          <ci>K_m</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>K_tube</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <ci>nu</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>r_0</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>K_tube_visco</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">2</cn>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>Gamma</ci>
            <ci>h</ci>
          </apply>
          <apply>
            <times/>
            <ci>l</ci>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
