            <divide/>
            <ci>q</ci>
            <apply>
              <times/>
              <pi/>
              <ci>l</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <!-- I = I_scale*rho*l/(pi*sqr(r));-->
      <apply>
        <eq/>
