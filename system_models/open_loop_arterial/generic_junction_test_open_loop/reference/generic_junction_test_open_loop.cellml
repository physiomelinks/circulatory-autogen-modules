  <component name="K_tube_aortic_arch_I_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="l" units="metre" interface="public"/>
    <variable name="r_0" units="metre" interface="public"/>
    <variable name="E" units="J_per_m3" interface="public"/>
    <variable name="K_m" units="Js_per_m3" interface="public"/>
    <variable name="Gamma" units="Js_per_m3" interface="public"/>
    <variable name="SMvolfrac_art" units="dimensionless" interface="public"/>
    <variable name="nu" units="dimensionless" interface="public"/>
    <variable name="a_vessel" units="dimensionless" interface="public"/>
    <variable name="b_vessel" units="per_m" interface="public"/>
    <variable name="c_vessel" units="dimensionless" interface="public"/>
    <variable name="d_vessel" units="per_m" interface="public"/>
    <variable name="h" units="metre" interface="public"/>
    <variable name="K_tube" units="J_per_m3" interface="public"/>
    <variable name="K_tube_visco" units="Js_per_m6" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>c_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- Gamma is the wall viscosity
 evaluated as the product of the viscoelastic parameter K_m and the volume fraction of smooth muscle SMvolfrac
 Gamma = 0.1{dimensionless}*K_m;-->
      <apply>
        <eq/>
        <ci>Gamma</ci>
        <apply>
          <times/>
          <ci>SMvolfrac_art</ci>
          <ci>K_m</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>K_tube</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <ci>nu</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>r_0</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>K_tube_visco</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">2</cn>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>Gamma</ci>
            <ci>h</ci>
          </apply>
          <apply>
            <times/>
            <ci>l</ci>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
