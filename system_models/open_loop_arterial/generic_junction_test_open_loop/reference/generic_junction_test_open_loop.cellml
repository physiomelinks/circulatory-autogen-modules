    <variable name="K_tube" units="J_per_m3" interface="public"/>
    <variable name="K_tube_visco" units="Js_per_m6" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
                  <ci>r_0</ci>
                </apply>
