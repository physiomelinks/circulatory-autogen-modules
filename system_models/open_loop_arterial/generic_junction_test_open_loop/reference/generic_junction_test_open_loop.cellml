        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">2</cn>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>Gamma</ci>
            <ci>h</ci>
          </apply>
          <apply>
            <times/>
            <ci>l</ci>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
