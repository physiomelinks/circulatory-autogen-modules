  <component name="lung_stretch_module">
    <variable name="q_str" units="m3" interface="public"/>
    <variable name="t" units="second" interface="public"/>
    <variable name="f_ls" units="Hz" initial_value="0" interface="public"/>
    <variable name="tau_lung" units="second" interface="public"/>
    <variable name="G_al" units="per_m3_s" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>f_ls</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>f_ls</ci>
            </apply>
            <apply>
              <times/>
              <ci>G_al</ci>
              <ci>q_str</ci>
            </apply>
          </apply>
          <ci>tau_lung</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="baroreceptor_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="P_sys" units="J_per_m3" interface="public"/>
    <variable name="P_baro_init" units="J_per_m3" interface="public"/>
    <variable name="P_baro" units="J_per_m3" initial_value="P_baro_init" interface="public"/>
    <variable name="f_ab" units="Hz" interface="public"/>
    <variable name="dP_sys_dt" units="J_per_m3s" interface="public"/>
    <variable name="P_nom" units="J_per_m3" interface="public"/>
    <variable name="f_ab_min" units="Hz" interface="public"/>
    <variable name="f_ab_max" units="Hz" interface="public"/>
    <variable name="k_ab" units="J_per_m3" interface="public"/>
    <variable name="tau_zb" units="second" interface="public"/>
    <variable name="tau_pb" units="second" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>P_baro</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <ci>P_sys</ci>
              <apply>
                <times/>
                <ci>tau_zb</ci>
                <ci>dP_sys_dt</ci>
              </apply>
            </apply>
            <ci>P_baro</ci>
          </apply>
          <ci>tau_pb</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_ab</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <ci>f_ab_min</ci>
            <apply>
              <times/>
              <ci>f_ab_max</ci>
              <apply>
                <exp/>
                <apply>
                  <divide/>
                  <apply>
                    <minus/>
                    <ci>P_baro</ci>
                    <ci>P_nom</ci>
                  </apply>
                  <ci>k_ab</ci>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>P_baro</ci>
                  <ci>P_nom</ci>
                </apply>
                <ci>k_ab</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="cardiopulm_receptor_module">
    <variable name="P_pvn" units="J_per_m3" interface="public"/>
    <variable name="P_mus" units="J_per_m3" interface="public"/>
    <variable name="P_pv_P_thor" units="J_per_m3" interface="public"/>
    <variable name="t" units="second" interface="public"/>
    <variable name="tau_cp" units="second" interface="public"/>
    <variable name="P_l_init" units="J_per_m3" interface="public"/>
    <variable name="P_l" units="J_per_m3" initial_value="P_l_init" interface="public"/>
    <variable name="f_cp" units="Hz" interface="public"/>
    <variable name="f_maxl" units="Hz" interface="public"/>
    <variable name="P_tn" units="J_per_m3" interface="public"/>
    <variable name="k_l" units="J_per_m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>P_pv_P_thor</ci>
        <apply>
          <minus/>
          <ci>P_pvn</ci>
          <ci>P_mus</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>P_l</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>P_l</ci>
            </apply>
            <ci>P_pv_P_thor</ci>
          </apply>
          <ci>tau_cp</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_cp</ci>
        <apply>
          <divide/>
          <ci>f_maxl</ci>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>P_tn</ci>
                  <ci>P_l</ci>
                </apply>
                <ci>k_l</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="sympathetic_afferent_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_ash" units="Hz" interface="public"/>
    <variable name="G_abh" units="dimensionless" interface="public"/>
    <variable name="f_br" units="Hz" interface="public"/>
    <variable name="G_alh" units="dimensionless" interface="public"/>
    <variable name="f_ls" units="Hz" interface="public"/>
    <variable name="G_ach" units="dimensionless" interface="public"/>
    <variable name="f_cp" units="Hz" interface="public"/>
    <variable name="f_asp" units="Hz" interface="public"/>
    <variable name="G_abp" units="dimensionless" interface="public"/>
    <variable name="G_alp" units="dimensionless" interface="public"/>
    <variable name="G_acp" units="dimensionless" interface="public"/>
    <variable name="f_asv" units="Hz" interface="public"/>
    <variable name="G_abv" units="dimensionless" interface="public"/>
    <variable name="G_alv" units="dimensionless" interface="public"/>
    <variable name="G_acv" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_ash</ci>
        <apply>
          <plus/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci>G_abh</ci>
              <ci>f_br</ci>
            </apply>
            <apply>
              <times/>
              <ci>G_alh</ci>
              <ci>f_ls</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>G_ach</ci>
            <apply>
              <minus/>
              <ci>f_cp</ci>
              <cn cellml:units="Hz">10</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_asp</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>G_abp</ci>
            <ci>f_br</ci>
          </apply>
          <apply>
            <times/>
            <ci>G_alp</ci>
            <ci>f_ls</ci>
          </apply>
          <apply>
            <times/>
            <ci>G_acp</ci>
            <apply>
              <minus/>
              <ci>f_cp</ci>
              <cn cellml:units="Hz">10</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_asv</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>G_abv</ci>
            <ci>f_br</ci>
          </apply>
          <apply>
            <times/>
            <ci>G_alv</ci>
            <ci>f_ls</ci>
          </apply>
          <apply>
            <times/>
            <ci>G_acv</ci>
            <apply>
              <minus/>
              <ci>f_cp</ci>
              <cn cellml:units="Hz">10</cn>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="sympathetic_efferent_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_esh" units="Hz" interface="public"/>
    <variable name="f_esinf" units="Hz" interface="public"/>
    <variable name="f_es0" units="Hz" interface="public"/>
    <variable name="k_es" units="second" interface="public"/>
    <variable name="f_ash" units="Hz" interface="public"/>
    <variable name="f_esp" units="Hz" interface="public"/>
    <variable name="f_asp" units="Hz" interface="public"/>
    <variable name="f_esv" units="Hz" interface="public"/>
    <variable name="f_asv" units="Hz" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>f_esh</ci>
        <apply>
          <plus/>
          <ci>f_esinf</ci>
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci>f_es0</ci>
              <ci>f_esinf</ci>
            </apply>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>k_es</ci>
                </apply>
                <ci>f_ash</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>f_esp</ci>
        <apply>
          <plus/>
          <ci>f_esinf</ci>
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci>f_es0</ci>
              <ci>f_esinf</ci>
            </apply>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>k_es</ci>
                </apply>
                <ci>f_asp</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>f_esv</ci>
        <apply>
          <plus/>
          <ci>f_esinf</ci>
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci>f_es0</ci>
              <ci>f_esinf</ci>
            </apply>
            <apply>
              <exp/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>k_es</ci>
                </apply>
                <ci>f_asv</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="NTS_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_br" units="Hz" interface="public"/>
    <variable name="f_min_br" units="Hz" interface="public"/>
    <variable name="f_max_br" units="Hz" interface="public"/>
    <variable name="f_mid_br" units="Hz" interface="public"/>
    <variable name="f_NTS_br" units="Hz" interface="public"/>
    <variable name="k_NTS_br" units="dimensionless" interface="public"/>
    <variable name="f_ls" units="Hz" interface="public"/>
    <variable name="f_min_ls" units="Hz" interface="public"/>
    <variable name="f_max_ls" units="Hz" interface="public"/>
    <variable name="f_mid_ls" units="Hz" interface="public"/>
    <variable name="f_NTS_ls" units="Hz" interface="public"/>
    <variable name="k_NTS_ls" units="dimensionless" interface="public"/>
    <variable name="f_cp" units="Hz" interface="public"/>
    <variable name="f_min_cp" units="Hz" interface="public"/>
    <variable name="f_max_cp" units="Hz" interface="public"/>
    <variable name="f_mid_cp" units="Hz" interface="public"/>
    <variable name="f_NTS_cp" units="Hz" interface="public"/>
    <variable name="k_NTS_cp" units="dimensionless" interface="public"/>
    <variable name="f_apc" units="Hz" interface="public"/>
    <variable name="f_min_ch" units="Hz" interface="public"/>
    <variable name="f_max_ch" units="Hz" interface="public"/>
    <variable name="f_mid_ch" units="Hz" interface="public"/>
    <variable name="f_NTS_ch" units="Hz" interface="public"/>
    <variable name="k_NTS_ch" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NTS_br</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_br</ci>
              <ci>f_max_br</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_br</ci>
                  <ci>f_mid_br</ci>
                </apply>
                <ci>k_NTS_br</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_br</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NTS_ls</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_ls</ci>
              <ci>f_max_ls</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_ls</ci>
                  <ci>f_mid_ls</ci>
                </apply>
                <ci>k_NTS_ls</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_ls</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NTS_cp</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_cp</ci>
              <ci>f_max_cp</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_cp</ci>
                  <ci>f_mid_cp</ci>
                </apply>
                <ci>k_NTS_cp</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_cp</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NTS_ch</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_ch</ci>
              <ci>f_max_ch</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_apc</ci>
                  <ci>f_mid_ch</ci>
                </apply>
                <ci>k_NTS_ch</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_ch</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="DMV_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_NTS_ls" units="Hz" interface="public"/>
    <variable name="f_NTS_cp" units="Hz" interface="public"/>
    <variable name="f_min_DMV" units="Hz" interface="public"/>
    <variable name="f_max_DMV" units="Hz" interface="public"/>
    <variable name="f_mid_DMV" units="Hz" interface="public"/>
    <variable name="f_DMV" units="Hz" interface="public"/>
    <variable name="k_DMV" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_DMV</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_DMV</ci>
              <ci>f_max_DMV</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <apply>
                    <plus/>
                    <ci>f_NTS_ls</ci>
                    <ci>f_NTS_cp</ci>
                  </apply>
                  <ci>f_mid_DMV</ci>
                </apply>
                <ci>k_DMV</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_DMV</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="NA_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_NTS_br" units="Hz" interface="public"/>
    <variable name="f_NTS_ls" units="Hz" interface="public"/>
    <variable name="f_NTS_cp" units="Hz" interface="public"/>
    <variable name="f_NTS_ch" units="Hz" interface="public"/>
    <variable name="f_NTS_output" units="Hz" interface="public"/>
    <variable name="f_NA_input" units="Hz" interface="public"/>
    <variable name="k_RSA" units="dimensionless" interface="public"/>
    <variable name="s_floor" units="dimensionless" interface="public"/>
    <variable name="f_min_NA" units="Hz" interface="public"/>
    <variable name="f_max_NA" units="Hz" interface="public"/>
    <variable name="f_mid_NA" units="Hz" interface="public"/>
    <variable name="f_NA" units="Hz" interface="public"/>
    <variable name="k_NA" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NTS_output</ci>
        <apply>
          <plus/>
          <ci>f_NTS_br</ci>
          <ci>f_NTS_ls</ci>
          <ci>f_NTS_cp</ci>
          <ci>f_NTS_ch</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_NA_input</ci>
        <piecewise>
          <piece>
            <ci>f_NTS_output</ci>
            <apply>
              <gt/>
              <ci>s_floor</ci>
              <cn cellml:units="dimensionless">0.4</cn>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <times/>
              <ci>f_NTS_output</ci>
              <ci>k_RSA</ci>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NA</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_NA</ci>
              <ci>f_max_NA</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_NA_input</ci>
                  <ci>f_mid_NA</ci>
                </apply>
                <ci>k_NA</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_NA</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="NActr_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_NA" units="Hz" interface="public"/>
    <variable name="f_min_NActr" units="Hz" interface="public"/>
    <variable name="f_max_NActr" units="Hz" interface="public"/>
    <variable name="f_mid_NActr" units="Hz" interface="public"/>
    <variable name="f_NActr" units="Hz" interface="public"/>
    <variable name="k_NActr" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_NActr</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_NActr</ci>
              <ci>f_max_NActr</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_NA</ci>
                  <ci>f_mid_NActr</ci>
                </apply>
                <ci>k_NActr</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_NActr</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="LCN_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="k_evEmax_gainLCN" units="dimensionless" interface="public"/>
    <variable name="f_DMV" units="Hz" interface="public"/>
    <variable name="f_NActr" units="Hz" interface="public"/>
    <variable name="k_br_gainLCN" units="dimensionless" interface="public"/>
    <variable name="f_br" units="Hz" interface="public"/>
    <variable name="k_esh_gainLCN" units="dimensionless" interface="public"/>
    <variable name="f_esh" units="Hz" interface="public"/>
    <variable name="k_cp_gainLCN" units="dimensionless" interface="public"/>
    <variable name="f_cp" units="Hz" interface="public"/>
    <variable name="f_input_LCN_sum" units="Hz" interface="public"/>
    <variable name="f_input_LCN" units="Hz" interface="public"/>
    <variable name="f_LCN" units="Hz" interface="public"/>
    <variable name="f_mid_LCN" units="Hz" interface="public"/>
    <variable name="f_min_LCN" units="Hz" interface="public"/>
    <variable name="f_max_LCN" units="Hz" interface="public"/>
    <variable name="k_LCN" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>f_input_LCN_sum</ci>
        <apply>
          <plus/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <ci>k_evEmax_gainLCN</ci>
                <apply>
                  <plus/>
                  <ci>f_DMV</ci>
                  <ci>f_NActr</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>k_br_gainLCN</ci>
                <ci>f_br</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>k_esh_gainLCN</ci>
              <ci>f_esh</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>k_cp_gainLCN</ci>
            <ci>f_cp</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_input_LCN</ci>
        <piecewise>
          <piece>
            <ci>f_input_LCN_sum</ci>
            <apply>
              <geq/>
              <ci>f_input_LCN_sum</ci>
              <cn cellml:units="Hz">0</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="Hz">0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_LCN</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_LCN</ci>
              <ci>f_max_LCN</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <ci>f_input_LCN</ci>
                  <ci>f_mid_LCN</ci>
                </apply>
                <ci>k_LCN</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_LCN</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="PNNA_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_PNNA_natural" units="Hz" interface="public"/>
    <variable name="f_PNNA" units="Hz" interface="public"/>
    <variable name="f_NA" units="Hz" interface="public"/>
    <variable name="f_LCN" units="Hz" interface="public"/>
    <variable name="f_mid_PNNA" units="Hz" interface="public"/>
    <variable name="f_min_PNNA" units="Hz" interface="public"/>
    <variable name="f_max_PNNA" units="Hz" interface="public"/>
    <variable name="k_PNNA" units="dimensionless" interface="public"/>
    <variable name="f_vagal_stim" units="Hz" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_PNNA_natural</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_PNNA</ci>
              <ci>f_max_PNNA</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <apply>
                    <plus/>
                    <ci>f_NA</ci>
                    <ci>f_LCN</ci>
                  </apply>
                  <ci>f_mid_PNNA</ci>
                </apply>
                <ci>k_PNNA</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_PNNA</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_PNNA</ci>
        <apply>
          <plus/>
          <ci>f_PNNA_natural</ci>
          <ci>f_vagal_stim</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="PNDMV_module">
    <variable name="f_PNDMV" units="Hz" interface="public"/>
    <variable name="f_DMV" units="Hz" interface="public"/>
    <variable name="f_NActr" units="Hz" interface="public"/>
    <variable name="f_LCN" units="Hz" interface="public"/>
    <variable name="f_mid_PNDMV" units="Hz" interface="public"/>
    <variable name="f_min_PNDMV" units="Hz" interface="public"/>
    <variable name="f_max_PNDMV" units="Hz" interface="public"/>
    <variable name="k_PNDMV" units="dimensionless" interface="public"/>
    <variable name="f_PNDMV_filt" units="Hz" initial_value="0" interface="public"/>
    <variable name="tau_PNDMV" units="second" interface="public"/>
    <variable name="t" units="second" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_PNDMV</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>f_min_PNDMV</ci>
              <ci>f_max_PNDMV</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <power/>
                <apply>
                  <divide/>
                  <apply>
                    <plus/>
                    <ci>f_DMV</ci>
                    <ci>f_NActr</ci>
                    <ci>f_LCN</ci>
                  </apply>
                  <ci>f_mid_PNDMV</ci>
                </apply>
                <ci>k_PNDMV</ci>
              </apply>
            </apply>
          </apply>
          <ci>f_max_PNDMV</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>f_PNDMV_filt</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>f_PNDMV</ci>
            <ci>f_PNDMV_filt</ci>
          </apply>
          <ci>tau_PNDMV</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="heart_effector_T_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_Ts" units="second" interface="public"/>
    <variable name="G_Tv" units="s2" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="tau_Ts" units="second" interface="public"/>
    <variable name="tau_Tv" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="f_v" units="Hz" interface="public"/>
    <variable name="Delta_Ts" units="second" initial_value="0.0" interface="public"/>
    <variable name="Delta_Tv" units="second" initial_value="0.0" interface="public"/>
    <variable name="Delta_T" units="second" interface="public"/>
    <variable name="sigma_Ts" units="second" interface="public"/>
    <variable name="sigma_Tv" units="second" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>sigma_Ts</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>G_Ts</ci>
              <apply>
                <ln/>
                <apply>
                  <times/>
                  <cn cellml:units="second">1</cn>
                  <apply>
                    <plus/>
                    <apply>
                      <minus/>
                      <ci>f_s</ci>
                      <ci>f_es_min</ci>
                    </apply>
                    <cn cellml:units="Hz">1</cn>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>f_s</ci>
              <ci>f_es_min</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="second">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Ts</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Ts</ci>
            </apply>
            <ci>sigma_Ts</ci>
          </apply>
          <ci>tau_Ts</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>sigma_Tv</ci>
        <apply>
          <times/>
          <ci>G_Tv</ci>
          <ci>f_v</ci>
        </apply>
      </apply>
      <!--DELAY IGNORED-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Tv</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Tv</ci>
            </apply>
            <ci>sigma_Tv</ci>
          </apply>
          <ci>tau_Tv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Delta_T</ci>
        <apply>
          <plus/>
          <ci>Delta_Tv</ci>
          <ci>Delta_Ts</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="heart_effector_Elv_module">
    <variable name="sigma_Es" units="J_per_m6" interface="public"/>
    <variable name="G_Es" units="J_per_m6" interface="public"/>
    <variable name="f_esh" units="Hz" interface="public"/>
    <variable name="t" units="second" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="Delta_Es" units="J_per_m6" initial_value="0.0" interface="public"/>
    <variable name="tau_Es" units="second" interface="public"/>
    <variable name="sigma_Ev" units="J_per_m6" interface="public"/>
    <variable name="G_Ev" units="Js_per_m6" interface="public"/>
    <variable name="f_PNDMV_filt" units="Hz" interface="public"/>
    <variable name="Delta_Ev" units="J_per_m6" initial_value="0.0" interface="public"/>
    <variable name="tau_Ev" units="second" interface="public"/>
    <variable name="Delta_Emax" units="J_per_m6" interface="public"/>
    <variable name="scale" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>sigma_Es</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>G_Es</ci>
              <apply>
                <ln/>
                <apply>
                  <times/>
                  <cn cellml:units="second">1</cn>
                  <apply>
                    <plus/>
                    <apply>
                      <minus/>
                      <ci>f_esh</ci>
                      <ci>f_es_min</ci>
                    </apply>
                    <cn cellml:units="Hz">1</cn>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>f_esh</ci>
              <ci>f_es_min</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="J_per_m6">0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Es</ci>
        </apply>
        <apply>
          <times/>
          <apply>
            <divide/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>tau_Es</ci>
          </apply>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Es</ci>
            </apply>
            <ci>sigma_Es</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>sigma_Ev</ci>
        <apply>
          <times/>
          <ci>G_Ev</ci>
          <ci>f_PNDMV_filt</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Ev</ci>
        </apply>
        <apply>
          <times/>
          <apply>
            <divide/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>tau_Ev</ci>
          </apply>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Ev</ci>
            </apply>
            <ci>sigma_Ev</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>Delta_Emax</ci>
        <apply>
          <times/>
          <ci>scale</ci>
          <apply>
            <plus/>
            <ci>Delta_Es</ci>
            <ci>Delta_Ev</ci>
          </apply>
        </apply>
      </apply>
    </math>
